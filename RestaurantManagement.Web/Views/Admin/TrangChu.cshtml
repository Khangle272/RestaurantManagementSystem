@model RestaurantManagement.Web.Controllers.DashboardViewModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Trang chủ"; }
<div class="page-header">
    <div>
        <p class="page-eyebrow">KHU LÀM VIỆC · @DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</p>
        <h1 class="h3 mb-1">Chào mừng bạn trở lại</h1>
        <p class="text-muted mb-0">Chọn công việc cần xử lý. Các chức năng hiển thị theo quyền của bạn.</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-box-arrow-up-right me-1"></i>Xem trang nhà hàng</a>
</div>
@if (Model.ShowStats)
{
    <div class="row g-3 mb-4 dashboard-stats">
        <div class="col-6 col-xl-3">
            <a asp-controller="BaoCao" asp-action="DoanhThu" class="stat-tile stat-success">
                <span class="stat-icon"><i class="bi bi-cash-stack"></i></span>
                <span class="stat-body"><span class="stat-label">Doanh thu hôm nay</span><strong class="stat-value">@Model.RevenueToday.ToString("N0") đ</strong><small class="stat-sub">@Model.InvoicesToday hóa đơn đã thanh toán</small></span>
            </a>
        </div>
        <div class="col-6 col-xl-3">
            <a asp-controller="HoaDon" asp-action="Index" class="stat-tile @(Model.UnpaidInvoices > 0 ? "stat-warning" : "stat-muted")">
                <span class="stat-icon"><i class="bi bi-receipt"></i></span>
                <span class="stat-body"><span class="stat-label">Hóa đơn chưa tất toán</span><strong class="stat-value">@Model.UnpaidInvoices</strong><small class="stat-sub">Chưa thanh toán hoặc thanh toán một phần</small></span>
            </a>
        </div>
        <div class="col-6 col-xl-3">
            <a asp-controller="QuanLyDatBan" asp-action="Index" class="stat-tile @(Model.PendingReservations > 0 ? "stat-danger" : "stat-muted")">
                <span class="stat-icon"><i class="bi bi-calendar-check"></i></span>
                <span class="stat-body"><span class="stat-label">Đặt bàn cần xử lý</span><strong class="stat-value">@Model.PendingReservations</strong><small class="stat-sub">@Model.ReservationsToday lượt đến hôm nay · @Model.OccupiedTables/@Model.TotalTables bàn đang phục vụ</small></span>
            </a>
        </div>
        <div class="col-6 col-xl-3">
            <a asp-controller="Kho" asp-action="TonKho" class="stat-tile @(Model.LowStockItems > 0 ? "stat-danger" : "stat-muted")">
                <span class="stat-icon"><i class="bi bi-boxes"></i></span>
                <span class="stat-body"><span class="stat-label">Nguyên liệu sắp hết</span><strong class="stat-value">@Model.LowStockItems</strong><small class="stat-sub">@(Model.LowStockItems > 0 ? "Tồn kho chạm ngưỡng cảnh báo, cần nhập thêm" : "Tồn kho đang ở mức an toàn")</small></span>
            </a>
        </div>
    </div>
}
@await Html.PartialAsync("_ManagementNavigation", true)
