@model MonAnIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Thực đơn & Danh mục Món ăn";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Quản lý Thực đơn & Danh mục Món ăn</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>+ Tạo món mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Tổng số món</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalItems</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-list-ul fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Đang phục vụ</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.DangPhucVuCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Tạm hết nguyên liệu</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TamHetCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-exclamation-triangle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                Ngừng kinh doanh</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.NgungKinhDoanhCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-x-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Tabs -->
    <ul class="nav nav-pills mb-4">
        <li class="nav-item">
            <a class="nav-link @(!Model.DanhMucId.HasValue ? "active" : "")" href="@Url.Action("Index", new { search = Model.Search, trangThai = Model.TrangThai })">Tất cả</a>
        </li>
        @foreach (var danhMuc in Model.DanhMucList)
        {
            <li class="nav-item">
                <a class="nav-link @(Model.DanhMucId == danhMuc.Id ? "active" : "")" href="@Url.Action("Index", new { search = Model.Search, danhMucId = danhMuc.Id, trangThai = Model.TrangThai })">@danhMuc.TenDanhMuc</a>
            </li>
        }
    </ul>

    <!-- Toolbar -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <form method="get" class="row gx-3 gy-2 align-items-center">
                @if (Model.DanhMucId.HasValue)
                {
                    <input type="hidden" name="danhMucId" value="@Model.DanhMucId" />
                }
                <div class="col-sm-4">
                    <input type="text" class="form-control" name="search" value="@Model.Search" placeholder="Tìm kiếm tên món ăn...">
                </div>
                <div class="col-sm-3">
                    <select class="form-select" name="trangThai">
                        <option value="">Tất cả trạng thái</option>
                        <option value="DangPhucVu" selected="@(Model.TrangThai == "DangPhucVu")">Đang phục vụ</option>
                        <option value="TamHet" selected="@(Model.TrangThai == "TamHet")">Tạm hết</option>
                        <option value="NgungKinhDoanh" selected="@(Model.TrangThai == "NgungKinhDoanh")">Ngừng kinh doanh</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Lọc</button>
                    <a href="@Url.Action("Index", new { danhMucId = Model.DanhMucId })" class="btn btn-secondary">Xóa lọc</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Grid -->
    <div class="row">
        @foreach (var item in Model.Items)
        {
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(item.HinhAnh))
                        {
                            <img src="@item.HinhAnh" class="card-img-top" alt="@item.TenMon" style="aspect-ratio: 16/9; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center text-white" style="aspect-ratio: 16/9;">
                                <span>No Image</span>
                            </div>
                        }
                        
                        <div class="position-absolute top-0 end-0 p-2">
                            @if (item.TrangThai == RestaurantManagement.API.Models.TrangThaiMon.DangPhucVu)
                            {
                                <span class="badge bg-success">Đang phục vụ</span>
                            }
                            else if (item.TrangThai == RestaurantManagement.API.Models.TrangThaiMon.TamHet)
                            {
                                <span class="badge bg-warning text-dark">Tạm hết</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Ngừng kinh doanh</span>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="badge bg-primary mb-2">@item.TenDanhMuc</span>
                                <h5 class="card-title mb-0">@item.TenMon</h5>
                            </div>
                            <h6 class="text-primary font-weight-bold mb-0">@item.GiaBan.ToString("N0") đ</h6>
                        </div>
                        <p class="card-text text-muted small text-truncate">@item.MoTa</p>
                    </div>
                    <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" checked="@(item.TrangThai == RestaurantManagement.API.Models.TrangThaiMon.DangPhucVu)" disabled>
                            <label class="form-check-label small">Phục vụ</label>
                        </div>
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-outline-secondary" title="BOM">
                                <i class="bi bi-box"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary" title="Sửa">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Thêm">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, search = Model.Search, danhMucId = Model.DanhMucId, trangThai = Model.TrangThai })" tabindex="-1">Trước</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, search = Model.Search, danhMucId = Model.DanhMucId, trangThai = Model.TrangThai })">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, search = Model.Search, danhMucId = Model.DanhMucId, trangThai = Model.TrangThai })">Sau</a>
                </li>
            </ul>
        </nav>
    }
</div>
