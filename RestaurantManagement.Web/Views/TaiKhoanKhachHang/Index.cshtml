@using RestaurantManagement.API.Models
@model PagedListViewModel<KhachHang>
@{ ViewData["Title"] = "Quản lý khách hàng"; }
<h1 class="h3 mb-2">Quản lý khách hàng</h1>
<p class="text-muted">Hồ sơ khách hàng, tiến độ đơn, lịch sử mua hàng và tích điểm.</p>
<a asp-action="Create" class="btn btn-primary mb-3">Thêm hồ sơ khách hàng</a>
<form method="get" class="d-flex flex-wrap gap-2 mb-4">
    <input name="search" value="@Model.Pagination.Search" class="form-control" style="max-width:360px" aria-label="Tìm tên, email hoặc số điện thoại" placeholder="Tên, email hoặc số điện thoại" />
    <button class="btn btn-primary" type="submit">Tìm kiếm</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Bỏ lọc</a>
</form>
<div class="card border-0 shadow-sm table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Khách hàng</th><th>Email / tài khoản</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
    <tbody>
    @if (!Model.Items.Any()) { <tr><td colspan="4" class="text-muted text-center py-4">Chưa có tài khoản phù hợp.</td></tr> }
    @foreach (var customer in Model.Items)
    {
        var locked = customer.TaiKhoan?.LockoutEnd > DateTimeOffset.UtcNow;
        <tr>
            <td><a asp-action="Details" asp-route-id="@customer.Id">@customer.HoTen</a><small class="d-block text-muted">#@customer.Id · @customer.SoDienThoai</small></td>
            <td class="text-break">@(customer.TaiKhoan?.Email ?? customer.Email ?? "Chưa có tài khoản đăng nhập")</td>
            <td>@(!customer.DangSuDung ? "Hồ sơ ngừng sử dụng" : locked ? "Đã khóa" : "Hoạt động")</td>
            <td><a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary mb-1">Đơn hàng & tích điểm</a>
                <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary mb-1">Sửa thông tin</a>
                @if (customer.TaiKhoanId.HasValue) {
                <a asp-controller="Account" asp-action="ResetPassword" asp-route-id="@customer.TaiKhoanId" class="btn btn-sm btn-outline-secondary mb-1">Đặt lại mật khẩu</a>
                <form asp-action="SetLocked" method="post">
                <input type="hidden" name="id" value="@customer.Id" />
                <input type="hidden" name="locked" value="@(!locked)" />
                <button class="btn btn-sm btn-outline-secondary" type="submit">@(locked ? "Mở khóa" : "Khóa")</button>
            </form>
                }
                else if (customer.DangSuDung) { <a asp-action="CreateAccount" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-secondary">Cấp tài khoản</a> }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
<partial name="_ManagementPagination" model="Model.Pagination" />
