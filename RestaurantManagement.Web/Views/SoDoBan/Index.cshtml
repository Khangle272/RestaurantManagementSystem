@model TableBoardViewModel
@using RestaurantManagement.Web.Services
@{ ViewData["Title"] = "Sơ đồ bàn"; var reception = User.IsInRole("Admin") || User.IsInRole("TiepTan"); }
@section Styles { <link rel="stylesheet" href="~/css/tables.css" asp-append-version="true" /> }
<div class="page-header">
    <div><h1 class="h3">Sơ đồ bàn</h1><p class="text-muted">Phục vụ liên tục @ReservationSchedule.ServiceHours. Chia ca quản lý trước 17h và từ 17h; mỗi bàn nhận một lượt mỗi ca.</p></div>
    <div class="page-actions">
        @if (User.IsInRole("Admin") || User.IsInRole("TiepTan")) {
            <a asp-controller="QuanLyDatBan" asp-action="Create" class="btn btn-primary"><i class="bi bi-calendar-plus me-1" aria-hidden="true"></i>Đặt bàn cho khách</a>
            <a asp-controller="QuanLyDatBan" asp-action="Index" class="btn btn-outline-secondary">Yêu cầu đặt bàn</a>
        }
        @if (User.IsInRole("Admin")) {
            <a asp-controller="KhuVuc" asp-action="Index" class="btn btn-outline-secondary">Khu vực / tầng</a>
            <a asp-controller="BanAn" asp-action="Index" class="btn btn-outline-secondary">Cấu hình bàn</a>
        }
    </div>
</div>
<form method="get" class="filter-bar">
    <input type="hidden" name="datBanId" value="@Model.Booking?.Id" />
    <input type="hidden" name="preferredTableId" value="@Model.PreferredTableId" />
    <div class="filter-field"><label for="schedule-day" class="form-label">Ngày xem lịch</label><input id="schedule-day" name="ngay" type="date" value="@Model.ScheduleDay.ToString("yyyy-MM-dd")" class="form-control" disabled="@(Model.Booking is not null)" /></div>
    <div class="filter-field"><label for="schedule-slot" class="form-label">Ca xem lịch</label><select id="schedule-slot" name="ca" class="form-select" disabled="@(Model.Booking is not null)">
        <option value="now" selected="@(Model.SlotId == "now")">Hiện tại — thao tác phục vụ</option>
        @foreach (var slot in ReservationSchedule.Slots) { <option value="@slot.Id" selected="@(Model.SlotId == slot.Id)">@slot.Label</option> }
        @if (Model.SlotId == "legacy") { <option selected value="">Khoảng giờ lịch cũ: @Model.ScheduleTime.ToString("HH:mm")</option> }
    </select></div>
    @if (Model.SlotId == "legacy") { <input type="hidden" name="gio" value="@Model.ScheduleTime.ToString("HH:mm")" /> }
    <div class="filter-field"><label for="floor" class="form-label">Tầng</label><select id="floor" name="tang" class="form-select"><option value="">Tất cả tầng</option>
        @foreach (var floor in Model.Areas.Select(x => x.Tang).Distinct()) { <option value="@floor" selected="@(floor == Model.Floor)">@(floor == 0 ? "Tầng trệt" : $"Tầng {floor}")</option> }
    </select></div>
    <div class="filter-field"><label for="area" class="form-label">Khu vực</label><select id="area" name="khuVucId" class="form-select"><option value="">Tất cả khu vực</option>
        @foreach (var area in Model.Areas) { <option value="@area.Id" selected="@(area.Id == Model.AreaId)">@area.TenKhuVuc · tầng @area.Tang</option> }
    </select></div>
    <div class="filter-field is-wide"><label for="status-filter" class="form-label">Trạng thái bàn</label><select id="status-filter" name="trangThai" class="form-select" disabled="@(Model.Booking is not null)">
        <option value="can-xu-ly" selected="@(Model.StatusFilter == "can-xu-ly")">Cần xử lý (đặt trước sắp tới + đang phục vụ)</option>
        <option value="dang-phuc-vu" selected="@(Model.StatusFilter == "dang-phuc-vu")">Đang phục vụ</option>
        <option value="dat-truoc" selected="@(Model.StatusFilter == "dat-truoc")">Đặt trước sắp tới giờ</option>
        <option value="trong" selected="@(Model.StatusFilter == "trong")">Bàn trống</option>
        <option value="tat-ca" selected="@(Model.StatusFilter == "tat-ca")">Tất cả bàn</option>
    </select></div>
    <div class="filter-actions"><button class="btn btn-primary">Lọc sơ đồ</button><a asp-action="Index" asp-route-datBanId="@Model.Booking?.Id" asp-route-preferredTableId="@Model.PreferredTableId" class="btn btn-outline-secondary">Bỏ lọc</a></div>
</form>
@if (reception) { <div class="d-flex d-lg-none gap-2 mb-3"><a href="#booking-context" class="btn btn-sm btn-outline-success">Yêu cầu đặt bàn</a><a href="#table-board" class="btn btn-sm btn-outline-success">Xem sơ đồ</a></div> }
<div class="@(reception ? "booking-workspace" : "")">
@if (reception) {
    <aside id="booking-context" class="booking-context">
    <partial name="_BookingContext" model="Model" />
    <details class="card border-0 shadow-sm" open="@(Model.Booking is null)">
        <summary class="p-3 fw-semibold">Yêu cầu chờ xếp bàn</summary>
        <div class="booking-request-list">
        @foreach (var request in Model.Requests) {
            <a asp-action="Index" asp-route-datBanId="@request.Id" asp-route-khuVucId="@request.KhuVucUuTienId" class="booking-request @(request.Id == Model.Booking?.Id ? "selected" : "")">
                <strong>@request.HoTenLienHe</strong><span class="small">@(request.SoNguoiLon + request.SoTreEm) khách · @request.GioDen.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm dd/MM")</span><span class="small text-muted">@request.MaDatBan</span>
            </a>
        }
        @if (Model.Requests.Count == 0) { <p class="small text-muted px-3">Không có yêu cầu đang chờ xếp bàn.</p> }
        </div>
        <a asp-controller="QuanLyDatBan" asp-action="Index" class="small p-3">Xem toàn bộ yêu cầu và trạng thái</a>
    </details>
    </aside>
}
<section class="booking-board-panel" aria-label="Sơ đồ bàn và lịch đặt">
    <div class="board-caption">
        <span>@(Model.IsLive ? "Đang xem tình trạng hiện tại" : "Đang xem lịch theo ngày và ca") · @Model.From.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm dd/MM/yyyy") – @Model.CheckUntil.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm dd/MM/yyyy") · <span id="board-refresh" role="status">Tự cập nhật mỗi 10 giây</span></span>
        <details class="board-rules">
            <summary>Quy tắc</summary>
            <ul class="mb-0 ps-3">
                <li>Lịch xét đúng ngày đang xem; khi nhận khách, bàn phải được xác nhận sẵn sàng.</li>
                <li>Xác nhận hoàn tất là xác nhận khách đã dùng xong và bàn sẵn sàng. Không có bước chờ dọn riêng; quá 3 tiếng chỉ nhắc kiểm tra.</li>
                <li>Nhân viên kết thúc lượt sau khi khách dùng bữa xong; hệ thống không tự đóng theo số tiếng.</li>
            </ul>
        </details>
    </div>
    <div id="assignment-warning" class="alert alert-warning" role="alert" tabindex="-1" hidden></div>
    <div id="table-board" data-poll="@(Model.Booking is null ? "true" : "false")"><partial name="_Board" model="Model" /></div>
</section>
</div>
<partial name="_TableBlockedModal" />
@section Scripts { <script src="~/js/tables.js" asp-append-version="true"></script> }
