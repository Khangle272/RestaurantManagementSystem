@model ReservationPlanningViewModel
@using RestaurantManagement.Web.Services
@{ ViewData["Title"] = "Kế hoạch đặt bàn & nguyên liệu"; }
<h1 class="h3">Đặt bàn & dự trù nguyên liệu</h1>
<p class="text-muted">Tổng hợp lịch đã xác nhận theo ngày, tuần, ca và VIP. Dự trù từ món đặt trước của khách chưa nhận bàn; không tính doanh thu và không tự xuất kho.</p>
<form method="get" class="card card-body mb-4"><div class="d-flex flex-wrap gap-3 align-items-end">
<div><label class="form-label" for="planning-from">Từ ngày</label><input id="planning-from" name="tuNgay" type="date" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" /></div>
<div><label class="form-label" for="planning-until">Đến ngày</label><input id="planning-until" name="denNgay" type="date" value="@Model.Until.ToString("yyyy-MM-dd")" class="form-control" /></div>
<div><label class="form-label" for="planning-shift">Ca</label><select id="planning-shift" name="ca" class="form-select"><option value="">Tất cả ca</option>@foreach(var slot in ReservationSchedule.Slots) { <option value="@slot.Id" selected="@(Model.Shift == slot.Id)">@slot.Label</option> }</select></div>
<div><label class="form-label" for="planning-vip">Loại bàn</label><select id="planning-vip" name="vip" class="form-select"><option value="">Tất cả</option><option value="false" selected="@(Model.Vip == false)">Bàn thường</option><option value="true" selected="@(Model.Vip == true)">VIP</option></select></div>
<button class="btn btn-success">Xem thống kê</button><button name="cheDo" value="tuan" class="btn btn-outline-success">Cả tuần của ngày bắt đầu</button></div></form>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card card-body"><strong>@Model.Rows.Sum(x => x.Reservations) lịch đã xác nhận</strong><span>@Model.Rows.Sum(x => x.Tables) lượt bàn · @Model.Rows.Sum(x => x.Guests) khách</span></div></div><div class="col-md-4"><div class="card card-body"><strong>@Model.Waiting lịch còn chờ</strong><span>Chưa tính vào nhu cầu chắc chắn</span></div></div><div class="col-md-4"><div class="card card-body"><strong>@Model.WithoutFood lịch chưa chọn món</strong><span>Chưa thể dự trù nguyên liệu cho các lịch này</span></div></div></div>
<h2 class="h5">Số lượng đặt bàn</h2><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Ngày</th><th>Ca</th><th>Loại</th><th>Lịch</th><th>Lượt bàn</th><th>Khách</th></tr></thead><tbody>@foreach(var row in Model.Rows) { <tr><td>@row.Day.ToString("dd/MM/yyyy")</td><td>@row.Shift</td><td>@(row.Vip ? "VIP" : "Thường")</td><td>@row.Reservations</td><td>@row.Tables</td><td>@row.Guests</td></tr> }</tbody></table></div>
<h2 class="h5 mt-4">Nguyên liệu cần chuẩn bị</h2><p class="small text-muted">Đúng size khách chọn × số phần × định mức size. Combo phải có định mức riêng cho size combo; không tự lấy công thức size khác. Số thiếu so với tồn kho hiện tại chưa phải lệnh mua hàng.</p>
@foreach(var warning in Model.Warnings) { <div class="alert alert-warning py-2">@warning</div> }
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Nguyên liệu</th><th>Đơn vị</th><th>Cần chuẩn bị</th><th>Tồn hiện tại</th><th>Còn thiếu</th></tr></thead><tbody>@foreach(var row in Model.Ingredients) { <tr><td>@row.Name</td><td>@row.Unit</td><td>@row.Required.ToString("0.###")</td><td>@row.Stock.ToString("0.###")</td><td class="@(row.Shortage > 0 ? "text-danger fw-bold" : "")">@row.Shortage.ToString("0.###")</td></tr> }</tbody></table></div>
@if(Model.Ingredients.Count == 0) { <p class="text-muted">Chưa có nhu cầu nguyên liệu tính được trong bộ lọc này. Kiểm tra món đặt trước và định mức.</p> }
