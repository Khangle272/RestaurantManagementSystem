@model PhieuNhapCreateVM
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Lập Phiếu Nhập Kho";
    var nccList = ViewBag.NhaCungCapList as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var nguyenLieuList = ViewBag.NguyenLieuList as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold text-heading mb-1"><i class="bi bi-cart-plus me-2 text-danger"></i>Lập Phiếu Nhập Kho</h1>
            <p class="text-muted mb-0">Tạo phiếu nhập Master-Detail, cập nhật số lượng tồn kho và điều chỉnh đơn giá vốn tức thời.</p>
        </div>
        <a asp-action="Index" class="btn btn-brand-outline">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <form asp-action="Create" method="post" id="formNhapKho">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <!-- Master Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-subtle">
                <h5 class="card-title mb-0 fw-semibold text-dark"><i class="bi bi-info-circle me-2 text-primary"></i>Thông tin chung chứng từ nhập hàng</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-12 col-md-5">
                        <label asp-for="MaNhaCungCap" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <select asp-for="MaNhaCungCap" id="cboNhaCungCap" class="form-select" required>
                                <option value="">-- Chọn Nhà cung cấp --</option>
                                @foreach (var ncc in nccList)
                                {
                                    <option value="@ncc.Id">@ncc.TenNhaCungCap (@ncc.SoDienThoai)</option>
                                }
                            </select>
                            <button class="btn btn-outline-rose" type="button" data-bs-toggle="modal" data-bs-target="#modalQuickAddSupplier" title="Thêm Nhà Cung Cấp mới">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <span asp-validation-for="MaNhaCungCap" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-3">
                        <label asp-for="NgayNhap" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="NgayNhap" type="datetime-local" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        <span asp-validation-for="NgayNhap" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="SoHoaDon" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-receipt"></i></span>
                            <input asp-for="SoHoaDon" class="form-control" placeholder="HD-00123 / Số phiếu giao hàng" />
                        </div>
                        <span asp-validation-for="SoHoaDon" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="GhiChu" class="form-label fw-semibold"></label>
                        <input asp-for="GhiChu" class="form-control" placeholder="Ghi chú về đợt nhập hàng, điều kiện bảo quản, người giao hàng..." />
                        <span asp-validation-for="GhiChu" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detail Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-subtle d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-semibold text-dark"><i class="bi bi-list-check me-2 text-success"></i>Chi tiết các mặt hàng nhập kho</h5>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-rose" data-bs-toggle="modal" data-bs-target="#modalQuickAddIngredient" title="Thêm nguyên liệu chưa có trong kho">
                        <i class="bi bi-plus-circle me-1"></i> Thêm nguyên liệu mới vào kho
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnThemDong">
                        <i class="bi bi-plus-lg me-1"></i> Thêm dòng hàng
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-admin align-middle mb-0" id="bangChiTiet">
                        <thead>
                            <tr>
                                <th style="width: 50px;">STT</th>
                                <th style="min-width: 280px;">Nguyên Liệu <span class="text-danger">*</span></th>
                                <th style="width: 90px;">ĐVT</th>
                                <th style="width: 140px;">Số Lượng <span class="text-danger">*</span></th>
                                <th style="width: 160px;">Đơn Giá Nhập <span class="text-danger">*</span></th>
                                <th style="width: 170px;" class="text-end">Thành Tiền (VNĐ)</th>
                                <th style="width: 150px;">Hạn Sử Dụng</th>
                                <th style="width: 120px;">Số Lô</th>
                                <th style="width: 60px;" class="text-center">Xóa</th>
                            </tr>
                        </thead>
                        <tbody id="chiTietRows">
                            <!-- Rows added dynamically via JS -->
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="fw-bold py-3 text-secondary">
                                    Tổng cộng: <span id="lblTongSoMatHang" class="badge bg-secondary">0 mặt hàng</span>
                                </td>
                                <td colspan="2" class="text-end fw-bold text-dark fs-5 py-3">
                                    Tổng giá trị nhập:
                                </td>
                                <td class="text-end fw-bold text-danger fs-4 py-3" id="lblTongTien">
                                    0 VNĐ
                                </td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white py-3 text-muted small border-subtle">
                <i class="bi bi-info-circle me-1 text-primary"></i> Đơn giá nhập của từng nguyên liệu sẽ được tự động cập nhật làm giá vốn mới nhất sau khi phiếu được duyệt ghi sổ.
            </div>
        </div>

        <!-- Form Actions -->
        <div class="d-flex justify-content-end gap-2 mb-5">
            <a asp-action="Index" class="btn btn-brand-outline">Hủy bỏ</a>
            <button type="submit" class="btn btn-brand-primary btn-lg shadow-sm" id="btnSubmit">
                <i class="bi bi-check2-circle me-1"></i> Xác Nhận Nhập Kho & Tăng Tồn
            </button>
        </div>
    </form>
</div>

<!-- Raw data for JS ingredients lookup -->
<script type="application/json" id="rawIngredients">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(nguyenLieuList))
</script>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const rawData = JSON.parse(document.getElementById("rawIngredients").textContent);
        const rowsContainer = document.getElementById("chiTietRows");
        const btnThemDong = document.getElementById("btnThemDong");
        const lblTongSoMatHang = document.getElementById("lblTongSoMatHang");
        const lblTongTien = document.getElementById("lblTongTien");
        let rowIndex = 0;

        function addRow(preselectedId = null, preQty = 1, prePrice = null) {
            const tr = document.createElement("tr");
            tr.className = "item-row";
            tr.dataset.index = rowIndex;

            let optionsHtml = '<option value="">-- Chọn nguyên liệu --</option>';
            rawData.forEach(item => {
                const selected = preselectedId && item.Id === preselectedId ? "selected" : "";
                optionsHtml += `<option value="${item.Id}" data-dvt="${item.DonViTinh}" data-price="${item.DonGia}" ${selected}>${item.TenNguyenLieu}</option>`;
            });

            tr.innerHTML = `
                <td class="stt-cell text-muted fw-semibold">${rowIndex + 1}</td>
                <td>
                    <div class="input-group">
                        <select name="ChiTiets[${rowIndex}].MaNguyenLieu" class="form-select select-nguyenlieu" required>
                            ${optionsHtml}
                        </select>
                        <button type="button" class="btn btn-outline-rose btn-quick-add-ingredient-row" title="Thêm nguyên liệu mới vào kho">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                </td>
                <td>
                    <span class="badge bg-light text-dark border text-unit">—</span>
                </td>
                <td>
                    <input type="number" step="0.01" min="0.01" name="ChiTiets[${rowIndex}].SoLuong" class="form-control input-soluong" value="${preQty}" required />
                </td>
                <td>
                    <div class="input-group">
                        <input type="number" step="100" min="0" name="ChiTiets[${rowIndex}].DonGiaNhap" class="form-control input-dongia" value="${prePrice !== null ? prePrice : 0}" required />
                    </div>
                </td>
                <td class="text-end fw-bold text-dark text-thanhtien">
                    0 VNĐ
                </td>
                <td>
                    <input type="date" name="ChiTiets[${rowIndex}].HanSuDung" class="form-control form-control-sm" />
                </td>
                <td>
                    <input type="text" name="ChiTiets[${rowIndex}].SoLo" class="form-control form-control-sm" placeholder="Lô 01" />
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger btn-xoadong" title="Xóa dòng này">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;

            rowsContainer.appendChild(tr);

            const selectEl = tr.querySelector(".select-nguyenlieu");
            const dvtEl = tr.querySelector(".text-unit");
            const donGiaInput = tr.querySelector(".input-dongia");

            function updateFromSelection() {
                const sel = selectEl.options[selectEl.selectedIndex];
                if (sel && sel.value) {
                    dvtEl.textContent = sel.dataset.dvt || "—";
                    if (prePrice === null) {
                        donGiaInput.value = sel.dataset.price || 0;
                    }
                } else {
                    dvtEl.textContent = "—";
                }
                updateRow(tr);
            }

            selectEl.addEventListener("change", function () {
                const sel = selectEl.options[selectEl.selectedIndex];
                if (sel && sel.value) {
                    dvtEl.textContent = sel.dataset.dvt || "—";
                    donGiaInput.value = sel.dataset.price || 0;
                } else {
                    dvtEl.textContent = "—";
                }
                updateRow(tr);
            });

            tr.querySelector(".btn-quick-add-ingredient-row").addEventListener("click", function () {
                targetRowForQuickAdd = tr;
                if (window.bootstrap && bootstrap.Modal) {
                    (bootstrap.Modal.getInstance(modalIngredientEl) || new bootstrap.Modal(modalIngredientEl)).show();
                }
            });

            tr.querySelector(".input-soluong").addEventListener("input", () => updateRow(tr));
            donGiaInput.addEventListener("input", () => updateRow(tr));

            tr.querySelector(".btn-xoadong").addEventListener("click", function () {
                tr.remove();
                reindexRows();
                updateTotals();
            });

            updateFromSelection();
            rowIndex++;
            reindexRows();
            updateTotals();
        }

        function updateRow(tr) {
            const qty = parseFloat(tr.querySelector(".input-soluong").value) || 0;
            const price = parseFloat(tr.querySelector(".input-dongia").value) || 0;
            const total = qty * price;
            tr.querySelector(".text-thanhtien").textContent = total.toLocaleString("vi-VN") + " VNĐ";
            updateTotals();
        }

        function reindexRows() {
            const rows = rowsContainer.querySelectorAll(".item-row");
            rows.forEach((r, idx) => {
                r.querySelector(".stt-cell").textContent = idx + 1;
                r.querySelector(".select-nguyenlieu").name = `ChiTiets[${idx}].MaNguyenLieu`;
                r.querySelector(".input-soluong").name = `ChiTiets[${idx}].SoLuong`;
                r.querySelector(".input-dongia").name = `ChiTiets[${idx}].DonGiaNhap`;
                const hsd = r.querySelector("input[type=date]");
                if (hsd) hsd.name = `ChiTiets[${idx}].HanSuDung`;
                const solo = r.querySelector("input[placeholder='Lô 01']");
                if (solo) solo.name = `ChiTiets[${idx}].SoLo`;
            });
            lblTongSoMatHang.textContent = `${rows.length} mặt hàng`;
        }

        function updateTotals() {
            let sum = 0;
            rowsContainer.querySelectorAll(".item-row").forEach(tr => {
                const qty = parseFloat(tr.querySelector(".input-soluong").value) || 0;
                const price = parseFloat(tr.querySelector(".input-dongia").value) || 0;
                sum += qty * price;
            });
            lblTongTien.textContent = sum.toLocaleString("vi-VN") + " VNĐ";
        }

        btnThemDong.addEventListener("click", () => addRow());

        // Add 2 default initial rows for quick entry
        if (rawData.length > 0) {
            addRow(rawData[0].Id, 10, rawData[0].DonGia);
            if (rawData.length > 1) {
                addRow(rawData[1].Id, 5, rawData[1].DonGia);
            }
        } else {
            addRow();
        }

        document.getElementById("formNhapKho").addEventListener("submit", function (e) {
            const rows = rowsContainer.querySelectorAll(".item-row");
            if (rows.length === 0) {
                e.preventDefault();
                alert("Vui lòng thêm ít nhất một nguyên liệu nhập kho.");
            }
        });

        // Quick Add Supplier AJAX
        const formQuickSupplier = document.getElementById("formQuickAddSupplier");
        const modalSupplierEl = document.getElementById("modalQuickAddSupplier");
        const supplierAlert = document.getElementById("quickSupplierAlert");
        const btnSaveSupplier = document.getElementById("btnSaveQuickSupplier");
        const cboNhaCungCap = document.getElementById("cboNhaCungCap");

        // Quick Add Ingredient AJAX
        let targetRowForQuickAdd = null;
        const formQuickIngredient = document.getElementById("formQuickAddIngredient");
        const modalIngredientEl = document.getElementById("modalQuickAddIngredient");
        const ingredientAlert = document.getElementById("quickIngredientAlert");
        const btnSaveIngredient = document.getElementById("btnSaveQuickIngredient");

        if (modalIngredientEl) {
            modalIngredientEl.addEventListener("hidden.bs.modal", function () {
                targetRowForQuickAdd = null;
                if (formQuickIngredient) formQuickIngredient.reset();
                if (ingredientAlert) ingredientAlert.classList.add("d-none");
            });
        }

        function showToast(message, isSuccess = true) {
            const toastEl = document.getElementById("quickToast");
            const toastMsg = document.getElementById("quickToastMessage");
            if (!toastEl || !toastMsg) return;
            toastMsg.textContent = message;
            toastEl.className = `toast align-items-center text-white border-0 shadow ${isSuccess ? 'bg-success' : 'bg-danger'}`;
            if (window.bootstrap && bootstrap.Toast) {
                new bootstrap.Toast(toastEl, { delay: 3500 }).show();
            } else {
                alert(message);
            }
        }

        if (formQuickSupplier) {
            formQuickSupplier.addEventListener("submit", async function (e) {
                e.preventDefault();
                const tenNhaCungCap = document.getElementById("quickTenNCC")?.value?.trim();
                const soDienThoai = document.getElementById("quickPhoneNCC")?.value?.trim();
                const nguoiLienHe = document.getElementById("quickContactNCC")?.value?.trim();
                const email = document.getElementById("quickEmailNCC")?.value?.trim();
                const diaChi = document.getElementById("quickDiaChiNCC")?.value?.trim();

                if (!tenNhaCungCap || !soDienThoai) {
                    if (supplierAlert) {
                        supplierAlert.textContent = "Vui lòng nhập tên nhà cung cấp và số điện thoại.";
                        supplierAlert.classList.remove("d-none");
                    }
                    return;
                }

                if (supplierAlert) supplierAlert.classList.add("d-none");
                const origHtml = btnSaveSupplier.innerHTML;
                btnSaveSupplier.disabled = true;
                btnSaveSupplier.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';

                try {
                    const res = await fetch("/NhaCungCap/QuickCreate", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ tenNhaCungCap, soDienThoai, nguoiLienHe, email, diaChi })
                    });
                    const data = await res.json();
                    if (data.success) {
                        if (cboNhaCungCap) {
                            const opt = new Option(`${data.name} (${data.phone})`, data.id, true, true);
                            cboNhaCungCap.add(opt);
                            cboNhaCungCap.value = data.id;
                            cboNhaCungCap.classList.add("pulse-green");
                            setTimeout(() => cboNhaCungCap.classList.remove("pulse-green"), 1500);
                        }

                        if (window.bootstrap && bootstrap.Modal) {
                            (bootstrap.Modal.getInstance(modalSupplierEl) || new bootstrap.Modal(modalSupplierEl)).hide();
                        }
                        formQuickSupplier.reset();
                        showToast(`Đã thêm nhà cung cấp "${data.name}" thành công!`);
                    } else {
                        if (supplierAlert) {
                            supplierAlert.textContent = data.message || "Lỗi khi lưu nhà cung cấp.";
                            supplierAlert.classList.remove("d-none");
                        }
                    }
                } catch (err) {
                    if (supplierAlert) {
                        supplierAlert.textContent = "Không thể kết nối máy chủ: " + err.message;
                        supplierAlert.classList.remove("d-none");
                    }
                } finally {
                    btnSaveSupplier.disabled = false;
                    btnSaveSupplier.innerHTML = origHtml;
                }
            });
        }

        if (formQuickIngredient) {
            formQuickIngredient.addEventListener("submit", async function (e) {
                e.preventDefault();
                const tenNguyenLieu = document.getElementById("quickTenNguyenLieu")?.value?.trim();
                const donViTinh = document.getElementById("quickDonViTinh")?.value?.trim();
                const donGia = parseFloat(document.getElementById("quickDonGia")?.value) || 0;
                const dinhMucToiThieu = parseFloat(document.getElementById("quickDinhMucToiThieu")?.value) || 0;

                if (!tenNguyenLieu || !donViTinh) {
                    if (ingredientAlert) {
                        ingredientAlert.textContent = "Vui lòng nhập tên nguyên liệu và đơn vị tính.";
                        ingredientAlert.classList.remove("d-none");
                    }
                    return;
                }

                if (ingredientAlert) ingredientAlert.classList.add("d-none");
                const origHtml = btnSaveIngredient.innerHTML;
                btnSaveIngredient.disabled = true;
                btnSaveIngredient.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';

                try {
                    const res = await fetch("/NguyenLieu/QuickCreate", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ tenNguyenLieu, donViTinh, donGia, dinhMucToiThieu })
                    });
                    const data = await res.json();
                    if (data.success) {
                        // Add to rawData
                        const newItem = {
                            Id: data.id,
                            TenNguyenLieu: data.name,
                            DonViTinh: data.unit,
                            DonGia: data.price
                        };
                        rawData.push(newItem);

                        // Update all existing dropdowns
                        rowsContainer.querySelectorAll(".select-nguyenlieu").forEach(sel => {
                            const opt = document.createElement("option");
                            opt.value = data.id;
                            opt.textContent = data.name;
                            opt.dataset.dvt = data.unit;
                            opt.dataset.price = data.price;
                            sel.appendChild(opt);
                        });

                        if (targetRowForQuickAdd && rowsContainer.contains(targetRowForQuickAdd)) {
                            const sel = targetRowForQuickAdd.querySelector(".select-nguyenlieu");
                            sel.value = data.id;
                            const dvtEl = targetRowForQuickAdd.querySelector(".text-unit");
                            const donGiaInput = targetRowForQuickAdd.querySelector(".input-dongia");
                            if (dvtEl) dvtEl.textContent = data.unit;
                            if (donGiaInput) donGiaInput.value = data.price;
                            updateRow(targetRowForQuickAdd);
                            targetRowForQuickAdd.classList.add("pulse-green");
                            setTimeout(() => targetRowForQuickAdd.classList.remove("pulse-green"), 1500);
                        } else {
                            addRow(data.id, 1, data.price);
                            const lastRow = rowsContainer.lastElementChild;
                            if (lastRow) {
                                lastRow.classList.add("pulse-green");
                                setTimeout(() => lastRow.classList.remove("pulse-green"), 1500);
                            }
                        }

                        if (window.bootstrap && bootstrap.Modal) {
                            (bootstrap.Modal.getInstance(modalIngredientEl) || new bootstrap.Modal(modalIngredientEl)).hide();
                        }
                        formQuickIngredient.reset();
                        showToast(`Đã thêm nguyên liệu "${data.name}" vào kho thành công!`);
                    } else {
                        if (ingredientAlert) {
                            ingredientAlert.textContent = data.message || "Lỗi khi lưu nguyên liệu.";
                            ingredientAlert.classList.remove("d-none");
                        }
                    }
                } catch (err) {
                    if (ingredientAlert) {
                        ingredientAlert.textContent = "Không thể kết nối máy chủ: " + err.message;
                        ingredientAlert.classList.remove("d-none");
                    }
                } finally {
                    btnSaveIngredient.disabled = false;
                    btnSaveIngredient.innerHTML = origHtml;
                }
            });
        }
    });
</script>
}

<!-- Modal Quick Add Supplier -->
<div class="modal fade" id="modalQuickAddSupplier" tabindex="-1" aria-labelledby="modalQuickAddSupplierLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-subtle">
                <h5 class="modal-title fw-bold" id="modalQuickAddSupplierLabel">
                    <i class="bi bi-truck text-danger me-2"></i>Thêm Nhanh Nhà Cung Cấp
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form id="formQuickAddSupplier">
                <div class="modal-body p-4">
                    <div id="quickSupplierAlert" class="alert alert-danger d-none py-2" role="alert"></div>
                    <div class="mb-3">
                        <label for="quickTenNCC" class="form-label fw-semibold">Tên nhà cung cấp <span class="text-danger">*</span></label>
                        <input type="text" id="quickTenNCC" class="form-control" placeholder="Công ty TNHH Thực Phẩm Xanh..." required maxlength="200" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label for="quickPhoneNCC" class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" id="quickPhoneNCC" class="form-control" placeholder="0901234567" required maxlength="20" />
                        </div>
                        <div class="col-6">
                            <label for="quickContactNCC" class="form-label fw-semibold">Người liên hệ</label>
                            <input type="text" id="quickContactNCC" class="form-control" placeholder="Anh Bình..." maxlength="100" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="quickEmailNCC" class="form-label fw-semibold">Email</label>
                        <input type="email" id="quickEmailNCC" class="form-control" placeholder="ncc@example.com" maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label for="quickDiaChiNCC" class="form-label fw-semibold">Địa chỉ</label>
                        <input type="text" id="quickDiaChiNCC" class="form-control" placeholder="123 Nguyễn Huệ, Q.1..." maxlength="300" />
                    </div>
                </div>
                <div class="modal-footer border-subtle">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-brand-primary" id="btnSaveQuickSupplier">
