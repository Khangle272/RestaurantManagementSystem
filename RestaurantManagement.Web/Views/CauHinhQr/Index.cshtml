@model PaymentQrViewModel
@{ ViewData["Title"] = "QR nhận chuyển khoản"; }
<div class="page-header">
    <div>
        <h1 class="h3">QR nhận chuyển khoản</h1>
        <p class="text-muted">Tải ảnh QR của nhà hàng để thay ảnh trên trang thanh toán cọc. Chỉ Admin được thay ảnh; không cần sửa code.</p>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-5">
                <p class="form-label mb-2">Ảnh QR đang dùng</p>
                @if (!string.IsNullOrEmpty(Model.Version)) {
                    <div class="qr-preview"><img src="@Url.Action("Anh", new { v = Model.Version })" alt="Ảnh QR đang dùng để nhận cọc" /></div>
                } else {
                    <div class="qr-preview"><i class="bi bi-qr-code" aria-hidden="true"></i><span class="small">Chưa tải ảnh QR. Bản Development đang dùng QR tượng trưng, không chuyển tiền thật.</span></div>
                }
            </div>
            <div class="col-md-7">
                <form method="post" enctype="multipart/form-data" data-ajax-form="true">
                    <input asp-for="Version" type="hidden" />
                    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                    <label asp-for="AnhQr" class="form-label">Chọn ảnh QR mới</label>
                    <input asp-for="AnhQr" type="file" accept="image/png,image/jpeg" class="form-control" required />
                    <span asp-validation-for="AnhQr" class="text-danger"></span>
                    <p class="small text-muted mt-2">PNG hoặc JPG, tối đa 2 MB. Kiểm tra QR đúng tài khoản nhận tiền trước khi lưu. Khách vẫn nhập số tiền và mã đặt bàn; ảnh QR không tự xác nhận tiền vào ngân hàng.</p>
                    <button class="btn btn-primary"><i class="bi bi-upload me-1" aria-hidden="true"></i>Lưu ảnh QR</button>
                </form>
            </div>
        </div>
    </div>
</div>
