@model RestaurantManagement.Web.Models.OrderCreateViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gọi thêm món - " + ViewBag.MaHoaDon;
}
<div class="container-fluid py-2 pos-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <div><h1 class="h4 mb-1">Gọi thêm món</h1><p class="small text-muted mb-0">Đơn hàng <strong class="text-primary">@ViewBag.MaHoaDon</strong></p></div>
        <a asp-action="Details" asp-route-id="@ViewBag.HoaDonId" class="btn btn-sm btn-outline-secondary">Quay lại đơn</a>
    </div>
    <form asp-action="AddDishes" asp-route-id="@ViewBag.HoaDonId" method="post" id="add-dishes-form" data-ajax-form="true" data-pos-form="add" data-invoice-id="@ViewBag.HoaDonId" data-draft-user="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="row g-2 pos-columns">
            <div class="col-12 col-md-7 col-xl-8 pos-menu-column">
                <div class="card border-0 shadow-sm pos-menu-card"><div class="card-body p-3">
                    <div class="pos-menu-filters mb-2">
                        <label class="visually-hidden" for="dish-category">Danh mục món</label><select id="dish-category" class="form-select form-select-sm"><option value="all">Tất cả danh mục</option>@foreach (var category in Model.Categories) { <option value="@category.Id">@category.TenDanhMuc</option> }</select>
                        <label class="visually-hidden" for="dish-search">Tìm món ăn</label><input type="search" id="dish-search" class="form-control form-control-sm" placeholder="Tìm món ăn..." />
                    </div>
                    @if (Model.MenuDishes.Count == 0)
                    {
                        <div class="alert alert-warning" role="alert">Thực đơn chưa có món sẵn sàng phục vụ. Kiểm tra món đã duyệt và size đang mở bán trước khi gửi món thêm.</div>
                    }
                    <div class="row g-2 pos-dish-grid" id="dish-grid">
                        @foreach (var dish in Model.MenuDishes)
                        {
                            <div class="col-6 col-xl-4 dish-card-item" data-category="@dish.DanhMucId" data-name="@dish.TenMon.ToLowerInvariant()">
                                <div class="card h-100 border shadow-none"><div class="card-body p-2 d-flex flex-column">
                                    <strong class="small text-dark">@dish.TenMon</strong><span class="small text-muted mb-2">@(dish.MoTa ?? "Món đặc sản nhà hàng")</span>
                                    <div class="d-flex flex-column gap-1 mt-auto">
                                        @foreach (var size in dish.Sizes)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary d-flex justify-content-between gap-1 btn-add-dish" data-dish-id="@dish.Id" data-dish-name="@dish.TenMon" data-size-id="@size.Id" data-size-name="@size.TenSize" data-price="@size.GiaBan.ToString(System.Globalization.CultureInfo.InvariantCulture)"><span>@size.TenSize</span><strong>@size.GiaBan.ToString("N0") đ +</strong></button>
                                        }
                                    </div>
                                </div></div>
                            </div>
                        }
                    </div>
                    <p id="pos-no-results" class="small text-muted mt-3" hidden>Không tìm thấy món phù hợp.</p>
                </div></div>
            </div>
            <div class="col-12 col-md-5 col-xl-4">
                <div class="card border-0 shadow-sm pos-cart">
                    <div class="card-header bg-white p-3"><div class="d-flex justify-content-between align-items-center"><h2 class="h6 mb-0">Món gọi thêm (<span id="cart-item-count">0</span>)</h2><button type="button" class="btn btn-sm btn-link text-danger p-0" id="pos-clear-cart">Xóa tất cả</button></div></div>
                    <div class="card-body p-2" id="cart-container"><div id="empty-cart-message" class="text-center py-4 text-muted small">Chưa có món. Chọn size ở thực đơn để thêm.</div><div id="cart-items-list" class="d-flex flex-column gap-2"></div></div>
                    <div class="card-footer bg-light p-3">
                        <div class="d-flex justify-content-between small mb-1"><span>Số lượng thêm</span><strong id="cart-total-qty">0 phần</strong></div>
                        <div class="d-flex justify-content-between mb-2"><strong>Tiền thêm</strong><strong class="text-danger" id="cart-total-amount">0 đ</strong></div>
                        <button type="submit" id="btn-submit-order" class="btn btn-primary w-100 fw-bold" disabled>✓ Gửi món thêm vào bếp</button>
                    </div>
                </div>
            </div>
        </div>
        <script type="application/json" id="pos-initial-items">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items))</script>
    </form>
</div>
