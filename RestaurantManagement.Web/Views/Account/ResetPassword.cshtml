@model ResetAccountPasswordViewModel
@{ ViewData["Title"] = "Đặt lại mật khẩu"; }
<section class="account-shell">
    <h1 class="h3 mb-2">Đặt lại mật khẩu</h1>
    <p class="text-break">Tài khoản: <strong>@ViewData["TargetEmail"]</strong></p>
    <p class="text-muted">Không xem được mật khẩu cũ. Đặt lại sẽ thu hồi phiên đăng nhập cũ, không tự mở khóa tài khoản. Cung cấp mật khẩu mới cho đúng người qua kênh riêng.</p>
    <form asp-action="ResetPassword" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="AdminPassword" class="form-label">Mật khẩu quản trị của bạn</label><input asp-for="AdminPassword" class="form-control" autocomplete="current-password" /></div>
        <div class="mb-3"><label asp-for="NewPassword" class="form-label">Mật khẩu mới cho tài khoản này</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /></div>
        <button class="btn btn-primary" type="submit">Xác nhận đặt lại</button>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
