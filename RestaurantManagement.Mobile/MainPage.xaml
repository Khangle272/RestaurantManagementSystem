<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RestaurantManagement.Mobile.MainPage" Title="Nhà hàng">
    <Grid RowDefinitions="Auto,*">
        <HorizontalStackLayout Padding="12,8" Spacing="12">
            <Button Text="Đổi nhà hàng" Clicked="OnSettingsClicked" />
            <Button Text="Quay lại" Clicked="OnBackClicked" />
        </HorizontalStackLayout>
        <VerticalStackLayout x:Name="SetupPanel" Grid.Row="1" Padding="24" Spacing="16">
            <Label Text="Voucher &amp; khách hàng" FontSize="28" FontAttributes="Bold" />
            <Label Text="Nhập địa chỉ HTTPS của nhà hàng để đăng nhập, thu thập voucher, theo dõi đơn hàng và xem điểm tích lũy." />
            <Entry x:Name="ServerEntry" Placeholder="https://nhahang.example.com" Keyboard="Url" />
            <Label x:Name="SetupError" TextColor="Red" IsVisible="False" />
            <Button Text="Mở tài khoản khách hàng" Clicked="OnConnectClicked" />
            <Label Text="Sử dụng cùng tài khoản với website. Thiết bị cần truy cập được máy chủ nhà hàng qua HTTPS." FontSize="13" />
        </VerticalStackLayout>
        <WebView x:Name="CustomerWeb" Grid.Row="1" IsVisible="False" Navigating="OnNavigating" Navigated="OnNavigated" />
    </Grid>
</ContentPage>
