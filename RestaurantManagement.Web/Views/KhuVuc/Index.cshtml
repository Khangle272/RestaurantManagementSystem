@model List<RestaurantManagement.API.Models.KhuVuc>
@{ ViewData["Title"] = "Khu vực & tiền đặt cọc"; }
<div class="page-header">
    <div>
        <h1 class="h3">Khu vực & tiền đặt cọc</h1>
        <p class="text-muted">Mỗi khu vực có mức tiền cọc giữ chỗ riêng, áp dụng khi khách đặt bàn trong khu đó.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="SoDoBan" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-grid-3x3-gap me-1" aria-hidden="true"></i>Sơ đồ bàn</a>
        <a asp-action="Edit" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Thêm khu vực</a>
    </div>
</div>
<div class="data-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Khu vực</th><th>Tầng</th><th>Loại</th><th class="text-end">Tiền đặt cọc giữ chỗ</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @if (!Model.Any()) { <tr><td colspan="6" class="empty-state"><i class="bi bi-diagram-3" aria-hidden="true"></i>Chưa có khu vực nào.</td></tr> }
            @foreach (var item in Model) {
                <tr>
                    <td class="fw-semibold">@item.TenKhuVuc</td>
                    <td>@(item.Tang == 0 ? "Tầng trệt" : $"Tầng {item.Tang}")</td>
                    <td>@if (item.LaPhongVip) { <span class="badge-status-warning">VIP</span> } else { <span>Thường</span> }</td>
                    <td class="text-end fw-semibold">@item.TienCocGiuCho.ToString("N0") đ</td>
                    <td><span class="@(item.DangSuDung ? "badge-status-success" : "badge-status-muted")">@(item.DangSuDung ? "Đang sử dụng" : "Ngừng sử dụng")</span></td>
                    <td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
