@model PhieuThanhLyDetailsVM
@{
    Layout = "_AdminLayout";
    var p = Model.PhieuThanhLy;
    ViewData["Title"] = $"Biên bản thanh lý {p.MaPhieu}";
}

<div class="container-fluid py-4" style="max-width: 1000px;">
    <!-- Action buttons (Hidden during print) -->
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <a asp-action="Index" class="btn btn-brand-outline">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-brand-primary">
                <i class="bi bi-printer me-1"></i> In Biên Bản Thanh Lý
            </button>
            <a asp-action="Create" class="btn btn-outline-secondary">
                <i class="bi bi-plus-lg me-1"></i> Lập biên bản mới
            </a>
        </div>
    </div>

    <!-- Printable Disposal Card -->
    <div class="card border-0 shadow-sm invoice-printable p-4 p-md-5">
        <!-- Receipt Header -->
        <div class="row align-items-center pb-4 mb-4 border-bottom">
            <div class="col-8">
                <h3 class="fw-bold text-dark mb-1"><i class="bi bi-shop me-2 text-danger"></i>RESTAURANT MANAGEMENT SYSTEM</h3>
                <div class="text-muted small">Hội đồng Kiểm kê & Xử lý Hao hụt Nguyên vật liệu</div>
                <div class="text-muted small">Địa chỉ: 123 Đường Ẩm Thực, Quận 1, TP. Hồ Chí Minh · Hotline: 1900 6868</div>
            </div>
            <div class="col-4 text-end">
                <h4 class="fw-bold text-danger mb-1">BIÊN BẢN TIÊU HỦY</h4>
                <div class="fw-bold text-dark">Số: @p.MaPhieu</div>
                <div class="text-muted small">Ngày lập: @p.ThoiDiem.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <!-- Disposal Information -->
        <div class="row g-3 mb-4">
            <div class="col-6">
                <div class="p-3 bg-light rounded-3 h-100">
                    <div class="fw-bold text-secondary text-uppercase small mb-2"><i class="bi bi-exclamation-triangle me-1"></i>Lý do & Tình trạng</div>
                    <div class="fw-bold fs-5 text-danger">@p.LyDoThanhLy</div>
                    <div class="small text-muted mt-2"><strong>Ghi chú biên bản:</strong> @(p.GhiChu ?? "Tiêu hủy theo đúng quy định vệ sinh an toàn thực phẩm.")</div>
                </div>
            </div>

            <div class="col-6">
                <div class="p-3 bg-light rounded-3 h-100">
                    <div class="fw-bold text-secondary text-uppercase small mb-2"><i class="bi bi-person-check me-1"></i>Thủ tục kiểm tra</div>
                    <div class="small mb-1"><strong>Người lập biên bản:</strong> @(p.NhanVien?.HoTen ?? "Thủ kho")</div>
                    <div class="small mb-1"><strong>Hình thức xử lý:</strong> Tiêu hủy / Giảm trừ kho</div>
                    <div class="small"><strong>Trạng thái:</strong> <span class="badge bg-danger">Đã tiêu hủy & Ghi sổ chi phí</span></div>
                </div>
            </div>
        </div>

        <!-- Items Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr class="text-center">
                        <th style="width: 50px;">STT</th>
                        <th>Tên Nguyên Liệu</th>
                        <th style="width: 80px;">ĐVT</th>
                        <th style="width: 120px;">Số Lượng Hủy</th>
                        <th style="width: 140px;" class="text-end">Đơn Giá Vốn</th>
                        <th style="width: 160px;" class="text-end">Thiệt Hại (VNĐ)</th>
                        <th>Ghi Chú Chi Tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var idx = 1; }
                    @foreach (var item in p.ChiTiet)
                    {
                        <tr>
                            <td class="text-center text-muted">@(idx++)</td>
                            <td class="fw-bold text-dark">
                                @(item.NguyenLieu?.TenNguyenLieu ?? $"#NL{item.NguyenLieuId:D3}")
                            </td>
                            <td class="text-center">@(item.NguyenLieu?.DonViTinh ?? "—")</td>
                            <td class="text-center fw-semibold text-danger">@item.SoLuong.ToString("0.##")</td>
                            <td class="text-end">@item.DonGiaVon.ToString("N0")</td>
                            <td class="text-end fw-bold text-danger">@item.ThanhTien.ToString("N0")</td>
                            <td class="text-muted small">@(item.GhiChu ?? "Hư hỏng không tái sử dụng")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-end fw-bold text-uppercase py-3">
                            Tổng giá trị thiệt hại thất thoát:
                        </td>
                        <td colspan="2" class="text-end fw-bold text-danger fs-5 py-3">
                            @p.TongTienThietHai.ToString("N0") VNĐ
                        </td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Signature Section -->
        <div class="row text-center mt-5 pt-3">
            <div class="col-4">
                <div class="fw-bold text-dark">Nhân Viên Kiểm Kê</div>
                <div class="small text-muted mb-5">(Ký, ghi rõ họ tên)</div>
                <div class="fw-semibold text-dark">@(p.NhanVien?.HoTen ?? "")</div>
            </div>
            <div class="col-4">
                <div class="fw-bold text-dark">Bếp Trưởng Chứng Kiến</div>
                <div class="small text-muted mb-5">(Ký, ghi rõ họ tên)</div>
            </div>
            <div class="col-4">
                <div class="fw-bold text-dark">Quản Lý Phê Duyệt</div>
                <div class="small text-muted mb-5">(Ký, đóng dấu)</div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        body { background-color: #fff !important; }
        .admin-sidebar, .admin-topbar, .admin-sidebar-footer { display: none !important; }
        .admin-main { margin: 0 !important; padding: 0 !important; }
        .invoice-printable { box-shadow: none !important; border: none !important; padding: 0 !important; }
    }
</style>
