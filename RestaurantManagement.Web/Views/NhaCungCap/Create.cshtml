@model NhaCungCapVM
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm Nhà cung cấp mới";
}

<div class="container-fluid py-4" style="max-width: 900px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold text-heading mb-1"><i class="bi bi-building-add me-2 text-danger"></i>Thêm Nhà cung cấp</h1>
            <p class="text-muted mb-0">Nhập thông tin đối tác cung cấp nguyên vật liệu cho nhà hàng.</p>
        </div>
        <a asp-action="Index" class="btn btn-brand-outline">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12 col-md-8">
                        <label asp-for="TenNhaCungCap" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="TenNhaCungCap" class="form-control" placeholder="Ví dụ: Công ty TNHH Thực phẩm Sạch..." />
                        <span asp-validation-for="TenNhaCungCap" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="MaSoThue" class="form-label fw-semibold"></label>
                        <input asp-for="MaSoThue" class="form-control" placeholder="Mã số thuế doanh nghiệp" />
                        <span asp-validation-for="MaSoThue" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="SoDienThoai" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                            <input asp-for="SoDienThoai" class="form-control" placeholder="0901234567" />
                        </div>
                        <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="lienhe@doitac.vn" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="NguoiLienHe" class="form-label fw-semibold"></label>
                        <input asp-for="NguoiLienHe" class="form-control" placeholder="Họ tên người đại diện / giao dịch" />
                        <span asp-validation-for="NguoiLienHe" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="DiaChi" class="form-label fw-semibold"></label>
                        <input asp-for="DiaChi" class="form-control" placeholder="Địa chỉ trụ sở hoặc kho giao hàng" />
                        <span asp-validation-for="DiaChi" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="GhiChu" class="form-label fw-semibold"></label>
                        <textarea asp-for="GhiChu" rows="3" class="form-control" placeholder="Ghi chú về chính sách công nợ, thời gian giao hàng..."></textarea>
                        <span asp-validation-for="GhiChu" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch mt-2">
                            <input asp-for="DangSuDung" class="form-check-input" type="checkbox" role="switch" id="dangSuDungSwitch" checked />
                            <label class="form-check-label fw-semibold" for="dangSuDungSwitch">Kích hoạt trạng thái đang hợp tác</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-brand-outline">Hủy bỏ</a>
                    <button type="submit" class="btn btn-brand-primary">
                        <i class="bi bi-check-lg me-1"></i> Lưu Nhà Cung Cấp
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
