@model CreateStaffAccountViewModel
@using RestaurantManagement.Web.Security
@{ ViewData["Title"] = "Cấp tài khoản nhân viên"; }
<h1 class="h3 mb-3">Cấp tài khoản nhân viên</h1>
<p>Chỉ cấp cho nhân viên đã có hồ sơ và đang làm việc.</p>
<form asp-action="Create" method="post" style="max-width:540px">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3"><label asp-for="NhanVienId" class="form-label">Nhân viên</label><select asp-for="NhanVienId" asp-items="ViewBag.Employees" class="form-select"><option value="">Chọn nhân viên</option></select><span asp-validation-for="NhanVienId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Email" class="form-label">Email đăng nhập</label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Password" class="form-label">Mật khẩu ban đầu</label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Role" class="form-label">Vai trò</label><select asp-for="Role" class="form-select"><option value="">Chọn vai trò</option>@foreach (var role in AppRoles.AssignableStaff) { <option value="@role">@role</option> }</select><span asp-validation-for="Role" class="text-danger"></span></div>
    <button class="btn btn-primary" type="submit">Tạo tài khoản</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
