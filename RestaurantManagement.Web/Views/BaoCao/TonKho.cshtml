@model RestaurantManagement.Web.Models.BaoCaoTonKhoTongHopViewModel
@{
    ViewData["Title"] = "Tổng hợp giá trị tồn kho";
    ViewData["ActiveMenu"] = "BaoCaoTonKho";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Tổng hợp giá trị tồn kho</h1>
        <p class="text-muted mb-0">Tổng hợp giá trị hàng tồn kho, biến động nhập/xuất chế biến/thanh lý và cảnh báo ngưỡng an toàn nguyên liệu.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Kho" asp-action="BaoCao" class="btn btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-file-earmark-spreadsheet"></i> Báo cáo Nhập-Xuất-Tồn chi tiết
        </a>
        <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-1 shadow-sm" onclick="window.print()">
            <i class="bi bi-printer"></i> In báo cáo
        </button>
    </div>
</div>

<!-- Lọc ngày -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto"><span class="small fw-semibold text-muted"><i class="bi bi-calendar3 me-1"></i> Kỳ chứng từ:</span></div>
            <div class="col-md-3">
                <input type="date" name="tuNgay" value="@Model.TuNgay.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-auto text-muted">đến</div>
            <div class="col-md-3">
                <input type="date" name="denNgay" value="@Model.DenNgay.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Lọc chứng từ</button>
                <a asp-action="TonKho" class="btn btn-sm btn-light">Đặt lại (30 ngày)</a>
            </div>
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Giá trị tồn kho hiện tại</span>
                <div class="fs-3 fw-bold text-primary my-1">@Model.TongGiaTriTonHienTai.ToString("N0") đ</div>
                <div class="small text-muted">Tính theo đơn giá vốn danh mục</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Nhập kho trong kỳ</span>
                <div class="fs-3 fw-bold text-success my-1">+@Model.TongGiaTriNhapTrongKy.ToString("N0") đ</div>
                <div class="small text-muted">Các phiếu nhập đã ghi sổ</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Xuất kho chế biến</span>
                <div class="fs-3 fw-bold text-danger my-1">-@Model.TongGiaTriXuatTrongKy.ToString("N0") đ</div>
                <div class="small text-muted">Xuất phục vụ bếp chế biến</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Thanh lý / Hao hụt</span>
                <div class="fs-3 fw-bold text-warning my-1">@Model.TongGiaTriThanhLyTrongKy.ToString("N0") đ</div>
                <div class="small text-muted">Chi phí hủy hỏng, hết hạn</div>
            </div>
        </div>
    </div>
</div>

@if (Model.DanhSachCanhBao.Count > 0)
{
    <div class="card border-danger border-1 shadow-sm mb-4">
        <div class="card-header bg-danger-subtle text-danger py-3 d-flex justify-content-between align-items-center">
            <h2 class="h6 mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i> Cảnh báo: Có @Model.DanhSachCanhBao.Count nguyên liệu chạm ngưỡng an toàn hoặc sắp hết</h2>
            <a asp-controller="NhapKho" asp-action="Create" class="btn btn-sm btn-danger shadow-sm">Lập phiếu nhập kho ngay</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Nguyên liệu</th>
                            <th class="text-end">Tồn kho hiện tại</th>
                            <th class="text-end">Định mức tối thiểu</th>
                            <th class="text-end text-danger">Lượng thiếu hụt</th>
                            <th class="text-end">Đơn giá tham khảo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in Model.DanhSachCanhBao)
                        {
                            <tr>
                                <td class="fw-bold text-danger">@w.TenNguyenLieu</td>
                                <td class="text-end fw-bold">@w.SoLuongTon.ToString("0.##") @w.DonViTinh</td>
                                <td class="text-end text-muted">@w.NguongCanhBao.ToString("0.##") @w.DonViTinh</td>
                                <td class="text-end fw-bold text-danger">@w.ThieuHut.ToString("0.##") @w.DonViTinh</td>
                                <td class="text-end">@w.DonGia.ToString("N0") đ / @w.DonViTinh</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Bảng tổng hợp chi tiết tất cả nguyên liệu -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-boxes me-1 text-primary"></i> Tổng hợp danh mục tồn kho hiện hành</h2>
        <span class="badge bg-light text-dark border">@Model.ChiTietTonKho.Count nguyên liệu</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Tên nguyên liệu</th>
                    <th>Phân loại</th>
                    <th class="text-end">Số lượng tồn</th>
                    <th>Đơn vị</th>
                    <th class="text-end">Ngưỡng an toàn</th>
                    <th class="text-end">Đơn giá vốn</th>
                    <th class="text-end">Giá trị tồn kho</th>
                    <th class="text-center" style="width: 120px;">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.ChiTietTonKho)
                {
                    <tr class="@(row.CanhBao ? "table-danger-subtle" : "")">
                        <td class="text-muted small">@row.Id</td>
                        <td class="fw-semibold">@row.TenNguyenLieu</td>
                        <td><span class="badge bg-light text-muted border">@(row.DanhMuc ?? "Chung")</span></td>
                        <td class="text-end fw-bold fs-6 @(row.CanhBao ? "text-danger" : "text-dark")">@row.SoLuongTon.ToString("0.##")</td>
                        <td>@row.DonViTinh</td>
                        <td class="text-end text-muted">@row.NguongCanhBao.ToString("0.##")</td>
                        <td class="text-end small">@row.DonGia.ToString("N0") đ</td>
                        <td class="text-end fw-bold text-primary">@row.GiaTriTon.ToString("N0") đ</td>
                        <td class="text-center">
                            @if (row.CanhBao)
                            {
                                <span class="badge bg-danger rounded-pill">Cần bổ sung</span>
                            }
                            else
                            {
                                <span class="badge bg-success rounded-pill">An toàn</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold border-top">
                <tr>
                    <td colspan="7" class="text-end">TỔNG GIÁ TRỊ TỒN KHO TOÀN BỘ:</td>
                    <td class="text-end text-primary fs-6">@Model.TongGiaTriTonHienTai.ToString("N0") đ</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
