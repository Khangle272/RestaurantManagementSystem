@model bool
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var admin = User.IsInRole("Admin");
    var reception = admin || User.IsInRole("TiepTan");
    var staffOrder = admin || User.IsInRole("BoiBan") || User.IsInRole("ThuNgan") || User.IsInRole("TiepTan");
    var warehouse = admin || User.IsInRole("Kho");
    var cashier = admin || User.IsInRole("ThuNgan");
    var kitchen = admin || User.IsInRole("Bep");
    // Menu theo luồng công việc: Đặt bàn → Gọi món & Bếp → Thu ngân → Thực đơn → Kho → Báo cáo → Hệ thống.
    var entries = new (string Group, string Controller, string Action, string Label, bool Allowed)[] {
        ("Tổng quan", "BaoCao", "Index", "Tổng quan kinh doanh", admin),
        ("Đặt bàn & Phục vụ", "SoDoBan", "Index", "Sơ đồ bàn", reception || User.IsInRole("BoiBan")),
        ("Đặt bàn & Phục vụ", "QuanLyDatBan", "Create", "Đặt bàn cho khách", reception),
        ("Đặt bàn & Phục vụ", "QuanLyDatBan", "Index", "Danh sách đặt bàn", reception),
        ("Gọi món & Bếp", "DonHang", "Create", "Ghi nhận gọi món", staffOrder),
        ("Gọi món & Bếp", "DonHang", "Index", "Quản lý đơn hàng", staffOrder),
        ("Gọi món & Bếp", "Bep", "Index", "Màn hình bếp (KDS)", kitchen),
        ("Thu ngân", "HoaDon", "Index", "Hóa đơn & thanh toán", cashier),
        ("Thu ngân", "DatTruoc", "Index", "Đối chiếu tiền đặt cọc", cashier),
        ("Thu ngân", "BaoCao", "NopCa", "Báo cáo nộp ca", cashier),
        ("Thực đơn & Khuyến mãi", "MonAn", "Index", admin ? "Món ăn" : "Chuẩn bị món & công thức", kitchen),
        ("Thực đơn & Khuyến mãi", "DanhMuc", "Index", "Danh mục món", admin),
        ("Thực đơn & Khuyến mãi", "KhuyenMai", "Index", "Khuyến mãi & voucher", admin),
        ("Kho", "Kho", "TonKho", "Tồn kho & cảnh báo", warehouse),
        ("Kho", "NhapKho", "Index", "Nhập kho", warehouse),
        ("Kho", "XuatKho", "Index", "Xuất kho chế biến", warehouse),
        ("Kho", "ThanhLy", "Index", "Thanh lý nguyên liệu", warehouse),
        ("Kho", "NguyenLieu", "Index", "Danh mục nguyên liệu", warehouse),
        ("Kho", "NhaCungCap", "Index", "Nhà cung cấp", warehouse),
        ("Kho", "Kho", "BaoCao", "Báo cáo nhập – xuất – tồn", warehouse),
        ("Báo cáo quản lý", "BaoCao", "DoanhThu", "Doanh thu tháng / năm", admin),
        ("Báo cáo quản lý", "BaoCao", "MonBanChay", "Món bán chạy", admin),
        ("Báo cáo quản lý", "BaoCao", "HieuQuaKhuyenMai", "Hiệu quả khuyến mãi", admin),
        ("Báo cáo quản lý", "BaoCao", "TonKho", "Tổng hợp giá trị tồn kho", admin || warehouse),
        ("Báo cáo quản lý", "ThongKeDatBan", "Index", "Đặt bàn & dự trù nguyên liệu", reception || warehouse || User.IsInRole("Bep")),
        ("Báo cáo quản lý", "QuanLyDatBan", "DanhGia", "Đánh giá khách hàng", reception),
        ("Hệ thống", "NhanVien", "Index", "Nhân viên", admin),
        ("Hệ thống", "NhanVien", "PhanQuyen", "Phân quyền", admin),
        ("Hệ thống", "TaiKhoanKhachHang", "Index", "Khách hàng thành viên", admin),
        ("Hệ thống", "KhuVuc", "Index", "Khu vực & tiền đặt cọc", admin),
        ("Hệ thống", "BanAn", "Index", "Quản lý bàn ăn", admin),
        ("Hệ thống", "CauHinhQr", "Index", "QR nhận chuyển khoản", admin),
        ("Hệ thống", "Account", "Index", "Thông tin cá nhân", true)
    };
    bool IsActive(string targetController, string targetAction) =>
        (controller == targetController || (targetController == "NhanVien" && controller == "TaiKhoanNhanVien"))
        && (targetController != "QuanLyDatBan" || (action is "Create" or "DanhGia" ? action == targetAction : targetAction == "Index"))
        && (targetController != "DonHang" || action == targetAction)
        && (targetController != "Kho" || action == targetAction)
        && (targetController != "NhanVien" || action == targetAction)
        && (targetController != "BaoCao" || action == targetAction)
        && (targetController != "Account" || action != "Denied");

    // Ghi lại mục đang mở để thanh trên cùng hiển thị đường dẫn (breadcrumb): Nhóm › Chức năng › Trang.
    if (!Model)
    {
        var current = entries.FirstOrDefault(x => x.Allowed && IsActive(x.Controller, x.Action));
        if (current.Group is not null) Context.Items["NavCurrent"] = (current.Group, current.Controller, current.Action, current.Label);
    }

    string GetIcon(string ctrl, string act) => (ctrl, act) switch
    {
        ("Account", _) => "bi-person-badge",
        ("NhanVien", "PhanQuyen") => "bi-shield-check",
        ("NhanVien", _) or ("TaiKhoanNhanVien", _) => "bi-people",
        ("TaiKhoanKhachHang", _) => "bi-person-heart",
        ("KhuyenMai", _) => "bi-tags",
        ("Voucher", _) => "bi-ticket-perforated",
        ("BaoCao", "Index") => "bi-graph-up-arrow",
        ("BaoCao", "DoanhThu") => "bi-cash-stack",
        ("BaoCao", "MonBanChay") => "bi-trophy",
        ("BaoCao", "TonKho") => "bi-archive",
        ("BaoCao", "HieuQuaKhuyenMai") => "bi-pie-chart",
        ("BaoCao", "NopCa") => "bi-clipboard-check",
        ("QuanLyDatBan", "Create") => "bi-calendar-plus",
        ("DatTruoc", _) => "bi-piggy-bank",
        ("KhuVuc", _) => "bi-diagram-3",
        ("BanAn", _) => "bi-table",
        ("CauHinhQr", _) => "bi-bank",
        ("ThongKeDatBan", _) => "bi-clipboard-data",
        ("SoDoBan", _) => "bi-grid-3x3-gap",
        ("QuanLyDatBan", "Index") => "bi-calendar-check",
        ("QuanLyDatBan", "DanhGia") => "bi-star-half",
        ("MonAn", _) => "bi-egg-fried",
        ("DanhMuc", _) => "bi-card-list",
        ("DonHang", "Create") => "bi-cart-plus",
        ("DonHang", "Index") => "bi-receipt",
        ("Bep", _) => "bi-fire",
        ("HoaDon", _) => "bi-cash-coin",
        ("Kho", "TonKho") => "bi-boxes",
        ("NhapKho", _) => "bi-box-arrow-in-down",
        ("XuatKho", _) => "bi-box-arrow-up-right",
        ("ThanhLy", _) => "bi-trash3",
        ("Kho", "BaoCao") => "bi-file-earmark-bar-graph",
        ("NhaCungCap", _) => "bi-truck",
        ("NguyenLieu", _) => "bi-basket2",
        _ => "bi-circle"
    };
}
<div class="@(Model ? "row g-3" : "management-navigation")">
@foreach (var group in entries.Where(x => x.Allowed).GroupBy(x => x.Group))
{
    if (Model)
    {
        <div class="col-12 col-md-6 col-xl-4"><section class="card border-0 shadow-sm h-100"><div class="card-body">
            <h2 class="h6 text-success mb-3">@group.Key</h2>
            @foreach (var item in group) { <a asp-controller="@item.Controller" asp-action="@item.Action" class="d-block py-2 text-decoration-none text-body"><i class="bi @GetIcon(item.Controller, item.Action) me-2"></i>@item.Label <span class="float-end text-muted" aria-hidden="true">→</span></a> }
        </div></section></div>
    }
    else if (group.Count() == 1)
    {
        var item = group.Single();
        <a asp-controller="@item.Controller" asp-action="@item.Action" class="nav-link @(IsActive(item.Controller, item.Action) ? "active" : "")" aria-current="@(IsActive(item.Controller, item.Action) ? "page" : null)" title="@item.Label"><i class="bi @GetIcon(item.Controller, item.Action) me-2"></i><span class="nav-link-text">@item.Label</span></a>
    }
    else
    {
        <details class="management-menu-group" open="@(group.Any(x => IsActive(x.Controller, x.Action)))">
            <summary>@group.Key</summary>
            <div class="management-menu-children">
            @foreach (var item in group) {
                <a asp-controller="@item.Controller" asp-action="@item.Action" class="nav-link @(IsActive(item.Controller, item.Action) ? "active" : "")" aria-current="@(IsActive(item.Controller, item.Action) ? "page" : null)" title="@item.Label"><i class="bi @GetIcon(item.Controller, item.Action) me-2"></i><span class="nav-link-text">@item.Label</span></a>
            }
            </div>
        </details>
    }
}
</div>
