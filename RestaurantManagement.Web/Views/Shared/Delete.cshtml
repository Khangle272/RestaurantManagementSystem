@model DeleteRecordViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Xóa {Model.Description}";
}
<div class="container-fluid py-4">
    <a asp-action="Index" class="text-decoration-none text-muted d-inline-block mb-3">← Quay lại danh sách</a>
    <h2 class="h3 mb-4">@ViewData["Title"]</h2>
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <p>Bạn có chắc chắn muốn xóa @Model.Description <strong>@Model.Name</strong>?</p>
            <p class="text-muted">Thao tác này không thể hoàn tác. Bản ghi có dữ liệu liên quan sẽ không được xóa.</p>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <input asp-for="Id" type="hidden" />
                <input asp-for="RowVersion" type="hidden" />
                <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>
