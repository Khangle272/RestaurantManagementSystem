@model BanAnFormViewModel
@{
    Layout = "_AdminLayout";
    var editing = ViewContext.RouteData.Values["action"]?.ToString() == "Edit";
    ViewData["Title"] = editing ? "Cập nhật bàn ăn" : "Thêm bàn ăn";
}

<div class="container-fluid py-4">
    <a asp-action="Index" class="text-decoration-none text-muted d-inline-block mb-3">← Quay lại danh sách</a>
    <h2 class="h3 mb-4">@ViewData["Title"]</h2>
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : (int?)null)" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                @if (editing)
                {
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="RowVersion" type="hidden" />
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="MaBan" class="form-label fw-medium"></label>
                        <input asp-for="MaBan" type="text" class="form-control" />
                        <span asp-validation-for="MaBan" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="KhuVucId" class="form-label fw-medium"></label>
                        <select asp-for="KhuVucId" asp-items="Model.KhuVucOptions" class="form-select">
                            <option value="">-- Chọn khu vực --</option>
                        </select>
                        @if (!Model.KhuVucOptions.Any())
                        {
                            <div class="form-text text-danger">Chưa có khu vực đang sử dụng để thêm bàn ăn.</div>
                        }
                        <span asp-validation-for="KhuVucId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SoChoNgoi" class="form-label fw-medium"></label>
                        <input asp-for="SoChoNgoi" type="number" min="1" step="1" class="form-control" />
                        <span asp-validation-for="SoChoNgoi" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TrangThai" class="form-label fw-medium"></label>
                        <select asp-for="TrangThai" class="form-select">
                            @foreach (var status in Enum.GetValues<RestaurantManagement.API.Models.TrangThaiBan>())
                            {
                                <option value="@status">@BanAnLabels.TrangThai(status)</option>
                            }
                        </select>
                        <span asp-validation-for="TrangThai" class="text-danger small"></span>
                    </div>
                </div>
                <div class="d-flex gap-2 pt-3 mt-4 border-top">
                    <button type="submit" class="btn btn-primary btn-brand-primary px-4">Lưu bàn ăn</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

