@model TonKhoFilterVM
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Theo dõi Tồn kho & Cảnh báo";
    var p = Model.Pagination;
    var hasAlerts = Model.SoNguyenLieuSapHet > 0 || Model.SoNguyenLieuCanKho > 0;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-heading mb-1"><i class="bi bi-boxes me-2 text-danger"></i>Theo dõi Tồn kho & Cảnh báo</h1>
            <p class="text-muted mb-0">Giám sát số lượng tồn thực tế, theo dõi định mức an toàn và kích hoạt nhập hàng kịp thời.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="NhapKho" asp-action="Create" class="btn btn-brand-primary d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-cart-plus"></i> Lập Phiếu Nhập Hàng
            </a>
            <a asp-action="BaoCao" class="btn btn-brand-outline d-inline-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-bar-graph"></i> Báo Cáo Nhập - Xuất - Tồn
            </a>
        </div>
    </div>

    <!-- Stock Alert Banner (Design Token Amber / Red) -->
    @if (hasAlerts)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex flex-wrap justify-content-between align-items-center p-3 mb-4 rounded-3" style="background-color: #FEF3C7; border-left: 5px solid #F59E0B !important;">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning bg-opacity-25 p-2 text-warning fs-3">
                    <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                </div>
                <div>
                    <h5 class="alert-heading fw-bold mb-1 text-dark">Cảnh báo nguyên vật liệu kho chạm ngưỡng an toàn!</h5>
                    <div class="text-secondary small">
                        Hiện có <strong>@Model.SoNguyenLieuSapHet</strong> nguyên liệu sắp hết và <strong>@Model.SoNguyenLieuCanKho</strong> nguyên liệu đã cạn kho hoàn toàn. Vui lòng lập phiếu nhập để không gián đoạn khâu chế biến!
                    </div>
                </div>
            </div>
            <a asp-controller="NhapKho" asp-action="Create" class="btn btn-warning text-dark fw-bold px-3 shadow-sm mt-2 mt-md-0">
                <i class="bi bi-box-arrow-in-down me-1"></i> Nhập hàng ngay
            </a>
        </div>
    }

    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-stat border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Tổng Mặt Hàng</div>
                        <div class="fs-2 fw-bold text-dark mt-1">@Model.TongSoNguyenLieu</div>
                    </div>
                    <div class="rounded-circle p-3 bg-light text-primary fs-3">
                        <i class="bi bi-archive"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-stat border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Cần Nhập Gấp</div>
                        <div class="fs-2 fw-bold text-warning mt-1">@Model.SoNguyenLieuSapHet</div>
                    </div>
                    <div class="rounded-circle p-3 bg-light text-warning fs-3">
                        <i class="bi bi-bell"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-stat border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Đã Cạn Kho</div>
                        <div class="fs-2 fw-bold text-danger mt-1">@Model.SoNguyenLieuCanKho</div>
                    </div>
                    <div class="rounded-circle p-3 bg-light text-danger fs-3">
                        <i class="bi bi-x-octagon"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-stat border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Tổng Giá Trị Tồn Kho</div>
                        <div class="fs-2 fw-bold text-success mt-1">@Model.TongGiaTriTonKho.ToString("N0") <small class="fs-6 text-muted">VNĐ</small></div>
                    </div>
                    <div class="rounded-circle p-3 bg-light text-success fs-3">
                        <i class="bi bi-wallet2"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Toolbar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="TonKho" method="get" class="row g-3 align-items-end" id="formFilter">
                <div class="col-12 col-md-4">
                    <label for="keyword" class="form-label small fw-semibold text-secondary">Tìm kiếm nguyên liệu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-subtle text-muted"><i class="bi bi-search"></i></span>
                        <input id="keyword" name="keyword" value="@Model.Keyword" class="form-control border-start-0" placeholder="Tên nguyên liệu hoặc mã số..." />
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <label for="danhMuc" class="form-label small fw-semibold text-secondary">Nhóm phân loại</label>
                    <select id="danhMuc" name="danhMuc" class="form-select">
                        <option value="">Tất cả phân nhóm</option>
                        @foreach (var dm in Model.DanhMucList)
                        {
                            <option value="@dm" selected="@(Model.DanhMuc == dm)">@dm</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <div class="form-check form-switch pt-4">
                        <input class="form-check-input" type="checkbox" role="switch" id="onlyLowStock" name="lowStock" value="true" @(Model.OnlyLowStock ? "checked" : "") onchange="this.form.submit()" />
                        <label class="form-check-label fw-semibold text-danger small" for="onlyLowStock">
                            Chỉ hiện hàng chạm ngưỡng / cạn kho
                        </label>
                    </div>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button class="btn btn-brand-primary w-100" type="submit">
                        <i class="bi bi-funnel me-1"></i> Lọc
                    </button>
                    <a asp-action="TonKho" class="btn btn-brand-outline" title="Đặt lại bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-admin align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 90px;">Mã NL</th>
                        <th>Tên Nguyên Liệu</th>
                        <th>Phân Nhóm</th>
                        <th>ĐVT</th>
                        <th class="text-center">Tồn Kho Khả Dụng</th>
                        <th class="text-center">Định Mức Tối Thiểu</th>
                        <th class="text-end">Đơn Giá Nhập</th>
                        <th class="text-end">Giá Trị Tồn Kho</th>
                        <th>Trạng Thái</th>
                        <th class="text-end" style="width: 140px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.DanhSachTon.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Không tìm thấy nguyên liệu nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.DanhSachTon)
                    {
                        var isZero = item.SoLuongTon <= 0;
                        var isWarning = item.SoLuongTon > 0 && item.SoLuongTon <= item.DinhMucToiThieu;
                        <tr>
                            <td class="fw-bold text-secondary">@($"#NL{item.MaNguyenLieu:D3}")</td>
                            <td>
                                <div class="fw-bold text-dark">@item.TenNguyenLieu</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@(item.DanhMuc ?? "Gia vị / Khác")</span>
                            </td>
                            <td>@item.DonViTinh</td>
                            <td class="text-center">
                                <span class="fs-6 fw-bold @(isZero ? "text-danger" : (isWarning ? "text-warning" : "text-success"))">
                                    @item.SoLuongTon.ToString("0.##")
                                </span>
                            </td>
                            <td class="text-center text-muted">
                                @item.DinhMucToiThieu.ToString("0.##")
                            </td>
                            <td class="text-end">
                                @item.DonGia.ToString("N0") VNĐ
                            </td>
                            <td class="text-end fw-bold text-dark">
                                @item.GiaTriTonKho.ToString("N0") VNĐ
                            </td>
                            <td>
                                @if (isZero)
                                {
                                    <span class="badge-status-danger d-inline-flex align-items-center gap-1">
                                        <span class="badge-dot bg-danger"></span> Cạn kho
                                    </span>
                                }
                                else if (isWarning)
                                {
                                    <span class="badge-status-warning d-inline-flex align-items-center gap-1">
                                        <span class="badge-dot bg-warning"></span> Sắp hết
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status-success d-inline-flex align-items-center gap-1">
                                        <span class="badge-dot bg-success"></span> An toàn
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="NhapKho" asp-action="Create" class="btn btn-sm btn-outline-danger" title="Nhập bổ sung ngay">
                                    <i class="bi bi-cart-plus me-1"></i> Nhập thêm
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center py-3">
            <span class="text-muted small">
                Hiển thị @Model.DanhSachTon.Count trên tổng số <strong>@p.TotalItems</strong> nguyên liệu · Trang @p.CurrentPage / @p.TotalPages
            </span>
            <div class="btn-group btn-group-sm">
                @if (p.CurrentPage > 1)
                {
                    <a class="btn btn-outline-secondary" asp-action="TonKho" asp-route-page="@(p.CurrentPage - 1)" asp-route-keyword="@Model.Keyword" asp-route-lowStock="@Model.OnlyLowStock" asp-route-danhMuc="@Model.DanhMuc">
                        <i class="bi bi-chevron-left me-1"></i> Trang trước
                    </a>
                }
                @if (p.CurrentPage < p.TotalPages)
                {
                    <a class="btn btn-outline-secondary" asp-action="TonKho" asp-route-page="@(p.CurrentPage + 1)" asp-route-keyword="@Model.Keyword" asp-route-lowStock="@Model.OnlyLowStock" asp-route-danhMuc="@Model.DanhMuc">
                        Trang sau <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div>
