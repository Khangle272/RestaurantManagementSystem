@model RestaurantManagement.Web.Models.KhuyenMaiListViewModel
@{ ViewData["Title"] = "Chương trình khuyến mãi & voucher"; }
<div class="d-flex justify-content-between mb-4"><div><h1 class="h3">@ViewData["Title"]</h1><p class="text-muted">Mỗi chương trình quản lý chung nhiều mã giảm giá.</p></div><a asp-action="Create" class="btn btn-primary align-self-start">Tạo chương trình</a></div>
<form method="get" class="d-flex flex-wrap gap-2 mb-3"><input name="search" value="@Model.Search" class="form-control" style="max-width:350px" placeholder="Tên chương trình hoặc mã voucher" aria-label="Tìm chương trình" /><select name="statusFilter" class="form-select" style="max-width:220px" aria-label="Trạng thái"><option value="">Mọi trạng thái</option><option value="DangDienRa" selected="@(Model.StatusFilter == "DangDienRa")">Đang diễn ra</option><option value="SapDienRa" selected="@(Model.StatusFilter == "SapDienRa")">Sắp diễn ra</option><option value="DaKetThuc" selected="@(Model.StatusFilter == "DaKetThuc")">Đã kết thúc</option><option value="NgungSuDung" selected="@(Model.StatusFilter == "NgungSuDung")">Ngừng sử dụng</option></select><button class="btn btn-outline-primary" type="submit">Tìm kiếm</button><a asp-action="Index" class="btn btn-outline-secondary">Bỏ lọc</a></form>
<div class="card table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Chương trình</th><th>Mã voucher</th><th>Thời hạn (giờ Việt Nam)</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td colspan="5" class="text-muted text-center py-4">Chưa có chương trình phù hợp.</td></tr> }
@foreach (var p in Model.Items) {
    <tr><td><a asp-action="Edit" asp-route-id="@p.Id" class="fw-bold">@p.TenChuongTrinh</a><small class="d-block text-muted">@(p.CanVoucher ? "Ưu đãi riêng trên từng mã" : $"Tự động: giảm {p.GiaTri:0.##}{(p.KieuGiam == RestaurantManagement.API.Models.KieuGiam.PhanTram ? "%" : "đ")}")</small></td><td>@p.SoVoucherDaPhatHanh mã<small class="d-block text-muted">@p.SoLuotDaSuDung lượt dùng / giữ</small></td><td class="small">@p.BatDau.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")<br />→ @p.KetThuc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</td><td>@p.TrangThaiHienThi</td><td><a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary mb-1">Quản lý chương trình & mã</a><form asp-action="ToggleStatus" method="post"><input name="id" type="hidden" value="@p.Id" /><button type="submit" class="btn btn-sm btn-outline-secondary">@(p.DangSuDung ? "Ngừng chương trình" : "Kích hoạt")</button></form></td></tr>
}
</tbody></table></div>
<div class="d-flex gap-3 mt-3 align-items-center"><span>@Model.TotalItems chương trình · Trang @Model.Page / @Model.TotalPages</span>@if (Model.Page > 1) { <a asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.StatusFilter">Trước</a> }@if (Model.Page < Model.TotalPages) { <a asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.StatusFilter">Tiếp</a> }</div>
