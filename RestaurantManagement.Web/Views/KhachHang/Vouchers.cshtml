@model List<RestaurantManagement.Web.Services.CustomerVoucherItem>
@{ var wallet = (bool)ViewBag.Wallet; var balance = (int)ViewBag.PointBalance; ViewData["Title"] = wallet ? "Ví voucher của tôi" : "Khám phá voucher"; }
<h1 class="h3 mb-3 customer-head">@ViewData["Title"]</h1>
<div class="card card-body mb-3 voucher-points"><div><span class="text-muted">Điểm hiện có</span><strong class="d-block fs-3">@balance.ToString("N0") điểm</strong></div><a asp-action="Index" class="small">Xem đơn hàng & lịch sử tích điểm <i class="bi bi-arrow-right" aria-hidden="true"></i></a><span class="small text-muted w-100">Đổi điểm lấy voucher bên dưới, sau đó chọn voucher trong ví khi xem hóa đơn. Mỗi khách đổi mỗi mã một lần.</span></div>
<nav class="voucher-tabs mb-3" aria-label="Loại voucher"><a asp-action="Vouchers" class="@(wallet ? "" : "active")" aria-current="@(wallet ? null : "page")"><i class="bi bi-ticket-perforated" aria-hidden="true"></i>Mã có thể thu thập</a><a asp-action="Vouchers" asp-route-wallet="true" class="@(wallet ? "active" : "")" aria-current="@(wallet ? "page" : null)"><i class="bi bi-wallet2" aria-hidden="true"></i>Ví của tôi</a></nav>
<p class="small text-muted">Thời gian theo giờ Việt Nam. Voucher có ghi mức điểm cần được đổi vào ví trước khi dùng. Điểm đã đổi không hoàn lại khi voucher hết hạn.</p>
@if (Model.Count == 0) {
    <div class="voucher-empty"><i class="bi bi-ticket-perforated" aria-hidden="true"></i><p class="mb-3">@(wallet ? "Ví chưa có mã nào." : "Hiện chưa có voucher khả dụng. Quay lại sau nhé!")</p>
    @if (wallet) { <a asp-action="Vouchers" class="btn btn-primary">Khám phá voucher</a> }</div>
}
<div class="row g-3">
@foreach (var item in Model.OrderBy(x => x.CoTheDung && !x.DaLuu ? 0 : x.CoTheDung ? 1 : 2)) {
    var statusCss = item.DaLuu && item.CoTheDung ? "text-bg-success" : item.CoTheDung ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis";
    <div class="col-md-6 col-lg-4"><article class="card h-100 voucher-card @(item.CoTheDung ? "" : "is-unavailable")"><div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-1"><p class="small text-muted mb-0">@item.ChuongTrinh</p><span class="badge rounded-pill @statusCss">@(item.DaLuu && item.CoTheDung ? "Đã lưu vào ví" : item.TrangThai)</span></div>
        <h2 class="h5 font-monospace voucher-code">@item.Ma</h2><p class="fw-semibold mb-2">@item.UuDai</p>
        <p class="small text-muted"><i class="bi bi-clock me-1" aria-hidden="true"></i>@VnTime.NgayGio(item.BatDau) → @VnTime.NgayGio(item.KetThuc)</p>
        @if (item.DiemCanDoi > 0) { <p class="fw-semibold">Đổi bằng @item.DiemCanDoi.ToString("N0") điểm</p> }
        @if (item.DaLuu) { if (item.CoTheDung) { <p class="small text-success mb-0 mt-auto"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>Chọn mã này khi xem hóa đơn để được giảm.</p> } }
        else if (item.CoTheDung && item.DiemCanDoi > 0) {
            <form asp-action="Redeem" method="post" class="mt-auto"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="expectedPoints" value="@item.DiemCanDoi" /><button class="btn btn-primary" type="submit" disabled="@(balance < item.DiemCanDoi)">Đổi @item.DiemCanDoi.ToString("N0") điểm lấy voucher</button></form>
            @if (balance < item.DiemCanDoi) { <p class="small text-muted mt-2">Cần thêm @((item.DiemCanDoi - balance).ToString("N0")) điểm để đổi.</p> }
        }
        else if (item.CoTheDung) { <form asp-action="Collect" method="post" class="mt-auto"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-primary" type="submit">Thu thập / Lưu vào ví</button></form> }
    </div></article></div>
}
</div>
