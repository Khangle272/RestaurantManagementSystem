@{ Layout = "_AccountLayout"; ViewData["Title"] = "Thông tin cá nhân"; }
<section>
    <p class="small text-success fw-semibold mb-2">THÔNG TIN TÀI KHOẢN</p>
    <h1 class="h3 mb-2">Thông tin cá nhân</h1>
    <p class="text-muted">Thông tin đăng nhập và bảo mật của bạn.</p>
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    <dl class="my-4">
        <dt class="small text-muted">Tài khoản đăng nhập</dt>
        <dd class="mt-2 text-break">@User.Identity?.Name</dd>
        <dt class="small text-muted mt-3">Vai trò</dt>
        <dd class="mt-2">
            <partial name="_RoleLabel" />
        </dd>
    </dl>
    <div class="d-flex flex-wrap gap-2">
        @if (User.IsInRole("Admin") || User.IsInRole("KhachHang"))
        {
            <a asp-action="EditProfile" class="btn btn-outline-primary">Sửa thông tin</a>
        }
        <a asp-action="ChangePassword" class="btn @(User.IsInRole("KhachHang") ? "btn-restaurant" : "btn-primary")">Đổi mật khẩu</a>
        <form asp-action="Logout" method="post"><button class="btn btn-outline-secondary" type="submit">Đăng xuất</button></form>
    </div>
</section>
