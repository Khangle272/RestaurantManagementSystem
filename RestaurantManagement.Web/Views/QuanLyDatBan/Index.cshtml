@model RestaurantManagement.Web.Models.DatBanAdminVM
@using RestaurantManagement.Web.Services
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Danh sách đặt bàn";
    var currentTab = ViewBag.CurrentTab as string ?? "ChoXacNhan";
}

@section Styles { <link rel="stylesheet" href="~/css/tables.css" asp-append-version="true" /> }
<div id="reservation-feedback" role="status" class="alert alert-success" hidden></div>
<div id="reservation-list">
<div class="page-header">
    <div>
        <h1 class="h3">Danh sách đặt bàn</h1>
        <p class="text-muted mb-0">Duyệt yêu cầu đặt bàn, xếp bàn, đối chiếu cọc và nhận khách theo từng trạng thái. Hôm nay có <strong>@Model.HomNayCount</strong> lượt khách.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="SoDoBan" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-grid-3x3-gap me-1" aria-hidden="true"></i>Sơ đồ bàn</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-calendar-plus me-1" aria-hidden="true"></i>Đặt bàn cho khách</a>
    </div>
</div>
<!-- TABS VÀ THANH CÔNG CỤ LỌC -->
<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-header bg-white border-bottom p-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <!-- Tabs -->
            <nav class="segmented" aria-label="Lọc yêu cầu theo trạng thái">
                <a class="@(currentTab == "ChoXacNhan" ? "active" : "")" asp-action="Index" asp-route-tab="ChoXacNhan"><i class="bi bi-hourglass-split" aria-hidden="true"></i>Chờ xác nhận <span class="count">@Model.ChoXacNhanCount</span></a>
                <a class="@(currentTab == "DaXacNhan" ? "active" : "")" asp-action="Index" asp-route-tab="DaXacNhan"><i class="bi bi-check2-circle" aria-hidden="true"></i>Đã xác nhận <span class="count">@Model.DaXacNhanCount</span></a>
                <a class="@(currentTab == "DangPhucVu" ? "active" : "")" asp-action="Index" asp-route-tab="DangPhucVu"><i class="bi bi-bell" aria-hidden="true"></i>Đang phục vụ <span class="count">@Model.DangPhucVuCount</span></a>
                <a class="@(currentTab == "HoanTat" ? "active" : "")" asp-action="Index" asp-route-tab="HoanTat"><i class="bi bi-archive" aria-hidden="true"></i>Hoàn tất</a>
                <a class="@(currentTab == "DaHuy" ? "active" : "")" asp-action="Index" asp-route-tab="DaHuy"><i class="bi bi-x-octagon" aria-hidden="true"></i>Đã hủy <span class="count">@Model.DaHuyCount</span></a>
            </nav>

            <!-- Bộ lọc ngày -->
            <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
                <input type="hidden" name="tab" value="@currentTab" />
                <label class="small text-muted text-nowrap">Lọc ngày:</label>
                <input type="date" name="filterNgay" class="form-control form-control-sm" 
                       value="@(Model.FilterNgay.HasValue ? Model.FilterNgay.Value.ToString("yyyy-MM-dd") : "")" 
                       onchange="this.form.submit()" />
                @if (Model.FilterNgay.HasValue)
                {
                    <a asp-action="Index" asp-route-tab="@currentTab" class="btn btn-sm btn-outline-secondary" title="Bỏ lọc ngày">
                        <i class="bi bi-x-circle"></i>
                    </a>
                }
            </form>
        </div>
    </div>

    <!-- BẢNG DỮ LIỆU ĐẶT BÀN -->
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã đặt bàn</th>
                        <th>Khách hàng</th>
                        <th>Giờ đến hẹn</th>
                        <th>Bàn ăn đã xếp</th>
                        <th>Trạng thái</th>
                                                <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachDatBan.Any())
                    {
                        @foreach (var item in Model.DanhSachDatBan)
                        {
                            <tr>
                                @{
                                    var local = item.ThoiGianDen.ToOffset(TimeSpan.FromHours(7));
                                    var slot = ReservationSchedule.Match(local.DateTime);
                                    var slotLabel = slot?.Name ?? "Lịch cũ";
                                }
                                <td class="ps-3">
                                    <div class="cell-code">@item.BookingCode</div>
                                    <span class="badge bg-light text-secondary border mt-1">@slotLabel</span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.HoTen</div>
                                    <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@item.SoDienThoai</div>
                                    <span class="badge bg-light text-dark border mt-1"><i class="bi bi-people me-1"></i>@item.SoNguoi khách</span>
                                    @if (!string.IsNullOrEmpty(item.GhiChu)) { <span class="cell-sub cell-note mt-1" title="Ghi chú của khách"><i class="bi bi-chat-left-text me-1" aria-hidden="true"></i>@item.GhiChu</span> }
                                </td>
                                <td>
                                    <div class="fw-semibold cell-nowrap">
                                        <i class="bi bi-clock me-1 text-secondary" aria-hidden="true"></i>@local.ToString("HH:mm")–@item.GioKetThuc?.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm")
                                    </div>
                                    <div class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@local.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    @if (item.TenBan != "Chưa gán" && item.TenBan != "Chưa xếp bàn")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                            <i class="bi bi-table me-1"></i>@item.TenBan
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                            Chưa xếp bàn
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @item.TrangThaiBadgeClass px-2 py-1">
                                        @item.TrangThai
                                    </span>
                                    <span class="cell-sub mt-1">@item.TinhTrangCoc</span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="row-actions can-wrap">
                                        <a asp-controller="DatTruoc" asp-action="ChiTiet" asp-route-id="@item.MaDatBan" class="btn btn-sm btn-outline-secondary" title="Món đặt trước, cọc và yêu cầu hủy">Món & cọc</a>
                                        <!-- Nút Xếp bàn (Cho Chờ xác nhận hoặc muốn đổi bàn) -->
                                        @if (item.TrangThai == "Chờ xác nhận" || item.TrangThai == "Chờ cọc" || item.TrangThai == "Đã xác nhận")
                                        {
                                            <a asp-action="DoiGio" asp-route-id="@item.MaDatBan" data-reschedule-booking="@item.MaDatBan" class="btn btn-sm btn-outline-secondary">Đổi giờ</a>
                                            <a asp-controller="SoDoBan" asp-action="Index" asp-route-datBanId="@item.MaDatBan" data-assign-booking="@item.MaDatBan" class="btn btn-sm btn-primary fw-semibold" title="Duyệt và xếp bàn">
                                                <i class="bi bi-table me-1"></i>Xếp bàn
                                            </a>
                                        }

                                        <!-- Nút Check-in Nhận bàn (Khi đã xác nhận và có bàn) -->
                                        @if (item.TrangThai == "Đã xác nhận" || (item.TrangThai == "Chờ cọc" && item.BanAnId > 0))
                                        {
                                            <form asp-action="NhanBan" method="post" class="d-inline" 
                                                  data-confirm="Khách @item.HoTen (@item.BookingCode) đã đến và nhận bàn? Bàn sẽ chuyển sang Đang phục vụ.@(item.TrangThai == "Chờ cọc" ? " Phần cọc chưa nộp sẽ không thu trước nữa." : "")" data-confirm-title="Xác nhận khách đến" data-confirm-ok="Khách đã đến" data-confirm-variant="primary">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="datBanId" value="@item.MaDatBan" />
                                                <input type="hidden" name="rowVersion" value="@item.RowVersion" />
                                                <button type="submit" class="btn btn-sm btn-success fw-semibold">
                                                    <i class="bi bi-box-arrow-in-right me-1"></i>Nhận bàn
                                                </button>
                                            </form>
                                        }

                                        <!-- Xem hóa đơn nếu đang phục vụ / hoàn tất -->
                                        @if (item.HoaDonId.HasValue && User.IsInRole("Admin"))
                                        {
                                            <a asp-controller="HoaDon" asp-action="Details" asp-route-id="@item.HoaDonId.Value" 
                                               class="btn btn-sm btn-outline-secondary" title="Xem chi tiết hóa đơn" aria-label="Xem chi tiết hóa đơn">
                                                <i class="bi bi-receipt"></i>
                                            </a>
                                        }

                                        <!-- Nút Không đến: chỉ hiện khi đã quá giờ hẹn -->
                                        @if ((item.TrangThai == "Chờ xác nhận" || item.TrangThai == "Chờ cọc" || item.TrangThai == "Đã xác nhận")
                                            && item.ThoiGianDen.AddMinutes(RestaurantManagement.Web.Services.TableService.NoShowGraceMinutes) <= DateTimeOffset.UtcNow)
                                        {
                                            <form asp-action="KhongDen" method="post" class="d-inline"
                                                  data-confirm="Ghi nhận khách @item.HoTen (@item.BookingCode) không đến? Bàn được trả cho lượt khác." data-confirm-title="Khách không đến" data-confirm-ok="Ghi nhận" data-confirm-variant="danger">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="datBanId" value="@item.MaDatBan" />
                                                <input type="hidden" name="rowVersion" value="@item.RowVersion" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">Không đến</button>
                                            </form>
                                        }

                                        <!-- Nút Hủy đơn -->
                                        @if (item.TrangThai == "Chờ xác nhận" || item.TrangThai == "Chờ cọc" || item.TrangThai == "Đã xác nhận")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" 
                                                    data-bs-toggle="modal" data-bs-target="#modalHuyBan" 
                                                    data-id="@item.MaDatBan" data-code="@item.BookingCode"
                                                    data-version="@item.RowVersion" title="Hủy đơn đặt bàn" aria-label="Hủy đơn đặt bàn">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="empty-state">
                                <i class="bi bi-calendar-x" aria-hidden="true"></i>
                                Không có yêu cầu đặt bàn nào trong danh mục này.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


</div>
<partial name="_TableBlockedModal" />
<div class="modal fade" id="assignment-modal" tabindex="-1" aria-labelledby="assignment-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-lg-down"><div class="modal-content">
        <div class="modal-header"><h2 id="assignment-modal-title" class="modal-title h5">Xếp bàn cho yêu cầu đặt chỗ</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <div id="assignment-content" class="modal-body" aria-live="polite"></div>
    </div></div>
</div>
<!-- MODAL HỦY ĐẶT BÀN -->
<div class="modal fade" id="modalHuyBan" tabindex="-1" aria-labelledby="modalHuyBanTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="HuyBan" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger" id="modalHuyBanTitle">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Hủy đơn đặt bàn
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="DatBanId" id="huyBanDatBanId" />
                    <input type="hidden" name="rowVersion" id="huyBanRowVersion" />
                    <p class="text-secondary mb-3">
                        Bạn có chắc chắn muốn hủy đơn đặt bàn <strong class="text-danger font-monospace" id="huyBanCode"></strong>?
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lý do hủy đơn <span class="text-danger">*</span></label>
                        <textarea name="LyDoHuy" class="form-control" rows="3" required
                                  placeholder="Ví dụ: Khách gọi báo bận đột xuất, hết bàn trống, không liên lạc được..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger fw-semibold px-4">
                        <i class="bi bi-trash-fill me-1"></i>Xác nhận hủy
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/tables.js" asp-append-version="true"></script>
    <script src="~/js/reservation-admin.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Modal Hủy bàn
            const modalHuyBan = document.getElementById("modalHuyBan");
            if (modalHuyBan) {
                modalHuyBan.addEventListener("show.bs.modal", function (event) {
                    const button = event.relatedTarget;
                    document.getElementById("huyBanDatBanId").value = button.getAttribute("data-id");
                    document.getElementById("huyBanRowVersion").value = button.getAttribute("data-version");
                    document.getElementById("huyBanCode").innerText = button.getAttribute("data-code");
                });
            }
        });
    </script>
}
