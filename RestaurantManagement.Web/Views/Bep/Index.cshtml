@model List<RestaurantManagement.Web.Controllers.BepRow>
@using RestaurantManagement.API.Models
@functions { private static string TableServiceToday() => RestaurantManagement.Web.Services.TableService.VietnamNow.ToString("dd/MM/yyyy"); }
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Màn hình bếp (KDS)";
    var currentFilter = (ViewBag.Filter as string) ?? "active";
    var cancelled = ViewBag.Cancelled as List<RestaurantManagement.Web.Controllers.BepRow> ?? [];
    var canClose = User.IsInRole("Admin") || User.IsInRole("Bep");

    (string Label, string Color, string Border) TrangThaiStyle(TrangThaiCheBien trangThai) => trangThai switch
    {
        TrangThaiCheBien.ChoCheBien => ("Chờ nấu", "#F59E0B", "#F59E0B"),
        TrangThaiCheBien.DangCheBien => ("Đang nấu", "#0EA5E9", "#0EA5E9"),
        TrangThaiCheBien.SanSang => ("Sẵn sàng ra món", "#10B981", "#10B981"),
        _ => ("Đã phục vụ", "#E2E8F0", "#94A3B8")
    };
}

<style>
    .kds-card { border-radius: 14px; }
    .kds-ban { font-weight: 700; font-size: 1.05rem; color: #0F172A; }
    .kds-mon { font-size: 1.125rem; font-weight: 700; line-height: 1.3; color: #0F172A; }
    .kds-sl { font-size: 1.35rem; font-weight: 800; color: #E11D48; }
    .kds-note { border: 1px solid #F59E0B; background: #FFFBEB; color: #92400E; border-radius: 8px; padding: .45rem .6rem; font-size: .85rem; font-weight: 600; }
    .kds-meta { font-size: .8rem; color: #64748B; }
    .kds-seq { display: inline-flex; align-items: center; justify-content: center; min-width: 2rem; height: 2rem; border-radius: 50%; background: #0F172A; color: #fff; font-weight: 800; font-size: .85rem; }
    .kds-cancel { border: 2px solid #DC2626; background: #FEF2F2; border-radius: 12px; }
</style>

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="h3 mb-1">Màn hình bếp (KDS) & điều phối món</h1>
            <p class="text-muted mb-0">Chỉ hiển thị món gọi trong ngày @TableServiceToday(). Thứ tự: món gọi trước làm trước — đọc từ trái sang phải, từ trên xuống dưới. <span id="kds-live-status" role="status">Tự cập nhật trạng thái.</span></p>
        </div>
        <div class="btn-group" role="group">
            <a asp-action="Index" asp-route-filter="active" class="btn btn-sm @(currentFilter == "active" ? "btn-primary" : "btn-outline-primary")">
                <i class="bi bi-fire me-1"></i> Đang chờ & Đang nấu
            </a>
            <a asp-action="Index" asp-route-filter="ready" class="btn btn-sm @(currentFilter == "ready" ? "btn-success" : "btn-outline-success")">
                <i class="bi bi-check2-circle me-1"></i> Đã nấu xong (Chờ mang ra)
            </a>
            <a asp-action="Index" asp-route-filter="all" class="btn btn-sm @(currentFilter == "all" ? "btn-secondary" : "btn-outline-secondary")">
                Tất cả
            </a>
        </div>
        @if (canClose)
        {
            <form asp-action="KetThucNgay" method="post" data-confirm="Món chưa nấu của bill chưa thu tiền sẽ bị hủy, món đã nấu xong chuyển Đã phục vụ." data-confirm-title="Kết thúc ngày bếp?" data-confirm-ok="Kết thúc ngày">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-moon-stars me-1"></i>Kết thúc ngày bếp</button>
            </form>
        }
    </div>
    <p class="small text-muted">Món của ngày trước được hệ thống tự đóng sổ lúc qua ngày mới, không còn treo trên màn hình bếp.</p>

    @if (cancelled.Count > 0)
    {
        <div class="kds-cancel p-3 mb-3" role="alert">
            <div class="fw-bold text-danger mb-2"><i class="bi bi-x-octagon-fill me-1"></i>KHÁCH ĐÃ HỦY — DỪNG CHẾ BIẾN</div>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var c in cancelled)
                {
                    <span class="badge bg-danger fs-6 fw-semibold">@c.Ban · @c.Mon (@c.Size) x@c.SoLuong · hủy lúc @c.ThoiDiemGoi.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm")</span>
                }
            </div>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-muted mb-3"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <h5 class="text-muted">Không có món nào trong danh sách hiện tại.</h5>
                <p class="small text-muted mb-0">Tất cả các món đã được xử lý hoặc chưa có yêu cầu gọi món mới.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var (item, index) in Model.Select((x, i) => (x, i + 1)))
            {
                var style = TrangThaiStyle(item.TrangThai);
                var thoiDiem = item.ThoiDiemGoi.ToOffset(TimeSpan.FromHours(7));
                <div class="col-sm-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100 kds-card" style="border-left: 4px solid @style.Border !important;">
                        <div class="card-body d-flex flex-column gap-2">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="d-flex align-items-center gap-2"><span class="kds-seq" title="Thứ tự chế biến">#@index</span><div class="kds-ban">@item.Ban</div></div>
                                <div class="text-end">
                                    <span class="badge" style="background-color: @style.Color;">@style.Label</span>
                                    @if (item.GoiThem) { <div><span class="badge bg-danger mt-1"><i class="bi bi-plus-circle me-1"></i>Gọi thêm</span></div> }
                                </div>
                            </div>
                            <div class="kds-meta">
                                <i class="bi bi-calendar3 me-1"></i>@thoiDiem.ToString("dd/MM/yyyy")
                                <span class="mx-1">•</span>
                                <i class="bi bi-clock me-1"></i>Giờ gọi @thoiDiem.ToString("HH:mm")
                            </div>
                            <div>
                                <div class="kds-mon">@item.Mon</div>
                                <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                                    <span class="badge bg-light text-dark border">Size: @item.Size</span>
                                    <span class="kds-sl">x @item.SoLuong đĩa</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(item.GhiChu))
                            {
                                <div class="kds-note">
                                    <i class="bi bi-exclamation-triangle me-1"></i>@item.GhiChu
                                </div>
                            }
                            <form asp-action="CapNhat" method="post" class="mt-auto pt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="filter" value="@currentFilter" />

                                @if (item.TrangThai == TrangThaiCheBien.ChoCheBien)
                                {
                                    <input type="hidden" name="trangThai" value="@TrangThaiCheBien.DangCheBien" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning w-100">
                                        <i class="bi bi-fire me-1"></i> Bắt đầu nấu
                                    </button>
                                }
                                else if (item.TrangThai == TrangThaiCheBien.DangCheBien)
                                {
                                    <input type="hidden" name="trangThai" value="@TrangThaiCheBien.SanSang" />
                                    <button type="submit" class="btn btn-sm btn-success w-100">
                                        <i class="bi bi-check2 me-1"></i> Nấu xong
                                    </button>
                                }
                                else if (item.TrangThai == TrangThaiCheBien.SanSang)
                                {
                                    <input type="hidden" name="trangThai" value="@TrangThaiCheBien.DaPhucVu" />
                                    <button type="submit" class="btn btn-sm btn-primary w-100">
                                        <i class="bi bi-bag-check me-1"></i> Đã phục vụ ra bàn
                                    </button>
                                }
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script type="application/json" id="kds-state">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { items = Model.Select(x => new { x.Id, Status = (int)x.TrangThai, x.ThoiDiemGoi }), cancelled = cancelled.Select(x => x.Id).Order() }, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))</script>

@section Scripts {
    <script>
        (() => {
            const state = document.getElementById('kds-state');
            const status = document.getElementById('kds-live-status');
            if (!state || !status) return;
            let current = JSON.stringify(JSON.parse(state.textContent));
            const url = '@Html.Raw(Url.Action("Snapshot", new { filter = currentFilter }))';
            window.setInterval(async () => {
                if (document.visibilityState !== 'visible' || document.querySelector('form[aria-busy="true"]')) return;
                try {
                    const response = await fetch(url, { credentials: 'same-origin', headers: { Accept: 'application/json' } });
                    if (!response.ok) throw new Error('snapshot');
                    const next = JSON.stringify(await response.json());
                    if (next !== current) window.location.reload();
                    else status.textContent = `Đã đồng bộ lúc ${new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' })}.`;
                } catch {
                    status.textContent = 'Mất kết nối cập nhật. Trạng thái có thể chưa mới nhất.';
                }
            }, 5000);
        })();
    </script>
}
