@model NguyenLieuIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kho nguyên liệu";
    var p = Model.Pagination;
}
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><h2 class="h3 mb-1">Kho nguyên liệu</h2><p class="text-muted mb-0">Tồn kho tính từ phiếu nhập và phiếu xuất đã ghi sổ.</p></div>
        <a asp-action="Create" class="btn btn-primary btn-brand-primary">+ Thêm nguyên liệu</a>
    </div>
    <partial name="_ManagementMessages" />
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body">Tổng nguyên liệu<strong class="d-block fs-3">@Model.TotalCount</strong></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body">Đang sử dụng<strong class="d-block fs-3 text-success">@Model.ActiveCount</strong></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body">Ngừng sử dụng<strong class="d-block fs-3 text-secondary">@Model.InactiveCount</strong></div></div></div>
    </div>
    <form asp-action="Index" method="get" class="card border-0 shadow-sm mb-4">
        <div class="card-body row g-3 align-items-end">
            <div class="col-md-4"><label for="search" class="form-label">Tên nguyên liệu</label><input id="search" name="search" value="@p.Search" class="form-control" /></div>
            <div class="col-md-3"><label for="donViTinh" class="form-label">Đơn vị tính</label><select id="donViTinh" name="donViTinh" class="form-select">
                <option value="">Tất cả đơn vị</option>
                @foreach (var unit in Model.DonViTinhList) { <option value="@unit" selected="@(Model.DonViTinh == unit)">@unit</option> }
            </select></div>
            <div class="col-md-3"><label for="trangThai" class="form-label">Trạng thái</label><select id="trangThai" name="trangThai" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="dang-su-dung" selected="@(p.TrangThai == "dang-su-dung")">Đang sử dụng</option>
                <option value="ngung-su-dung" selected="@(p.TrangThai == "ngung-su-dung")">Ngừng sử dụng</option>
            </select></div>
            <div class="col-md-2 d-flex gap-2"><button class="btn btn-primary" type="submit">Lọc</button><a asp-action="Index" class="btn btn-outline-secondary">Bỏ lọc</a></div>
        </div>
    </form>
    <div class="card border-0 shadow-sm">
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Mã</th><th>Nguyên liệu</th><th>Đơn vị</th><th>Tồn kho</th><th>Ngưỡng cảnh báo</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @if (!Model.Items.Any()) { <tr><td colspan="7" class="text-center text-muted py-5">Không tìm thấy nguyên liệu phù hợp.</td></tr> }
            @foreach (var row in Model.Items)
            {
                var item = row.Item;
                <tr>
                    <td>NL@(item.Id.ToString("D3"))</td><td class="fw-medium">@item.TenNguyenLieu</td><td>@item.DonViTinh</td>
                    <td><span class="@(item.DangSuDung && row.TonKho <= item.NguongCanhBao ? "text-danger fw-bold" : "")">@row.TonKho.ToString("0.######")</span>
                    @if (item.DangSuDung && row.TonKho <= item.NguongCanhBao) { <small class="d-block text-danger">Cần bổ sung</small> }</td>
                    <td>@item.NguongCanhBao.ToString("0.######")</td>
                    <td><span class="badge @(item.DangSuDung ? "bg-success" : "bg-secondary")">@(item.DangSuDung ? "Đang sử dụng" : "Ngừng sử dụng")</span></td>
                    <td class="text-end text-nowrap"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a></td>
                </tr>
            }
            </tbody>
        </table></div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <span class="text-muted">@p.TotalItems kết quả · Trang @p.CurrentPage / @p.TotalPages</span>
            <div class="d-flex gap-2">
                @if (p.CurrentPage > 1) { <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-page="@(p.CurrentPage - 1)" asp-route-search="@p.Search" asp-route-trangThai="@p.TrangThai" asp-route-donViTinh="@Model.DonViTinh">Trước</a> }
                @if (p.CurrentPage < p.TotalPages) { <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-page="@(p.CurrentPage + 1)" asp-route-search="@p.Search" asp-route-trangThai="@p.TrangThai" asp-route-donViTinh="@Model.DonViTinh">Sau</a> }
            </div>
        </div>
    </div>
</div>
