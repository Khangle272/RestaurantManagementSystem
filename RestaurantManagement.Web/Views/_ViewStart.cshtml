@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    Layout = (controller == "Account" && action != "Index" && action != "ChangePassword")
        || User.Identity?.IsAuthenticated != true || User.IsInRole("KhachHang")
        ? "_Layout" : "_AdminLayout";
}
