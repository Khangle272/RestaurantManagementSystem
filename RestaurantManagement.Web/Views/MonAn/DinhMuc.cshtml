@using RestaurantManagement.Web.Controllers
@model DinhMucTheoSizeVM
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Định mức (BOM): {Model.TenMon}";
    var bomSplit = new BomSplitViewModel
    {
        BaseName = "DinhMucItems",
        SizeName = "Sizes",
        SizeItemsName = "Items",
        SizeIdName = "MonAnSizeId",
        Admin = User.IsInRole("Admin"),
        ChoPhepSuaSize = false,
        HienTrangThaiSize = false,
        LaThucUong = Model.LaThucUong,
        BaseItems = Model.DinhMucItems.Select(x => new BomSplitItemViewModel { NguyenLieuId = x.NguyenLieuId, SoLuong = x.SoLuong }).ToList(),
        Sizes = Model.Sizes.Select(x => new BomSplitSizeViewModel
        {
            Id = x.MonAnSizeId, TenSize = x.TenSize, GiaBan = x.GiaBan, DangSuDung = x.DangSuDung,
            HeSoTyLe = x.HeSoTyLe, GhiChuThanhPhanKhacBiet = x.GhiChuThanhPhanKhacBiet,
            Items = x.Items.Select(i => new BomSplitItemViewModel { NguyenLieuId = i.NguyenLieuId, SoLuong = i.SoLuong }).ToList()
        }).ToList(),
        NguyenLieuList = Model.AllIngredients
    };
}

<div class="container-fluid py-4">
    <div class="mb-3">
        <a asp-action="Edit" asp-route-id="@Model.MonAnId" class="text-muted text-decoration-none small">
            <i class="bi bi-arrow-left me-1"></i> Quay lại thông tin món ăn
        </a>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-heading mb-1">
                <i class="bi bi-diagram-3 text-danger me-2"></i>Định mức nguyên liệu theo kích cỡ (BOM): @Model.TenMon
            </h1>
            <p class="text-muted mb-0">
                Khai báo định lượng nguyên thủy một lần; mỗi size nhân theo hệ số tỷ lệ riêng, kèm nguyên liệu phụ và ghi chú khác biệt. Kho tự động trừ theo đúng size khi phục vụ.
            </p>
        </div>
        <a asp-action="Edit" asp-route-id="@Model.MonAnId" class="btn btn-brand-outline">
            <i class="bi bi-pencil me-1"></i> Sửa thông tin món
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4 bg-light-subtle">
        <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-primary px-3 py-2 fs-6">Danh mục: @Model.TenDanhMuc</span>
                <span class="badge bg-secondary px-3 py-2 fs-6">Loại món: @Model.Loai</span>
                <span class="badge bg-info text-dark px-3 py-2 fs-6">@Model.Sizes.Count kích cỡ khả dụng</span>
            </div>
            <div class="small text-muted">
                <i class="bi bi-info-circle me-1 text-primary"></i>
                Khi khách nhận bàn có món đặt trước hoặc gọi món mới, kho sẽ tự động trừ theo đúng size được cấu hình tại đây.
            </div>
        </div>
    </div>

    <form asp-action="SaveDinhMucTheoSize" method="post" id="formDinhMuc">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MonAnId" />
        <input type="hidden" asp-for="TenMon" />
        <input type="hidden" asp-for="TenDanhMuc" />
        <input type="hidden" asp-for="Loai" />

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">
                <partial name="_BomSplit" model="bomSplit" />
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mb-5">
            <a asp-action="Edit" asp-route-id="@Model.MonAnId" class="btn btn-brand-outline">Hủy bỏ</a>
            <button type="submit" class="btn btn-brand-primary btn-lg shadow-sm" id="btnSaveBOM">
                <i class="bi bi-check2-circle me-1"></i> Lưu Toàn Bộ Định Mức
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/bom-split.js" asp-append-version="true"></script>
}
