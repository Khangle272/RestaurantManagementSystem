@model RestaurantManagement.Web.Models.BaoCaoMonBanChayViewModel
@{
    ViewData["Title"] = "Món bán chạy";
    ViewData["ActiveMenu"] = "BaoCaoMonBanChay";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Món bán chạy & doanh số</h1>
        <p class="text-muted mb-0">Phân tích món ăn được ưa chuộng nhất, số lượng tiêu thụ, doanh số đóng góp và cơ cấu theo danh mục.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="XuatMonBanChayCsv" asp-route-tuNgay="@Model.TuNgay.ToString("yyyy-MM-dd")" asp-route-denNgay="@Model.DenNgay.ToString("yyyy-MM-dd")" asp-route-danhMucId="@Model.DanhMucId" asp-route-topN="@Model.TopN" class="btn btn-outline-success d-inline-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-file-earmark-excel"></i> Xuất file CSV
        </a>
        <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-1 shadow-sm" onclick="window.print()">
            <i class="bi bi-printer"></i> In báo cáo
        </button>
    </div>
</div>

<!-- Bộ lọc -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto"><span class="small fw-semibold text-muted">Từ ngày:</span></div>
            <div class="col-md-2">
                <input type="date" name="tuNgay" value="@Model.TuNgay.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-auto"><span class="small fw-semibold text-muted">Đến ngày:</span></div>
            <div class="col-md-2">
                <input type="date" name="denNgay" value="@Model.DenNgay.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <select name="danhMucId" class="form-select form-select-sm">
                    <option value="">-- Tất cả danh mục món --</option>
                    @foreach (var dm in Model.DanhMucOptions)
                    {
                        <option value="@dm.Id" selected="@(Model.DanhMucId == dm.Id)">@dm.TenDanhMuc</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="topN" class="form-select form-select-sm">
                    <option value="5" selected="@(Model.TopN == 5)">Top 5 món</option>
                    <option value="10" selected="@(Model.TopN == 10)">Top 10 món</option>
                    <option value="20" selected="@(Model.TopN == 20)">Top 20 món</option>
                    <option value="50" selected="@(Model.TopN == 50)">Top 50 món</option>
                </select>
            </div>
            <div class="col-auto d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary">Lọc</button>
                <a asp-action="MonBanChay" class="btn btn-sm btn-light">Đặt lại</a>
            </div>
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Tổng doanh thu món ăn</span>
                    <div class="fs-3 fw-bold text-success">@Model.TongDoanhThuMon.ToString("N0") đ</div>
                </div>
                <span class="badge bg-success-subtle text-success p-3 rounded-circle"><i class="bi bi-cash fs-4"></i></span>
            </div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Tổng số phần ăn đã phục vụ</span>
                    <div class="fs-3 fw-bold text-primary">@Model.TongSoLuongMonDaBan.ToString("N0") phần</div>
                </div>
                <span class="badge bg-primary-subtle text-primary p-3 rounded-circle"><i class="bi bi-egg-fried fs-4"></i></span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Biểu đồ Top món bán chạy -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-bar-chart me-1 text-primary"></i> Top @Model.TopN món có số lượng bán cao nhất</h2>
            </div>
            <div class="card-body p-3">
                <canvas id="dishBarChart" style="max-height: 320px; width: 100%;"></canvas>
            </div>
        </div>
    </div>

    <!-- Biểu đồ cơ cấu danh mục -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-pie-chart me-1 text-primary"></i> Cơ cấu doanh thu theo Danh mục</h2>
            </div>
            <div class="card-body p-3 d-flex flex-column justify-content-center">
                <canvas id="categoryPieChart" style="max-height: 220px;"></canvas>
                <div class="mt-3 small overflow-auto" style="max-height: 120px;">
                    @foreach (var c in Model.CoCauDanhMuc)
                    {
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span>@c.TenDanhMuc (@c.SoLuongBan phần):</span>
                            <strong>@c.DoanhThu.ToString("N0") đ (@c.TyTrong%)</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bảng xếp hạng chi tiết -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-trophy me-1 text-warning"></i> Bảng xếp hạng chi tiết món ăn</h2>
        <span class="badge bg-light text-dark border">@Model.DanhSachMon.Count món</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th style="width: 60px;" class="text-center">Hạng</th>
                    <th>Món ăn</th>
                    <th>Danh mục</th>
                    <th>Size phổ biến</th>
                    <th class="text-end">Số lượng đã bán</th>
                    <th class="text-end">Doanh số đóng góp</th>
                    <th class="text-end" style="width: 140px;">Tỷ trọng</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DanhSachMon.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">Chưa ghi nhận món ăn bán ra trong khoảng thời gian này.</td>
                    </tr>
                }
                @{ int rank = 1; }
                @foreach (var item in Model.DanhSachMon)
                {
                    var medal = rank switch
                    {
                        1 => "🥇",
                        2 => "🥈",
                        3 => "🥉",
                        _ => rank.ToString()
                    };

                    <tr>
                        <td class="text-center fs-5 fw-bold text-muted">@medal</td>
                        <td>
                            <div class="fw-bold text-dark">@item.TenMon</div>
                        </td>
                        <td><span class="badge bg-light text-secondary border">@item.TenDanhMuc</span></td>
                        <td><span class="badge bg-light text-dark border">@item.SizePhoBien</span></td>
                        <td class="text-end fw-bold fs-6">@item.SoLuongDaBan.ToString("N0")</td>
                        <td class="text-end fw-semibold text-success">@item.DoanhThuMangLai.ToString("N0") đ</td>
                        <td class="text-end">
                            <div class="small fw-bold text-primary mb-1">@item.TyTrongDoanhThu%</div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-primary" style="width: @item.TyTrongDoanhThu%;"></div>
                            </div>
                        </td>
                    </tr>
                    rank++;
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const dishNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DanhSachMon.Select(x => x.TenMon)));
    const dishQuantities = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DanhSachMon.Select(x => x.SoLuongDaBan)));

    new Chart(document.getElementById('dishBarChart'), {
        type: 'bar',
        data: {
            labels: dishNames,
            datasets: [{
                label: 'Số lượng đã bán',
                data: dishQuantities,
                backgroundColor: '#3B82F6',
                borderRadius: 4
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                x: { beginAtZero: true }
            }
        }
    });

    const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CoCauDanhMuc.Select(x => x.TenDanhMuc)));
    const catRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CoCauDanhMuc.Select(x => x.DoanhThu)));

    new Chart(document.getElementById('categoryPieChart'), {
        type: 'pie',
        data: {
            labels: catLabels,
            datasets: [{
                data: catRevenues,
                backgroundColor: ['#10B981', '#3B82F6', '#F59E0B', '#EF4444', '#8B5CF6', '#EC4899', '#6B7280']
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
</script>
}
