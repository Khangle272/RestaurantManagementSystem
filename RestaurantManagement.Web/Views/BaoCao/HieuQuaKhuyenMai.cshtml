@model RestaurantManagement.Web.Models.BaoCaoHieuQuaKhuyenMaiViewModel
@using RestaurantManagement.API.Models
@{
    ViewData["Title"] = "Hiệu quả khuyến mãi & voucher";
    ViewData["ActiveMenu"] = "BaoCaoKhuyenMai";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Hiệu quả khuyến mãi & voucher</h1>
        <p class="text-muted mb-0">Thống kê ưu đãi thực tế đã chốt trên hóa đơn, theo ngày thanh toán (giờ Việt Nam).</p>
        <p class="small text-muted mb-0">Giảm thủ công đã ghi nhận: @Model.TongGiamThuCong.ToString("N0") đ, không gán cho chương trình. Bill có nhiều ưu đãi có thể xuất hiện ở nhiều dòng; tổng bill đếm một lần. Chỉ số doanh thu/giảm không phải lợi nhuận hay ROI đầu tư.</p>
        @if (Model.SoHoaDonThieuLichSu > 0)
        {
            <div class="alert alert-warning mt-2">@Model.SoHoaDonThieuLichSu hóa đơn cũ có giảm giá nhưng thiếu lịch sử chương trình. Không phân bổ đoán vào khuyến mãi; số tiền gốc của bill vẫn được giữ nguyên.</div>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-action="XuatHieuQuaKhuyenMaiCsv" asp-route-tuNgay="@Model.TuNgay.ToString("yyyy-MM-dd")" asp-route-denNgay="@Model.DenNgay.ToString("yyyy-MM-dd")" class="btn btn-outline-success d-inline-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-file-earmark-excel"></i> Xuất file CSV
        </a>
        <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-1 shadow-sm" onclick="window.print()">
            <i class="bi bi-printer"></i> In báo cáo
        </button>
    </div>
</div>

<!-- Lọc ngày -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto"><span class="small fw-semibold text-muted"><i class="bi bi-calendar3 me-1"></i> Khoảng thời gian:</span></div>
            <div class="col-md-3">
                <input type="date" name="tuNgay" value="@Model.TuNgay.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-auto text-muted">đến</div>
            <div class="col-md-3">
                <input type="date" name="denNgay" value="@Model.DenNgay.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Lọc số liệu</button>
                <a asp-action="HieuQuaKhuyenMai" class="btn btn-sm btn-light">Đặt lại (30 ngày)</a>
            </div>
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Tổng chi phí chiết khấu</span>
                <div class="fs-3 fw-bold text-danger my-1">@Model.TongChiPhiKhuyenMai.ToString("N0") đ</div>
                <div class="small text-muted">Ngân sách đã giảm cho khách</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Doanh thu mang lại</span>
                <div class="fs-3 fw-bold text-success my-1">@Model.TongDoanhThuDonKhuyenMai.ToString("N0") đ</div>
                <div class="small text-muted">Từ @Model.SoDonApDungKhuyenMai đơn có ưu đãi</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Tỷ lệ giảm bình quân</span>
                <div class="fs-3 fw-bold text-primary my-1">@Model.TyLeChietKhauTrungBinh.ToString("0.##")%</div>
                <div class="small text-muted">% giảm giá trên tổng tiền bill</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Doanh thu bill / tiền giảm</span>
                <div class="fs-3 fw-bold text-warning my-1">@Model.TySuatHieuQuaROI.ToString("0.##")x</div>
                <div class="small text-muted">Doanh thu tạo ra / Chi phí giảm</div>
            </div>
        </div>
    </div>
</div>

<!-- Biểu đồ so sánh -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-bar-chart-steps me-1 text-primary"></i> So sánh Doanh thu mang lại vs Chi phí chiết khấu theo từng chương trình</h2>
    </div>
    <div class="card-body p-3">
        <canvas id="promoComparisonChart" style="max-height: 280px; width: 100%;"></canvas>
    </div>
</div>

<!-- Bảng chi tiết hiệu quả từng chương trình -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-table me-1 text-secondary"></i> Bảng phân tích chi tiết hiệu quả ưu đãi</h2>
        <span class="badge bg-light text-dark border">@Model.DanhSachChuongTrinh.Count chương trình</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Chương trình / Ưu đãi</th>
                    <th>Hình thức</th>
                    <th class="text-center">Yêu cầu Voucher</th>
                    <th class="text-center">Số lượt dùng</th>
                    <th class="text-end text-danger">Tổng tiền giảm</th>
                    <th class="text-end text-success">Doanh thu thu về</th>
                    <th class="text-end">Tỷ lệ giảm</th>
                    <th class="text-center">Doanh thu / giảm</th>
                    <th>Đánh giá hiệu quả</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DanhSachChuongTrinh.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-5">Chưa có chương trình khuyến mãi nào được cấu hình.</td>
                    </tr>
                }
                @foreach (var item in Model.DanhSachChuongTrinh)
                {
                    var uuDai = item.KieuGiam == KieuGiam.PhanTram ? $"{item.GiaTri:0.##}%" : $"{item.GiaTri:N0} đ";
                    var phamVi = item.PhamVi == PhamViUuDai.MonAn ? "Theo món" : "Toàn bill";

                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@item.TenChuongTrinh</div>
                            <div class="small text-muted">@phamVi · @uuDai</div>
                        </td>
                        <td>
                            <span class="badge @(item.KieuGiam == KieuGiam.PhanTram ? "bg-info-subtle text-info" : "bg-primary-subtle text-primary") border">
                                @(item.KieuGiam == KieuGiam.PhanTram ? "Phần trăm" : "Cố định")
                            </span>
                        </td>
                        <td class="text-center">
                            @if (item.CanVoucher)
                            {
                                <span class="badge bg-light text-dark border"><i class="bi bi-ticket-perforated text-primary me-1"></i>Voucher</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-success border"><i class="bi bi-lightning text-success me-1"></i>Tự động</span>
                            }
                        </td>
                        <td class="text-center fw-bold fs-6">@item.SoLuotApDung</td>
                        <td class="text-end fw-semibold text-danger">-@item.TongTienGiam.ToString("N0") đ</td>
                        <td class="text-end fw-bold text-success fs-6">@item.DoanhThuMangLai.ToString("N0") đ</td>
                        <td class="text-end small">@item.TyLeGiamTrungBinh.ToString("0.##")%</td>
                        <td class="text-center">
                            <span class="fw-bold @(item.ChiSoROI >= 4 ? "text-success" : item.ChiSoROI >= 2 ? "text-primary" : "text-danger")">
                                @item.ChiSoROI.ToString("0.##")x
                            </span>
                        </td>
                        <td>
                            <span class="small fw-semibold">@item.DanhGiaHieuQua</span>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold border-top">
                <tr>
                    <td colspan="4" class="text-end">TỔNG CỘNG:</td>
                    <td class="text-end text-danger">-@Model.TongChiPhiKhuyenMai.ToString("N0") đ</td>
                    <td class="text-end text-success fs-6">@Model.TongDoanhThuDonKhuyenMai.ToString("N0") đ</td>
                    <td class="text-end small">@Model.TyLeChietKhauTrungBinh.ToString("0.##")%</td>
                    <td class="text-center">@Model.TySuatHieuQuaROI.ToString("0.##")x</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const promoNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DanhSachChuongTrinh.Select(x => x.TenChuongTrinh)));
    const revenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DanhSachChuongTrinh.Select(x => x.DoanhThuMangLai)));
    const discountData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DanhSachChuongTrinh.Select(x => x.TongTienGiam)));

    new Chart(document.getElementById('promoComparisonChart'), {
        type: 'bar',
        data: {
            labels: promoNames,
            datasets: [
                {
                    label: 'Doanh thu mang lại (đ)',
                    data: revenueData,
                    backgroundColor: '#10B981',
                    borderRadius: 4
                },
                {
                    label: 'Chi phí chiết khấu (đ)',
                    data: discountData,
                    backgroundColor: '#EF4444',
                    borderRadius: 4
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(v) { return (v/1000).toLocaleString() + 'k'; }
                    }
                }
            }
        }
    });
</script>
}
