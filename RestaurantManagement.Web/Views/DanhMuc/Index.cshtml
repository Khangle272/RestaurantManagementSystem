@using RestaurantManagement.API.Models
@model PagedListViewModel<DanhMuc>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h3 mb-1">@ViewData["Title"]</h2>
            <p class="text-muted mb-0">Phân loại món ăn và quản lý danh mục đang sử dụng.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-brand-primary">+ Thêm danh mục</a>
    </div>
    <partial name="_ManagementMessages" />
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="search" class="form-label">Tìm kiếm</label>
                    <input id="search" name="search" value="@Model.Pagination.Search" class="form-control" placeholder="Tìm theo tên danh mục" />
                </div>
                <div class="col-md-3">
                    <label for="trangThai" class="form-label">Trạng thái</label>
                    <select id="trangThai" name="trangThai" class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        <option value="true" selected="@(Model.Pagination.TrangThai == "true")">Đang sử dụng</option>
                        <option value="false" selected="@(Model.Pagination.TrangThai == "false")">Ngừng sử dụng</option>
                    </select>
                </div>
                <div class="col-md-5 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Lọc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Bỏ lọc</a>
                </div>
            </form>
        </div>
    </div>
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Tên danh mục</th>
                        <th scope="col">Mô tả</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-5">Không tìm thấy danh mục phù hợp.</td></tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-medium">@item.TenDanhMuc</td>
                            <td class="text-break">@item.MoTa</td>
                            <td><span class="badge @(item.DangSuDung ? "bg-success" : "bg-secondary")">@(item.DangSuDung ? "Đang sử dụng" : "Ngừng sử dụng")</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_ManagementPagination" model="Model.Pagination" />
    </div>
</div>

