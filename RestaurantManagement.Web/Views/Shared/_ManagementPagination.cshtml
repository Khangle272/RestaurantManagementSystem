@model PaginationViewModel
<div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-3 py-3">
    <span class="text-muted">@Model.TotalItems bản ghi · Trang @Model.CurrentPage / @Model.TotalPages</span>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Phân trang">
            <ul class="pagination mb-0">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search" asp-route-trangThai="@Model.TrangThai" asp-route-khuVucId="@Model.KhuVucId">Trước</a></li>
                }
                @for (var pageNumber = Math.Max(1, Model.CurrentPage - 2); pageNumber <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@pageNumber" asp-route-search="@Model.Search" asp-route-trangThai="@Model.TrangThai" asp-route-khuVucId="@Model.KhuVucId" aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
                    </li>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search" asp-route-trangThai="@Model.TrangThai" asp-route-khuVucId="@Model.KhuVucId">Sau</a></li>
                }
            </ul>
        </nav>
    }
</div>
