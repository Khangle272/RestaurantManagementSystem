@model RestaurantManagement.Web.Models.BaoCaoDoanhThuViewModel
@using RestaurantManagement.API.Models
@using RestaurantManagement.Web.Services
@using RestaurantManagement.Shared
@{
    ViewData["Title"] = "Báo cáo doanh thu & đơn hàng";
    ViewData["ActiveMenu"] = "BaoCaoDoanhThu";
    string Money(decimal value) => value.ToString("N0") + " đ";
}

<div class="page-header">
    <div>
        <h1 class="h3">Báo cáo doanh thu & đơn hàng</h1>
        <p class="text-muted mb-0">Doanh thu tiền món sau giảm giá theo ngày thanh toán (giờ Việt Nam). Cọc là tiền đã nhận, không phải giảm giá.</p>
        <p class="small text-muted mb-0">Tiền mặt/chuyển khoản/thẻ là tiền thực thu theo Chi tiết thanh toán (gồm cả tiền cọc nhận trước, trừ hoàn cọc) nên có thể chênh với doanh thu hóa đơn khi cọc nhận ở ngày khác. Đơn tạo và đơn đã hủy đếm theo ngày lập trong kỳ.</p>
        @if (Model.SoHoaDonThieuNgayThanhToan > 0)
        {
            <div class="alert alert-warning mt-2">Có @Model.SoHoaDonThieuNgayThanhToan hóa đơn cũ chưa lưu ngày thanh toán; tạm thống kê theo ngày lập, không sửa dữ liệu gốc.</div>
        }
    </div>
    <div class="page-actions">
        <a asp-action="XuatDoanhThuCsv" asp-route-cheDo="@Model.CheDo" asp-route-tuNgay="@Model.TuNgay.ToString("yyyy-MM-dd")" asp-route-denNgay="@Model.DenNgay.ToString("yyyy-MM-dd")" asp-route-nam="@Model.Nam" class="btn btn-outline-success d-inline-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-file-earmark-excel"></i> Xuất file CSV
        </a>
        <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-1 shadow-sm" onclick="window.print()">
            <i class="bi bi-printer"></i> In báo cáo
        </button>
    </div>
</div>

<!-- Bộ lọc chế độ xem -->
<div class="toolbar">
    <nav class="segmented" id="viewModeTabs" aria-label="Chế độ xem báo cáo">
                <a class="@(Model.CheDo == "TheoNgay" ? "active" : "")" asp-action="DoanhThu" asp-route-cheDo="TheoNgay" asp-route-tuNgay="@Model.TuNgay.ToString("yyyy-MM-dd")" asp-route-denNgay="@Model.DenNgay.ToString("yyyy-MM-dd")">
                    Theo ngày
                </a>
                <a class="@(Model.CheDo == "TheoThang" ? "active" : "")" asp-action="DoanhThu" asp-route-cheDo="TheoThang" asp-route-nam="@Model.Nam">
                    Theo tháng
                </a>
                <a class="@(Model.CheDo == "TheoNam" ? "active" : "")" asp-action="DoanhThu" asp-route-cheDo="TheoNam" asp-route-nam="@Model.Nam">
                    Theo năm
                </a>
        
    </nav>
</div>
<form method="get" class="filter-bar">
    <input type="hidden" name="cheDo" value="@Model.CheDo" />
    @if (Model.CheDo == "TheoNgay")
    {
        <div class="filter-field"><label class="form-label" for="filter-from">Từ ngày</label><input id="filter-from" type="date" name="tuNgay" value="@Model.TuNgay.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="filter-field"><label class="form-label" for="filter-to">Đến ngày</label><input id="filter-to" type="date" name="denNgay" value="@Model.DenNgay.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="filter-actions"><button type="submit" class="btn btn-primary">Áp dụng</button><a asp-action="DoanhThu" asp-route-cheDo="TheoNgay" class="btn btn-outline-secondary">30 ngày qua</a></div>
    }
    else
    {
        <div class="filter-field"><label class="form-label" for="filter-year">Năm xem</label><select id="filter-year" name="nam" class="form-select" onchange="this.form.submit()">
            @for (int y = RestaurantManagement.Web.Services.TableService.VietnamNow.Date.Year; y >= RestaurantManagement.Web.Services.TableService.VietnamNow.Date.Year - 5; y--)
            {
                <option value="@y" selected="@(Model.Nam == y)">@y</option>
            }
        </select></div>
        <div class="filter-actions"><button type="submit" class="btn btn-primary">Xem báo cáo</button></div>
    }
</form>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Doanh thu sau giảm giá</span>
                <div class="fs-3 fw-bold text-success my-1">@Model.TongDoanhThu.ToString("N0") đ</div>
                <div class="small text-muted">Tiền hàng: @Model.TongTienHang.ToString("N0") đ</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Đơn hàng hoàn tất</span>
                <div class="fs-3 fw-bold text-dark my-1">@Model.SoDonThanhCong <span class="fs-6 fw-normal text-muted">hóa đơn đã thanh toán</span></div>
                <div class="small text-muted">@Model.TongSoDonHang đơn tạo trong kỳ</div>
                <div class="small text-muted">Hủy: @Model.SoDonDaHuy đơn</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Chiết khấu ưu đãi</span>
                <div class="fs-3 fw-bold text-danger my-1">- @Model.TongTienGiam.ToString("N0") đ</div>
                <div class="small text-muted">Cọc cấn trừ: @Model.TongTienCocDaTru.ToString("N0") đ</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <span class="text-muted small fw-semibold text-uppercase">Bình quân / Đơn (AOV)</span>
                <div class="fs-3 fw-bold text-info my-1">@Model.GiaTriDonTrungBinh.ToString("N0") đ</div>
                <div class="small text-muted">Giá trị trung bình mỗi đơn</div>
            </div>
        </div>
    </div>
</div>

@if (Model.CheDo != "TheoNgay")
{
<div class="row g-4 mb-4">
    <!-- Biểu đồ doanh thu chính -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-bar-chart-line me-1 text-primary"></i> Biểu đồ diễn biến doanh thu (@Model.CheDo)</h2>
            </div>
            <div class="card-body p-3">
                <canvas id="mainRevenueChart" style="max-height: 300px; width: 100%;"></canvas>
            </div>
        </div>
    </div>

    <!-- Biểu đồ phân bổ loại đơn & thanh toán -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-pie-chart me-1 text-primary"></i> Cơ cấu loại đơn hàng</h2>
            </div>
            <div class="card-body p-3 d-flex flex-column justify-content-center">
                <canvas id="orderTypeChart" style="max-height: 200px;"></canvas>
                <div class="mt-3 small">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span>Tại bàn:</span>
                        <strong>@Model.DoanhThuTaiBan.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span>Mang đi:</span>
                        <strong>@Model.DoanhThuMangDi.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span>Giao hàng:</span>
                        <strong>@Model.DoanhThuGiaoHang.ToString("N0") đ</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

}
else
{
    <div class="alert alert-light border small mb-4"><i class="bi bi-info-circle me-1"></i>Biểu đồ chỉ hiển thị khi xem <strong>theo tháng / năm</strong> (dành cho quản lý). Thu ngân kết ca dùng <a asp-action="NopCa">Báo cáo nộp ca</a> để kiểm tiền mặt / chuyển khoản theo từng ca.</div>
}

<!-- Bảng chi tiết số liệu -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-table me-1 text-secondary"></i> Bảng số liệu chi tiết</h2>
        <span class="badge bg-light text-dark border">@Model.ChiTietTimeline.Count mốc ghi nhận</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Thời gian</th>
                    <th class="text-center">Đơn thành công</th>
                    <th class="text-center">Đơn hủy</th>
                    <th class="text-end">Tiền hàng</th>
                    <th class="text-end">Tiền giảm</th>
                    <th class="text-end text-success fw-bold">Doanh thu thực</th>
                    <th class="text-end">Tiền mặt</th>
                    <th class="text-end">Chuyển khoản</th>
                    <th class="text-end">Thẻ (cũ)</th>
                    @if (Model.CheDo == "TheoNgay")
                    {
                        <th class="text-end">Chi tiết</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.ChiTietTimeline.Count == 0)
                {
                    <tr>
                        <td colspan="@(Model.CheDo == "TheoNgay" ? 10 : 9)" class="text-center text-muted py-4">Chưa có phát sinh giao dịch trong kỳ này.</td>
                    </tr>
                }
                @foreach (var row in Model.ChiTietTimeline)
                {
                    <tr>
                        <td class="fw-semibold">@row.NhanThoiGian</td>
                        <td class="text-center"><span class="badge bg-success-subtle text-success">@row.SoDonThanhCong</span></td>
                        <td class="text-center">
                            @if (row.SoDonHuy > 0)
                            {
                                <span class="badge bg-danger-subtle text-danger">@row.SoDonHuy</span>
                            }
                            else
                            {
                                <span class="text-muted">0</span>
                            }
                        </td>
                        <td class="text-end">@row.TongTienHang.ToString("N0") đ</td>
                        <td class="text-end text-danger">-@row.TienGiam.ToString("N0") đ</td>
                        <td class="text-end fw-bold text-success fs-6">@row.DoanhThuThuc.ToString("N0") đ</td>
                        <td class="text-end small">@row.TienMat.ToString("N0") đ</td>
                        <td class="text-end small">@row.ChuyenKhoan.ToString("N0") đ</td>
                        <td class="text-end small">@row.The.ToString("N0") đ</td>
                        @if (Model.CheDo == "TheoNgay")
                        {
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="DoanhThu" asp-route-cheDo="TheoNgay" asp-route-tuNgay="@Model.TuNgay.ToString("yyyy-MM-dd")" asp-route-denNgay="@Model.DenNgay.ToString("yyyy-MM-dd")" asp-route-xemNgay="@row.Ngay?.ToString("yyyy-MM-dd")" asp-fragment="chi-tiet-ngay">Chi tiết</a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold border-top">
                <tr>
                    <td>TỔNG CỘNG</td>
                    <td class="text-center">@Model.SoDonThanhCong</td>
                    <td class="text-center">@Model.SoDonDaHuy</td>
                    <td class="text-end">@Model.TongTienHang.ToString("N0") đ</td>
                    <td class="text-end text-danger">-@Model.TongTienGiam.ToString("N0") đ</td>
                    <td class="text-end text-success fs-6">@Model.TongDoanhThu.ToString("N0") đ</td>
                    <td class="text-end">@Model.DoanhThuTienMat.ToString("N0") đ</td>
                    <td class="text-end">@Model.DoanhThuChuyenKhoan.ToString("N0") đ</td>
                    <td class="text-end">@Model.DoanhThuThe.ToString("N0") đ</td>
                    @if (Model.CheDo == "TheoNgay")
                    {
                        <td></td>
                    }
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@if (Model.NgayXemChiTiet is { } ngay)
{
    <div class="card border-0 shadow-sm mt-4" id="chi-tiet-ngay">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h2 class="h6 fw-bold mb-0"><i class="bi bi-receipt me-1 text-primary"></i> Chi tiết thanh toán ngày @VnTime.Ngay(ngay)</h2>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-dark border">@Model.ChiTietThanhToanNgay.Count giao dịch</span>
                <a class="btn btn-sm btn-outline-secondary" asp-action="DoanhThu" asp-route-cheDo="TheoNgay" asp-route-tuNgay="@Model.TuNgay.ToString("yyyy-MM-dd")" asp-route-denNgay="@Model.DenNgay.ToString("yyyy-MM-dd")">Đóng</a>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Giờ</th>
                        <th>Mã thanh toán</th>
                        <th>Hóa đơn / đặt bàn</th>
                        <th>Loại đơn</th>
                        <th>Loại giao dịch</th>
                        <th>Hình thức</th>
                        <th>Thu ngân</th>
                        <th class="text-end">Số tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.ChiTietThanhToanNgay)
                    {
                        <tr>
                            <td>@p.GioThanhToan.ToString("HH:mm")</td>
                            <td class="font-monospace small">@p.MaThanhToan</td>
                            <td class="small">
                                @if (p.HoaDon is not null)
                                {
                                    <a asp-controller="HoaDon" asp-action="Details" asp-route-id="@p.HoaDonId">@p.HoaDon.MaHoaDon</a>
                                }
                                @if (p.DatBan is not null)
                                {
                                    <div class="text-muted">@p.DatBan.MaDatBan · @p.DatBan.HoTenLienHe</div>
                                }
                            </td>
                            <td class="small">@(p.HoaDon is null ? (p.DatBan is null ? "—" : "Đặt bàn") : p.HoaDon.LoaiDonHang switch { LoaiDonHang.MangDi => "Mang đi", LoaiDonHang.GiaoHang => "Giao hàng", _ => "Tại bàn" })</td>
                            <td><span class="badge @(p.LoaiGiaoDich switch { LoaiGiaoDichThanhToan.DatCoc => "bg-info text-dark", LoaiGiaoDichThanhToan.ThanhToan => "bg-success", _ => "bg-danger" })">@PaymentLedger.LoaiText(p.LoaiGiaoDich)</span></td>
                            <td>@PaymentLedger.HinhThucText(p.HinhThuc)</td>
                            <td class="small">@(p.NhanVien?.HoTen ?? "—")</td>
                            <td class="text-end fw-semibold @(p.LoaiGiaoDich == LoaiGiaoDichThanhToan.HoanCoc ? "text-danger" : "")">@Money(PaymentLedger.SignedAmount(p))</td>
                        </tr>
                    }
                    @if (Model.ChiTietThanhToanNgay.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">Chưa có giao dịch thu/chi trong ngày này.</td></tr>
                    }
                </tbody>
                @if (Model.ChiTietThanhToanNgay.Count > 0)
                {
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="7">TỔNG CỘNG</td>
                            <td class="text-end">@Money(Model.ChiTietThanhToanNgay.Sum(PaymentLedger.SignedAmount))</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
}

@section Scripts {
@if (Model.CheDo != "TheoNgay")
{
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChiTietTimeline.Select(x => x.NhanThoiGian)));
    const revenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChiTietTimeline.Select(x => x.DoanhThuThuc)));
    const discountData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChiTietTimeline.Select(x => x.TienGiam)));

    new Chart(document.getElementById('mainRevenueChart'), {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Doanh thu thực thu',
                    data: revenueData,
                    backgroundColor: '#10B981',
                    borderRadius: 4
                },
                {
                    label: 'Tiền giảm giá / Voucher',
                    data: discountData,
                    backgroundColor: '#EF4444',
                    borderRadius: 4
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(v) { return (v/1000).toLocaleString('vi-VN') + 'k'; }
                    }
                }
            }
        }
    });

    new Chart(document.getElementById('orderTypeChart'), {
        type: 'doughnut',
        data: {
            labels: ['Tại bàn', 'Mang đi', 'Giao hàng'],
            datasets: [{
                data: [@Model.DoanhThuTaiBan, @Model.DoanhThuMangDi, @Model.DoanhThuGiaoHang],
                backgroundColor: ['#0284C7', '#F59E0B', '#10B981'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
</script>
}
}
