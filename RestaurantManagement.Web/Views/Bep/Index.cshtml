@model List<RestaurantManagement.Web.Controllers.BepRow>
@using RestaurantManagement.API.Models
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bếp chế biến & Điều phối";
    var currentFilter = (ViewBag.Filter as string) ?? "active";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="h3 mb-1">Màn hình Bếp (KDS) & Điều phối món</h1>
            <p class="text-muted mb-0">Theo dõi thứ tự gọi món (FIFO), chế biến theo size và điều phối phục vụ ra bàn.</p>
        </div>
        <div class="btn-group" role="group">
            <a asp-action="Index" asp-route-filter="active" class="btn btn-sm @(currentFilter == "active" ? "btn-primary" : "btn-outline-primary")">
                🔥 Đang chờ & Đang nấu
            </a>
            <a asp-action="Index" asp-route-filter="ready" class="btn btn-sm @(currentFilter == "ready" ? "btn-success" : "btn-outline-success")">
                ⚡ Đã nấu xong (Chờ mang ra)
            </a>
            <a asp-action="Index" asp-route-filter="all" class="btn btn-sm @(currentFilter == "all" ? "btn-secondary" : "btn-outline-secondary")">
                Tất cả
            </a>
        </div>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-muted mb-3"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <h5 class="text-muted">Không có món nào trong danh sách hiện tại.</h5>
                <p class="small text-muted mb-0">Tất cả các món đã được xử lý hoặc chưa có yêu cầu gọi món mới.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Thời gian gọi</th>
                            <th>Bàn / Loại đơn</th>
                            <th>Món ăn & Size</th>
                            <th class="text-center">Số lượng</th>
                            <th>Yêu cầu chế biến</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-3">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <span class="fw-semibold">@item.ThoiDiemGoi.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm:ss")</span>
                                <div class="small text-muted">@item.MaHoaDon</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">@item.Ban</span>
                            </td>
                            <td>
                                <div class="fw-bold fs-6">@item.Mon</div>
                                <span class="badge bg-secondary-subtle text-secondary border">Size: @item.Size</span>
                            </td>
                            <td class="text-center">
                                <span class="fs-5 fw-bold text-primary">@item.SoLuong</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.GhiChu))
                                {
                                    <span class="badge bg-danger-subtle text-danger p-2 fs-7 text-wrap text-start">
                                        ⚠️ @item.GhiChu
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">— Chuẩn</span>
                                }
                            </td>
                            <td>
                                @switch (item.TrangThai)
                                {
                                    case TrangThaiCheBien.ChoCheBien:
                                        <span class="badge bg-secondary">Chờ chế biến</span>
                                        break;
                                    case TrangThaiCheBien.DangCheBien:
                                        <span class="badge bg-warning text-dark">🔥 Đang nấu</span>
                                        break;
                                    case TrangThaiCheBien.SanSang:
                                        <span class="badge bg-success">⚡ Đã xong (Sẵn sàng)</span>
                                        break;
                                    case TrangThaiCheBien.DaPhucVu:
                                        <span class="badge bg-light text-success border">✓ Đã phục vụ</span>
                                        break;
                                }
                            </td>
                            <td class="text-end pe-3">
                                <form asp-action="CapNhat" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="filter" value="@currentFilter" />

                                    @if (item.TrangThai == TrangThaiCheBien.ChoCheBien)
                                    {
                                        <input type="hidden" name="trangThai" value="@TrangThaiCheBien.DangCheBien" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            🔥 Bắt đầu nấu
                                        </button>
                                    }
                                    else if (item.TrangThai == TrangThaiCheBien.DangCheBien)
                                    {
                                        <input type="hidden" name="trangThai" value="@TrangThaiCheBien.SanSang" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            ✓ Nấu xong
                                        </button>
                                    }
                                    else if (item.TrangThai == TrangThaiCheBien.SanSang)
                                    {
                                        <input type="hidden" name="trangThai" value="@TrangThaiCheBien.DaPhucVu" />
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            🍽️ Đã phục vụ ra bàn
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
