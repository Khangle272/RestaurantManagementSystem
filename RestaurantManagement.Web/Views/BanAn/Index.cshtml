@using RestaurantManagement.API.Models
@model PagedListViewModel<BanAn>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý bàn ăn";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h3 mb-1">@ViewData["Title"]</h2>
            <p class="text-muted mb-0">Quản lý bàn ăn, khu vực, số chỗ ngồi và trạng thái phục vụ.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-brand-primary">+ Thêm bàn ăn</a>
    </div>
    <partial name="_ManagementMessages" />
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="search" class="form-label">Tìm kiếm</label>
                    <input id="search" name="search" value="@Model.Pagination.Search" class="form-control" placeholder="Tìm theo mã bàn" />
                </div>
                <div class="col-md-3">
                    <label for="khuVucId" class="form-label">Khu vực</label>
                    <select id="khuVucId" name="khuVucId" class="form-select">
                        <option value="">Tất cả khu vực</option>
                        @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem area in ViewBag.KhuVucOptions)
                        {
                            <option value="@area.Value" selected="@(area.Value == Model.Pagination.KhuVucId?.ToString())">@area.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="trangThai" class="form-label">Trạng thái</label>
                    <select id="trangThai" name="trangThai" class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        @foreach (var status in Enum.GetValues<TrangThaiBan>())
                        {
                            <option value="@status" selected="@(Model.Pagination.TrangThai == status.ToString())">@BanAnLabels.TrangThai(status)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Lọc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Bỏ lọc</a>
                </div>
            </form>
        </div>
    </div>
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Mã bàn</th>
                        <th scope="col">Khu vực</th>
                        <th scope="col">Số chỗ ngồi</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-5">Không tìm thấy bàn ăn phù hợp.</td></tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-medium">@item.MaBan</td>
                            <td>@item.KhuVuc.TenKhuVuc</td>
                            <td>@item.SoChoNgoi</td>
                            <td><span class="badge @(item.TrangThai == TrangThaiBan.SanSang ? "bg-success" : "bg-secondary")">@BanAnLabels.TrangThai(item.TrangThai)</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_ManagementPagination" model="Model.Pagination" />
    </div>
</div>

