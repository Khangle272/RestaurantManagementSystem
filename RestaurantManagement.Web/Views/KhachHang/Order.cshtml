@model RestaurantManagement.API.Models.HoaDon
@using RestaurantManagement.API.Models
@using RestaurantManagement.Web.Services
@{ ViewData["Title"] = $"Đơn hàng {Model.MaHoaDon}"; var evaluation = (PromotionEvaluationResult)ViewBag.Evaluation; var wallet = (List<CustomerVoucherItem>)ViewBag.Wallet; }
<div class="d-flex justify-content-between mb-4"><div><h1 class="h3">@Model.MaHoaDon</h1><p id="order-status" aria-live="polite">@CustomerHistoryService.PaymentStatus(Model.TrangThai)</p></div><a asp-action="Index" class="btn btn-outline-secondary align-self-start">Đơn hàng của tôi</a></div>
<div id="order-closed" class="alert alert-info" hidden>Đơn hàng đã được cập nhật. <a asp-action="Order" asp-route-id="@Model.Id">Tải lại để xem số tiền và ưu đãi đã chốt.</a></div>
<p id="order-update-note" class="small text-muted" aria-live="polite">Tiến độ món tự cập nhật mỗi 15 giây khi đơn đang mở.</p>
<div class="card table-responsive mb-4"><table class="table mb-0"><thead><tr><th>Món ăn</th><th>Số lượng</th><th>Thành tiền</th><th>Tiến độ</th></tr></thead><tbody>@foreach (var item in Model.ChiTiet) { <tr><td>@item.TenMonLucBan @item.TenSizeLucBan</td><td>@item.SoLuong</td><td>@((item.SoLuong * item.DonGia).ToString("N0")) đ</td><td data-line-status="@item.Id">@CustomerHistoryService.DishStatus(item.TrangThai)</td></tr> }</tbody></table></div>
<div class="card card-body mb-4"><p>Tiền món: <strong>@evaluation.TongTienHang.ToString("N0") đ</strong></p><p>Giảm giá: <strong>@evaluation.TongTienGiam.ToString("N0") đ</strong></p><p class="mb-0">Tiền mua sau giảm: <strong>@evaluation.TongThanhToanSauGiam.ToString("N0") đ</strong></p><p class="small text-muted mt-2 mb-0">Thu ngân xác nhận số tiền còn phải trả sau cấn trừ tiền cọc.</p></div>
@if (Model.TrangThai == TrangThaiHoaDon.ChuaThanhToan) {
    <div class="card card-body mb-4"><h2 class="h5">Chọn mã giảm giá khi thanh toán</h2>
        <p class="small text-muted">Mã trong ví được kiểm tra theo món, giá trị đơn và thời hạn tại thời điểm áp dụng. <a asp-action="Vouchers">Thu thập thêm mã</a></p>
        @if (wallet.Any(x => x.CoTheDung)) {
            <form asp-action="ApplyVoucher" method="post" class="d-flex gap-2 mb-3"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="rowVersion" value="@ViewBag.RowVersion" /><select name="voucherCode" class="form-select" aria-label="Chọn voucher đã thu thập">@foreach (var v in wallet.Where(x => x.CoTheDung)) { <option value="@v.Ma">@v.Ma · @v.UuDai</option> }</select><button class="btn btn-primary text-nowrap" type="submit">Dùng mã trong ví</button></form>
        }
        <form asp-action="ApplyVoucher" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="rowVersion" value="@ViewBag.RowVersion" /><input name="voucherCode" value="@Model.Voucher?.Ma" class="form-control text-uppercase" placeholder="Hoặc nhập trực tiếp mã giảm giá" aria-label="Mã giảm giá" required maxlength="40" /><button type="submit" class="btn btn-primary text-nowrap">Áp dụng</button></form>
        @if (Model.VoucherId.HasValue) { <form asp-action="RemoveVoucher" method="post" class="mt-2"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="rowVersion" value="@ViewBag.RowVersion" /><button class="btn btn-outline-danger" type="submit">Gỡ mã @Model.Voucher?.Ma</button></form> }
        @foreach (var reason in evaluation.IneligiblePromotions) { <p class="small text-danger mt-2 mb-0">@reason.LyDoKhongDuDieuKien</p> }
    </div>
}
<a asp-action="Order" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cập nhật trạng thái đơn hàng</a>
@if (Model.TrangThai == TrangThaiHoaDon.ChuaThanhToan) {
    <div id="order-watch" data-url="@Url.Action("OrderStatus", new { id = Model.Id })"></div>
}
@section Scripts { <script src="~/js/customer-order-status.js" asp-append-version="true"></script> }
