@model DanhGiaCreateVM
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đánh giá trải nghiệm";
}

<style>
    .star-rating { display: flex; flex-direction: row-reverse; justify-content: flex-end; gap: 0.25rem; }
    .star-rating input { display: none; }
    .star-rating label { font-size: 2rem; color: #E2E8F0; cursor: pointer; transition: color 0.15s; }
    .star-rating input:checked ~ label, .star-rating label:hover, .star-rating label:hover ~ label { color: #F59E0B; }
</style>

<div class="container py-5" style="max-width: 650px;">
    <div class="card border-0 shadow-sm" style="border-radius: 16px;">
        <div class="card-body p-4 p-md-5">
            <h3 class="fw-bold text-center mb-1">⭐ Đánh giá trải nghiệm tại nhà hàng</h3>
            <p class="text-center text-muted mb-4">
                @if (Model.TenBan != null) { <span>Bàn @Model.TenBan · </span> }
                @Model.ThoiGianDen?.ToString("dd/MM/yyyy")
            </p>

            <form asp-action="DanhGia" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="MaDatBan" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Chất lượng món ăn</label>
                    <div class="star-rating">
                        @for (int i = 5; i >= 1; i--)
                        {
                            <input type="radio" name="SoSaoMonAn" value="@i" id="food-@i" @(Model.SoSaoMonAn == i ? "checked" : "") />
                            <label for="food-@i">★</label>
                        }
                    </div>
                    <span asp-validation-for="SoSaoMonAn" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Chất lượng phục vụ & Không gian</label>
                    <div class="star-rating">
                        @for (int i = 5; i >= 1; i--)
                        {
                            <input type="radio" name="SoSaoDichVu" value="@i" id="svc-@i" @(Model.SoSaoDichVu == i ? "checked" : "") />
                            <label for="svc-@i">★</label>
                        }
                    </div>
                    <span asp-validation-for="SoSaoDichVu" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="NoiDung" class="form-label fw-semibold">Nhận xét chi tiết</label>
                    <textarea asp-for="NoiDung" class="form-control" rows="4" placeholder="Chia sẻ cảm nhận chi tiết của bạn về món ăn và dịch vụ..."></textarea>
                    <span asp-validation-for="NoiDung" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="HinhAnhFile" class="form-label fw-semibold">Ảnh món ăn thực tế (tùy chọn)</label>
                    <input asp-for="HinhAnhFile" class="form-control" accept="image/*" />
                    <span asp-validation-for="HinhAnhFile" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn w-100 py-2" style="background-color: #E11D48; color: white; font-size: 1.1rem; border-radius: 8px;">Gửi đánh giá</button>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
