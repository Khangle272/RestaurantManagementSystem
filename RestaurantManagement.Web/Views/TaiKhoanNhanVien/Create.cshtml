@model CreateStaffAccountViewModel
@using RestaurantManagement.Web.Security
@{ ViewData["Title"] = "Cấp tài khoản nhân viên"; }
<a asp-controller="NhanVien" asp-action="Index" class="page-back"><i class="bi bi-arrow-left" aria-hidden="true"></i>Danh sách nhân viên</a>
<div class="page-header"><div><h1 class="h3">Cấp tài khoản nhân viên</h1><p class="text-muted">Nhân viên: @ViewBag.Employee?.HoTen. Quyền được lấy từ vai trò đã lưu trong hồ sơ, không chọn lại tại đây.</p></div></div>
<form asp-action="Create" method="post" class="card card-body form-narrow">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input asp-for="NhanVienId" type="hidden" />
    <span asp-validation-for="NhanVienId" class="text-danger"></span>
    <div class="mb-3"><label asp-for="Email" class="form-label">Email đăng nhập</label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Password" class="form-label">Mật khẩu ban đầu</label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
    <p class="small text-muted">Vai trò: @AppRoles.Label(AppRoles.RoleForJob((string?)ViewBag.Employee?.ChucVu))</p>
    <button class="btn btn-primary" type="submit">Tạo tài khoản</button>
    <a asp-controller="NhanVien" asp-action="Edit" asp-route-id="@Model.NhanVienId" class="btn btn-outline-secondary">Quay lại hồ sơ</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
