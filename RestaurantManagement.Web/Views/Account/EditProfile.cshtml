@model EditAccountViewModel
@{ ViewData["Title"] = "Sửa thông tin tài khoản"; }
<section class="account-shell">
    <h1 class="h3 mb-2">Sửa thông tin tài khoản</h1>
    <p class="text-muted">Email là tên đăng nhập. Thay đổi thông tin không thay đổi vai trò hay trạng thái khóa.</p>
    <form asp-action="EditProfile" method="post">
        <input asp-for="Id" type="hidden" />
        <input asp-for="ConcurrencyStamp" type="hidden" />
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        @if (ViewData["CanEditName"] is true)
        {
            <div class="mb-3"><label asp-for="HoTen" class="form-label">Họ tên</label><input asp-for="HoTen" class="form-control" /></div>
        }
        <div class="mb-3"><label asp-for="Email" class="form-label">Email đăng nhập</label><input asp-for="Email" class="form-control" autocomplete="username" /></div>
        <div class="mb-3"><label asp-for="SoDienThoai" class="form-label">Số điện thoại</label><input asp-for="SoDienThoai" class="form-control" autocomplete="tel" /></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Mật khẩu của bạn để xác nhận</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="current-password" /></div>
        <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Lưu thông tin</button><a asp-action="Index" class="btn btn-outline-secondary">Tài khoản của tôi</a></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
