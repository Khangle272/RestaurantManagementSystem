@{ ViewData["Title"] = "Nhà hàng"; }
<section class="home-welcome">
    <span class="account-label">Chào mừng quý khách</span>
    <h1 class="h2 mb-3">Không gian nhà hàng dành cho bạn</h1>
    <p class="text-muted">Đây là khu vực khách hàng, tách biệt với hệ thống quản lý nội bộ.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <p>Xin chào @User.Identity.Name.</p>
        <a asp-controller="Account" asp-action="Index" class="btn btn-primary">Tài khoản của tôi</a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Đăng nhập khách hàng</a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary">Tạo tài khoản khách hàng</a>
    }
</section>
<p class="text-muted small">Thông tin nhà hàng, thực đơn và chức năng đặt bàn sẽ được nhóm tích hợp tại khu vực này.</p>
