@model HomeViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Thực đơn & đặt bàn";
}
@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}
<div class="home-page">
<script type="application/json" id="customer-menu">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Menu.Concat(Model.Featured).Concat(Model.NewItems).DistinctBy(x => x.Id), new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))</script>

<section class="restaurant-hero" aria-labelledby="hero-title">
    <div class="restaurant-hero-copy">
        <span class="eyebrow eyebrow-light"><span class="eyebrow-line"></span> HƯƠNG VỊ CHO MỖI CUỘC HẸN</span>
        <h1 id="hero-title">Món ngon kết nối.<br /><em>Khoảnh khắc đong đầy.</em></h1>
        <p>Từ món quen yêu thích đến những hương vị mới. Cùng chọn một bữa ngon và dành thời gian cho những người thương.</p>
        <div class="hero-actions">
            <a class="btn btn-restaurant" href="#thuc-don">Khám phá thực đơn <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
            @if (User.Identity?.IsAuthenticated != true || User.IsInRole("KhachHang"))
            { <a class="btn btn-hero-outline" asp-controller="DatBan" asp-action="Index" asp-route-cart="new">Đặt bàn ngay</a> }
        </div>
        <div class="hero-footnote"><span class="hero-footnote-icon"><i class="bi bi-heart" aria-hidden="true"></i></span><span>Món lẻ · Thức uống · Set dùng chung<br /><strong>Một thực đơn, nhiều cách tận hưởng.</strong></span></div>
    </div>
    <div class="restaurant-hero-media">
        <img src="~/images/hero-vietnamese-table.png" alt="Hình minh họa bữa ăn Việt với món nướng, cơm và rau thơm" fetchpriority="high" />
        <div class="hero-media-caption"><span>CẢM HỨNG BỮA ĂN VIỆT</span><strong>Chút thân quen.<br />Thêm gắn kết.</strong></div>
    </div>
</section>

<div class="restaurant-intro-line" aria-label="Điểm nổi bật">
    <span><i class="bi bi-journal-text" aria-hidden="true"></i><span><strong>Chọn món theo sở thích</strong><small>Món lẻ, thức uống và set dùng chung</small></span></span>
    <span><i class="bi bi-calendar2-check" aria-hidden="true"></i><span><strong>Chủ động cuộc hẹn</strong><small>Đặt bàn theo thời gian của bạn</small></span></span>
    <span><i class="bi bi-bag-heart" aria-hidden="true"></i><span><strong>Dễ dàng chuẩn bị trước</strong><small>Chọn món yêu thích vào giỏ</small></span></span>
</div>

@if (Model.Promotions.Count > 0)
{
    <section class="restaurant-section" aria-labelledby="offers-title">
        <div class="section-heading"><div><p class="eyebrow">DÀNH CHO BẠN</p><h2 id="offers-title">Ưu đãi đang diễn ra</h2></div></div>
        <div class="offers-grid">
            @foreach (var offer in Model.Promotions)
            {
                <article class="offer-card"><span class="offer-icon"><i class="bi bi-tag" aria-hidden="true"></i></span><div><strong>@offer.Name</strong><p>@offer.Summary</p><small>Đến @offer.End.ToLocalTime().ToString("dd/MM/yyyy")</small></div></article>
            }
        </div>
    </section>
}

@if (Model.Vouchers.Count > 0)
{
    <section class="restaurant-section" aria-labelledby="vouchers-title">
        <div class="section-heading"><div><p class="eyebrow">MÃ GIẢM GIÁ</p><h2 id="vouchers-title">Săn voucher</h2></div>
            @if (User.IsInRole("KhachHang")) { <a asp-controller="KhachHang" asp-action="Vouchers">Lưu mã vào ví <i class="bi bi-arrow-right" aria-hidden="true"></i></a> }
            else if (User.Identity?.IsAuthenticated != true) { <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/KhachHang/Vouchers">Đăng nhập để lưu mã <i class="bi bi-arrow-right" aria-hidden="true"></i></a> }
        </div>
        <div class="offers-grid">
            @foreach (var offer in Model.Vouchers)
            {
                <article class="offer-card"><span class="offer-icon"><i class="bi bi-ticket-perforated" aria-hidden="true"></i></span><div><strong>@offer.Code</strong><p>@offer.Summary</p><small>@offer.Name · đến @offer.End.ToLocalTime().ToString("dd/MM/yyyy")</small></div></article>
            }
        </div>
    </section>
}
@if (Model.Featured.Count > 0)
{
    <section class="restaurant-section" aria-labelledby="featured-title">
        <div class="section-heading"><div><p class="eyebrow">GỢI Ý HÔM NAY</p><h2 id="featured-title">Món nổi bật</h2></div><a href="#thuc-don">Xem toàn bộ thực đơn <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
        <div class="menu-grid">@foreach (var item in Model.Featured) { <partial name="_MenuCard" model="item" /> }</div>
    </section>
}

@if (Model.NewItems.Count > 0)
{
    <section class="restaurant-section" aria-labelledby="new-title">
        <div class="section-heading"><div><p class="eyebrow">VỪA THÊM VÀO THỰC ĐƠN</p><h2 id="new-title">Món mới</h2></div></div>
        <div class="menu-grid">@foreach (var item in Model.NewItems) { <partial name="_MenuCard" model="item" /> }</div>
    </section>
}

<section class="restaurant-section menu-section" id="thuc-don" aria-labelledby="menu-title">
    <div class="section-heading"><div><p class="eyebrow">CHỌN MÓN BẠN YÊU THÍCH</p><h2 id="menu-title">Hôm nay, bạn muốn ăn gì?</h2><p class="section-description">Một món ngon cho riêng bạn, hay cả bàn tiệc để sẻ chia.</p></div><span class="section-count" id="menu-result-count" role="status">@Model.Menu.Count món</span></div>
    @if (Model.Menu.Count > 0)
    {
        <div class="menu-search" hidden>
            <label for="menu-search-input"><i class="bi bi-search" aria-hidden="true"></i><span class="visually-hidden">Tìm món trong danh mục đang xem</span></label>
            <input id="menu-search-input" type="search" placeholder="Tìm món trong danh mục đang xem…" autocomplete="off" aria-controls="home-menu-grid" />
        </div>
    }
    <nav class="category-list" aria-label="Lọc thực đơn theo danh mục">
        <a asp-action="Index" asp-fragment="thuc-don" class="@(Model.CategoryId == null ? "selected" : "")" aria-current="@(Model.CategoryId == null ? "page" : null)">Tất cả</a>
        @foreach (var category in Model.Categories)
        {
            <a asp-action="Index" asp-route-danhMucId="@category.Id" asp-fragment="thuc-don" class="@(Model.CategoryId == category.Id ? "selected" : "")" aria-current="@(Model.CategoryId == category.Id ? "page" : null)">@category.TenDanhMuc</a>
        }
    </nav>
    @if (Model.Menu.Count == 0)
    {
        <div class="menu-empty">
            <span class="menu-empty-icon"><i class="bi bi-journal-richtext" aria-hidden="true"></i></span>
            <h3>@(Model.CategoryId.HasValue ? "Chưa có món trong danh mục này" : "Thực đơn đang được cập nhật")</h3>
            <p>@(Model.CategoryId.HasValue ? "Hãy thử một danh mục khác để khám phá thêm món ngon." : "Nhà hàng đang chuẩn bị thông tin món ăn. Bạn có thể quay lại sau hoặc đặt bàn trước.")</p>
            @if (Model.CategoryId.HasValue) { <a asp-action="Index" asp-fragment="thuc-don" class="btn btn-outline-restaurant">Xem tất cả món</a> }
            else if (User.Identity?.IsAuthenticated != true || User.IsInRole("KhachHang"))
            { <a asp-controller="DatBan" asp-action="Index" asp-route-cart="new" class="btn btn-outline-restaurant">Đặt bàn trước</a> }
        </div>
    }
    else
    {
        <div class="menu-grid" id="home-menu-grid">@foreach (var item in Model.Menu) { <partial name="_MenuCard" model="item" /> }</div>
        <div class="menu-empty" id="menu-search-empty" hidden><span class="menu-empty-icon"><i class="bi bi-search" aria-hidden="true"></i></span><h3>Chưa tìm thấy món phù hợp</h3><p>Thử tên món khác hoặc xóa từ khóa để xem lại danh mục này.</p><button type="button" class="btn btn-outline-restaurant" id="menu-search-clear">Xóa tìm kiếm</button></div>
    }
</section>

<section class="restaurant-section steps-section" aria-labelledby="steps-title">
    <div class="section-heading"><div><p class="eyebrow">DỄ DÀNG TRONG BA BƯỚC</p><h2 id="steps-title">Từ chọn món đến bàn ăn</h2></div></div>
    <ol class="steps-grid">
        <li><span class="step-number">01</span><i class="bi bi-journal-richtext" aria-hidden="true"></i><h3>Chọn món</h3><p>Khám phá thực đơn và thêm món yêu thích vào giỏ.</p></li>
        <li><span class="step-number">02</span><i class="bi bi-calendar2-check" aria-hidden="true"></i><h3>Đặt bàn</h3><p>Chọn thời gian và số khách phù hợp với cuộc hẹn.</p></li>
        <li><span class="step-number">03</span><i class="bi bi-emoji-smile" aria-hidden="true"></i><h3>Thưởng thức</h3><p>Nhà hàng chuẩn bị sẵn bàn, bạn chỉ cần đến và tận hưởng.</p></li>
    </ol>
</section>

@if (User.Identity?.IsAuthenticated != true || User.IsInRole("KhachHang"))
{
    <section class="booking-banner"><div><p class="eyebrow eyebrow-light">HẸN GẶP BẠN TẠI NHÀ HÀNG</p><h2>Giữ chỗ cho bữa ăn sắp tới.</h2><p>Chọn thời gian phù hợp để nhà hàng chuẩn bị bàn cho bạn.</p></div><a class="btn btn-restaurant" asp-controller="DatBan" asp-action="Index" asp-route-cart="new">Đặt bàn <i class="bi bi-arrow-right" aria-hidden="true"></i></a></section>
}
</div>
@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
