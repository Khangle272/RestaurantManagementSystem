@model RestaurantManagement.Web.Models.KhuyenMaiFormViewModel
@using RestaurantManagement.API.Models
@using RestaurantManagement.Web.Models
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@{ ViewData["Title"] = Model.Id == 0 ? "Tạo chương trình khuyến mãi" : Model.TenChuongTrinh; ViewData["ActiveMenu"] = "KhuyenMai"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3">@ViewData["Title"]</h1><p class="text-muted mb-0">Một chương trình chứa nhiều mã với mức giảm và thời hạn riêng. Thời gian theo giờ Việt Nam (UTC+7).</p></div><a asp-action="Index" class="btn btn-outline-secondary">Danh sách</a></div>
<form method="post" asp-action="@(Model.Id == 0 ? "Create" : "Edit")" id="campaign-form">
    <input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" />
    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
    <div class="card card-body mb-4">
        <h2 class="h5">Thông tin chương trình</h2>
        @if (Model.Id > 0) { <p class="small text-muted">Đã phát hành / giữ trực tiếp: @Model.SoVeDaPhatHanh vé trong toàn chương trình.</p> }
        <div class="mb-3"><label asp-for="TenChuongTrinh" class="form-label">Tên chương trình</label><input asp-for="TenChuongTrinh" class="form-control" placeholder="Tháng 10 · Chào mừng 20/10" /></div>
        <div class="row g-3 mb-3">
            <div class="col-md-4"><label asp-for="BatDau" class="form-label">Bắt đầu (giờ Việt Nam)</label><input asp-for="BatDau" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" step="1" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="KetThuc" class="form-label">Kết thúc (bao gồm thời điểm này)</label><input asp-for="KetThuc" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" step="1" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="GioiHanPhatHanh" class="form-label">Tổng vé phát hành (ví + nhập mã)</label><input asp-for="GioiHanPhatHanh" class="form-control" type="number" min="1" placeholder="Để trống: không giới hạn" /></div>
        </div>
        <div class="row g-3 mb-3"><div class="col-md-6"><label asp-for="CanVoucher" class="form-label">Cách áp dụng</label><select asp-for="CanVoucher" class="form-select"><option value="true">Phát hành nhiều mã voucher</option><option value="false">Ưu đãi tự động trên hóa đơn</option></select></div><div class="col-md-3"><label asp-for="ThuTuApDung" class="form-label">Thứ tự áp dụng</label><input asp-for="ThuTuApDung" type="number" min="0" class="form-control" /></div></div>
        <div class="form-check"><input asp-for="ChoPhepKetHop" class="form-check-input" /><label asp-for="ChoPhepKetHop" class="form-check-label">Cho phép kết hợp với ưu đãi khác</label></div>
        <div class="form-check"><input asp-for="DangSuDung" class="form-check-input" /><label asp-for="DangSuDung" class="form-check-label">Kích hoạt chương trình</label></div>
    </div>
    <div id="automatic-config" class="card card-body mb-4">
        <h2 class="h5">Ưu đãi tự động</h2>
        <div class="row g-3"><div class="col-md-3"><label asp-for="PhamVi" class="form-label">Phạm vi</label><select asp-for="PhamVi" class="form-select"><option value="HoaDon">Hóa đơn</option><option value="MonAn">Món ăn</option></select></div>
        <div class="col-md-3"><label asp-for="KieuGiam" class="form-label">Kiểu giảm</label><select asp-for="KieuGiam" class="form-select"><option value="PhanTram">Phần trăm</option><option value="SoTien">Số tiền (đ)</option></select></div>
        <div class="col-md-2"><label asp-for="GiaTri" class="form-label">Giá trị giảm</label><input asp-for="GiaTri" type="number" step="0.01" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="MucGiamToiDa" class="form-label">Trần giảm (đ)</label><input asp-for="MucGiamToiDa" type="number" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="GiaTriToiThieu" class="form-label">Đơn tối thiểu (đ)</label><input asp-for="GiaTriToiThieu" type="number" class="form-control" /></div>
        <div class="col-12"><label asp-for="SelectedMonAnIds" class="form-label">Món áp dụng (giữ Ctrl để chọn nhiều)</label><select asp-for="SelectedMonAnIds" multiple class="form-select" size="5">@foreach (var dish in Model.AvailableDishes) { <option value="@dish.Id">@dish.TenMon</option> }</select></div></div>
    </div>
    <section id="voucher-config" aria-labelledby="vouchers-title">
        <div class="d-flex justify-content-between mb-3"><div><h2 class="h4" id="vouchers-title">Các mã trong chương trình</h2><p class="text-muted">Để trống giới hạn để phát hành/sử dụng không giới hạn. Mỗi vé lưu vào ví dùng một lần cho khách đó.</p></div><button type="button" class="btn btn-outline-primary align-self-start" id="add-voucher">+ Thêm mã</button></div>
        <div id="voucher-rows">
        @for (var i = 0; i < Model.Vouchers.Count; i++) {
            var data = new ViewDataDictionary<CampaignVoucherForm>(ViewData, Model.Vouchers[i]);
            data.TemplateInfo.HtmlFieldPrefix = $"Vouchers[{i}]";
            data["Dishes"] = Model.AvailableDishes;
            data["Customers"] = Model.AvailableCustomers;
            <div class="voucher-row" hidden="@Model.Vouchers[i].Xoa"><input type="hidden" name="Vouchers.Index" value="@i" />@await Html.PartialAsync("_VoucherRow", Model.Vouchers[i], data)</div>
        }
        </div>
        <p class="small text-muted">Xóa mã đã được thu thập hoặc gắn hóa đơn sẽ chuyển mã sang ngừng sử dụng để giữ lịch sử.</p>
    </section>
    <div class="d-flex gap-2 mt-4 mb-4"><button type="submit" class="btn btn-primary">Lưu chương trình và các mã</button><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div>
</form>
<template id="voucher-template">
@{ var template = new CampaignVoucherForm(); var templateData = new ViewDataDictionary<CampaignVoucherForm>(ViewData, template); templateData.TemplateInfo.HtmlFieldPrefix = "Vouchers[__index__]"; templateData["Dishes"] = Model.AvailableDishes; templateData["Customers"] = Model.AvailableCustomers; }
<div class="voucher-row"><input type="hidden" name="Vouchers.Index" value="__index__" />@await Html.PartialAsync("_VoucherRow", template, templateData)</div>
</template>
@section Scripts { <script src="~/js/campaign-vouchers.js" asp-append-version="true"></script> }
