@model RestaurantManagement.Web.Models.BaoCaoDashboardViewModel
@{
    ViewData["Title"] = "Tổng quan kinh doanh";
    ViewData["ActiveMenu"] = "BaoCaoTongQuan";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Tổng quan kinh doanh</h1>
        <p class="text-muted mb-0">Doanh thu, đơn hàng, món bán chạy và tồn kho trong kỳ đã chọn.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="DoanhThu" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-graph-up"></i> Chi tiết doanh thu
        </a>
    </div>
</div>

<!-- Lọc ngày -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <span class="fw-semibold text-muted small"><i class="bi bi-calendar3 me-1"></i> Khoảng thời gian:</span>
            </div>
            <div class="col-md-3">
                <input type="date" name="tuNgay" value="@Model.TuNgay.LocalDateTime.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-auto text-muted">đến</div>
            <div class="col-md-3">
                <input type="date" name="denNgay" value="@Model.DenNgay.LocalDateTime.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Áp dụng</button>
                <a asp-action="Index" class="btn btn-sm btn-light">Mặc định (30 ngày)</a>
            </div>
        </form>
    </div>
</div>

<!-- Thẻ KPI chính -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Tổng doanh thu thực tế</span>
                    <span class="badge bg-success-subtle text-success p-2 rounded-circle"><i class="bi bi-cash-stack fs-5"></i></span>
                </div>
                <div class="fs-3 fw-bold text-success mb-1">@Model.TongDoanhThu.ToString("N0") đ</div>
                <div class="small text-muted">Đã thanh toán (loại trừ đơn hủy)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Đơn hàng hoàn tất</span>
                    <span class="badge bg-primary-subtle text-primary p-2 rounded-circle"><i class="bi bi-receipt fs-5"></i></span>
                </div>
                <div class="fs-3 fw-bold text-dark mb-1">@Model.SoDonThanhCong bill thanh toán</div>
                <div class="small text-muted">@Model.TongSoDonHang đơn tạo trong kỳ</div>
                <div class="small text-muted">@Model.SoDonDaHuy đơn đã hủy</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Giá trị đơn TB (AOV)</span>
                    <span class="badge bg-info-subtle text-info p-2 rounded-circle"><i class="bi bi-pie-chart fs-5"></i></span>
                </div>
                <div class="fs-3 fw-bold text-info mb-1">@Model.GiaTriDonTrungBinh.ToString("N0") đ</div>
                <div class="small text-muted">Bình quân trên mỗi hóa đơn</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 bg-white">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Chiết khấu ưu đãi</span>
                    <span class="badge bg-danger-subtle text-danger p-2 rounded-circle"><i class="bi bi-tag fs-5"></i></span>
                </div>
                <div class="fs-3 fw-bold text-danger mb-1">- @Model.TongChiPhiKhuyenMai.ToString("N0") đ</div>
                <div class="small text-muted">Ngân sách khuyến mãi & voucher</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Biểu đồ xu hướng doanh thu -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-graph-up me-1 text-primary"></i> Xu hướng doanh thu 14 ngày gần nhất</h2>
                <a asp-action="DoanhThu" class="small text-decoration-none">Chi tiết báo cáo →</a>
            </div>
            <div class="card-body p-3">
                <canvas id="revenueChart" style="max-height: 280px; width: 100%;"></canvas>
            </div>
        </div>
    </div>

    <!-- Cơ cấu phương thức thanh toán -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-credit-card me-1 text-primary"></i> Tiền thu thêm khi chốt bill</h2>
                <p class="small text-muted mb-0">Chưa gồm @Model.TongTienCocDaTru.ToString("N0") đ cọc nhận trước. Doanh thu tổng đã gồm cọc cấn trừ.</p>
                @if (Model.SoHoaDonThieuNgayThanhToan > 0)
                {
                    <p class="small text-warning mb-0">@Model.SoHoaDonThieuNgayThanhToan bill cũ thiếu ngày thanh toán được tạm tính theo ngày lập.</p>
                }
            </div>
            <div class="card-body p-3 d-flex flex-column justify-content-center">
                <canvas id="paymentMethodChart" style="max-height: 200px;"></canvas>
                <div class="mt-3 small">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span><i class="bi bi-cash me-1 text-success"></i> Tiền mặt:</span>
                        <strong>@Model.DoanhThuTienMat.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span><i class="bi bi-qr-code me-1 text-primary"></i> Chuyển khoản QR:</span>
                        <strong>@Model.DoanhThuChuyenKhoan.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span><i class="bi bi-credit-card me-1 text-warning"></i> Thẻ POS:</span>
                        <strong>@Model.DoanhThuThe.ToString("N0") đ</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Top 5 món bán chạy nhất -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-fire me-1 text-danger"></i> Top món ăn bán chạy nhất</h2>
                <a asp-action="MonBanChay" class="small text-decoration-none">Xem tất cả →</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>#</th>
                                <th>Món ăn</th>
                                <th class="text-end">Đã bán</th>
                                <th class="text-end">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopMonBanChay.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-muted py-4">Chưa có dữ liệu bán hàng.</td></tr>
                            }
                            @{ int r = 1; }
                            @foreach (var dish in Model.TopMonBanChay)
                            {
                                <tr>
                                    <td class="fw-bold text-muted small" style="width: 30px;">@(r++)</td>
                                    <td>
                                        <div class="fw-semibold">@dish.TenMon</div>
                                        <div class="small text-muted">@dish.TenDanhMuc · Size @dish.SizePhoBien</div>
                                    </td>
                                    <td class="text-end fw-bold">@dish.SoLuongDaBan.ToString("N0")</td>
                                    <td class="text-end text-success fw-semibold">@dish.DoanhThuMangLai.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Tồn kho cần bổ sung & Ưu đãi nổi bật -->
    <div class="col-lg-6">
        <!-- Cảnh báo tồn kho -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-exclamation-triangle me-1 text-warning"></i> Cảnh báo kho nguyên liệu</h2>
                <a asp-action="TonKho" class="small text-decoration-none">Báo cáo tồn kho →</a>
            </div>
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted small">Tổng giá trị tồn kho: <strong>@Model.TongGiaTriTonKho.ToString("N0") đ</strong></span>
                    <span class="badge @(Model.SoNguyenLieuCanhBao > 0 ? "bg-danger" : "bg-success")">
                        @(Model.SoNguyenLieuCanhBao > 0 ? $"{Model.SoNguyenLieuCanhBao} mục dưới ngưỡng an toàn" : "Kho an toàn")
                    </span>
                </div>
                @if (Model.NguyenLieuCanhBao.Count > 0)
                {
                    <div class="list-group list-group-flush small">
                        @foreach (var nl in Model.NguyenLieuCanhBao)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <div class="fw-semibold text-danger">@nl.TenNguyenLieu</div>
                                    <div class="text-muted small">Hiện có: @nl.SoLuongTon.ToString("0.##") @nl.DonViTinh / Ngưỡng: @nl.NguongCanhBao.ToString("0.##") @nl.DonViTinh</div>
                                </div>
                                <span class="badge bg-danger-subtle text-danger">Thiếu @nl.ThieuHut.ToString("0.##") @nl.DonViTinh</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0 text-center py-2">Tất cả nguyên liệu đều đang duy trì trên ngưỡng an toàn.</p>
                }
            </div>
        </div>

        <!-- Tóm tắt khuyến mãi hiệu quả -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0 fw-bold text-dark"><i class="bi bi-gift me-1 text-primary"></i> Hiệu quả chương trình ưu đãi</h2>
                <a asp-action="HieuQuaKhuyenMai" class="small text-decoration-none">Chi tiết ưu đãi →</a>
            </div>
            <div class="card-body p-3">
                @if (Model.TopKhuyenMaiHieuQua.Count > 0)
                {
                    <div class="list-group list-group-flush small">
                        @foreach (var km in Model.TopKhuyenMaiHieuQua.Take(3))
                        {
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-semibold">@km.TenChuongTrinh</span>
                                    <span class="badge bg-light text-dark border">@km.SoLuotApDung lượt dùng</span>
                                </div>
                                <div class="d-flex justify-content-between text-muted small mt-1">
                                    <span>Chiết khấu: <strong class="text-danger">-@km.TongTienGiam.ToString("N0") đ</strong></span>
                                    <span>Doanh thu thu về: <strong class="text-success">@km.DoanhThuMangLai.ToString("N0") đ</strong></span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0 text-center py-2">Chưa ghi nhận lượt áp dụng khuyến mãi nào trong kỳ này.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // 1. Line Chart xu hướng doanh thu
    const timelineLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DoanhThuTheoNgay.Select(x => x.NhanThoiGian)));
    const timelineData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DoanhThuTheoNgay.Select(x => x.DoanhThuThuc)));

    new Chart(document.getElementById('revenueChart'), {
        type: 'line',
        data: {
            labels: timelineLabels,
            datasets: [{
                label: 'Doanh thu (đ)',
                data: timelineData,
                borderColor: '#10B981',
                backgroundColor: 'rgba(16, 185, 129, 0.1)',
                borderWidth: 2,
                fill: true,
                tension: 0.3
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return (value / 1000).toLocaleString() + 'k';
                        }
                    }
                }
            }
        }
    });

    // 2. Doughnut Chart cơ cấu thanh toán
    new Chart(document.getElementById('paymentMethodChart'), {
        type: 'doughnut',
        data: {
            labels: ['Tiền mặt', 'Chuyển khoản QR', 'Thẻ POS'],
            datasets: [{
                data: [@Model.DoanhThuTienMat, @Model.DoanhThuChuyenKhoan, @Model.DoanhThuThe],
                backgroundColor: ['#10B981', '#0284C7', '#F59E0B'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
</script>
}
