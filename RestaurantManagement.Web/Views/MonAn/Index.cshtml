@using RestaurantManagement.API.Models
@model MonAnIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thực đơn món ăn";
}
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><h2 class="h3 mb-1">Thực đơn món ăn</h2><p class="text-muted mb-0">Quản lý thông tin món, giá theo size và công thức nguyên liệu.</p></div>
        <a asp-action="Create" class="btn btn-primary btn-brand-primary">+ Thêm món ăn</a>
    </div>
    <partial name="_ManagementMessages" />
    <div class="row g-3 mb-4">
        @foreach (var stat in new[] { ("Tổng số món", Model.TotalCount), ("Đang phục vụ", Model.DangPhucVuCount), ("Tạm hết", Model.TamHetCount), ("Ngừng kinh doanh", Model.NgungKinhDoanhCount) })
        { <div class="col-md-3 col-6"><div class="card border-0 shadow-sm"><div class="card-body">@stat.Item1<strong class="d-block fs-3">@stat.Item2</strong></div></div></div> }
    </div>
    <form asp-action="Index" method="get" class="card border-0 shadow-sm mb-4">
        <div class="card-body row g-3 align-items-end">
            <div class="col-md-4"><label for="search" class="form-label">Tên món</label><input id="search" name="search" value="@Model.Search" class="form-control" /></div>
            <div class="col-md-3"><label for="danhMucId" class="form-label">Danh mục</label><select id="danhMucId" name="danhMucId" class="form-select">
                <option value="">Tất cả danh mục</option>
                @foreach (var category in Model.DanhMucList) { <option value="@category.Id" selected="@(category.Id == Model.DanhMucId)">@category.TenDanhMuc</option> }
            </select></div>
            <div class="col-md-3"><label for="trangThai" class="form-label">Trạng thái</label><select id="trangThai" name="trangThai" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="DangPhucVu" selected="@(Model.TrangThai == "DangPhucVu")">Đang phục vụ</option>
                <option value="TamHet" selected="@(Model.TrangThai == "TamHet")">Tạm hết</option>
                <option value="NgungKinhDoanh" selected="@(Model.TrangThai == "NgungKinhDoanh")">Ngừng kinh doanh</option>
            </select></div>
            <div class="col-md-2 d-flex gap-2"><button type="submit" class="btn btn-primary">Lọc</button><a asp-action="Index" class="btn btn-outline-secondary">Bỏ lọc</a></div>
        </div>
    </form>
    @if (!Model.Items.Any()) { <div class="alert alert-light border text-center py-5">Không tìm thấy món ăn phù hợp.</div> }
    <div class="row g-4 mb-4">
        @foreach (var item in Model.Items)
        {
            <div class="col-xl-4 col-md-6"><article class="card h-100 border-0 shadow-sm">
                @if (!string.IsNullOrEmpty(item.HinhAnh))
                { <img src="@item.HinhAnh" alt="@item.TenMon" class="card-img-top" style="aspect-ratio:16/9;object-fit:cover;" /> }
                <div class="card-body">
                    <div class="d-flex justify-content-between gap-2 mb-3">
                        <span class="text-muted small">@item.TenDanhMuc</span>
                        <span class="badge @(item.TrangThai == TrangThaiMon.DangPhucVu ? "bg-success" : item.TrangThai == TrangThaiMon.TamHet ? "bg-warning text-dark" : "bg-secondary")">@(item.TrangThai == TrangThaiMon.DangPhucVu ? "Đang phục vụ" : item.TrangThai == TrangThaiMon.TamHet ? "Tạm hết" : "Ngừng kinh doanh")</span>
                    </div>
                    <h3 class="h5">@item.TenMon</h3>
                    <p class="text-muted">@item.MoTa</p>
                    <strong class="text-primary">@(item.GiaBan.HasValue ? (item.SoSize > 1 ? "Từ " : "") + item.GiaBan.Value.ToString("N0") + " đ" : "Chưa có giá đang sử dụng")</strong>
                    @if (item.SoSize > 1) { <small class="text-muted d-block">@item.SoSize lựa chọn size</small> }
                </div>
                <div class="card-footer bg-white d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa / Định mức</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                </div>
            </article></div>
        }
    </div>
    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted">@Model.TotalItems kết quả · Trang @Model.CurrentPage / @Model.TotalPages</span>
        <div class="d-flex gap-2">
            @if (Model.CurrentPage > 1) { <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search" asp-route-danhMucId="@Model.DanhMucId" asp-route-trangThai="@Model.TrangThai">Trước</a> }
            @if (Model.CurrentPage < Model.TotalPages) { <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search" asp-route-danhMucId="@Model.DanhMucId" asp-route-trangThai="@Model.TrangThai">Sau</a> }
        </div>
    </div>
</div>
