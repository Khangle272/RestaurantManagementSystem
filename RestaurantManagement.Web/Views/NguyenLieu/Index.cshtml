@using RestaurantManagement.API.Models
@model IEnumerable<NguyenLieu>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Kho & Danh mục Nguyên liệu";
    var currentSearch = ViewBag.Search as string;
    var currentDonViTinh = ViewBag.DonViTinh as string;
    var currentTrangThai = ViewBag.TrangThai as string;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-1">@ViewData["Title"]</h2>
            <p class="text-muted mb-0">Quản lý danh sách nguyên liệu và đơn vị tính</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary">
                <i class="bi bi-file-earmark-excel"></i> Xuất Excel
            </button>
            <a asp-action="Create" class="btn btn-primary btn-brand-primary">
                <i class="bi bi-plus-lg"></i> + Thêm nguyên liệu mới
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card card-stat h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Tổng số nguyên liệu</h6>
                    <h3 class="mb-0">@totalItems</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-stat h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Đang sử dụng</h6>
                    <h3 class="mb-0 text-success">@Model.Count(m => m.DangSuDung)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-stat h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Ngừng sử dụng</h6>
                    <h3 class="mb-0 text-danger">@Model.Count(m => !m.DangSuDung)</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="search" value="@currentSearch" class="form-control" placeholder="Tìm kiếm theo tên nguyên liệu..." />
                </div>
                <div class="col-md-3">
                    <select name="donViTinh" class="form-select">
                        <option value="">-- Tất cả đơn vị tính --</option>
                        @foreach (var dvt in new[] { "kg", "lít", "lốc", "chai", "lon", "gói", "quả" })
                        {
                            if (currentDonViTinh == dvt)
                            {
                                <option value="@dvt" selected>@dvt</option>
                            }
                            else
                            {
                                <option value="@dvt">@dvt</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="trangThai" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <!option value="dang-su-dung" @(currentTrangThai == "dang-su-dung" ? "selected" : "")>Đang sử dụng</!option>
                        <!option value="ngung-su-dung" @(currentTrangThai == "ngung-su-dung" ? "selected" : "")>Ngừng sử dụng</!option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">Lọc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Xóa</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã NL</th>
                            <th>Tên nguyên liệu</th>
                            <th>ĐVT</th>
                            <th>Ngưỡng cảnh báo</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">Không tìm thấy nguyên liệu nào.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted">#NL@(item.Id.ToString("D3"))</td>
                                <td class="fw-medium">@item.TenNguyenLieu</td>
                                <td><span class="badge bg-light text-dark border">@item.DonViTinh</span></td>
                                <td>@item.NguongCanhBao</td>
                                <td>
                                    @if (item.DangSuDung)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 badge-status-success">Đang sử dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">Ngừng sử dụng</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa nguyên liệu này?');" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white py-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-end mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-donViTinh="@currentDonViTinh" asp-route-trangThai="@currentTrangThai">Trước</a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@currentSearch" asp-route-donViTinh="@currentDonViTinh" asp-route-trangThai="@currentTrangThai">@i</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-donViTinh="@currentDonViTinh" asp-route-trangThai="@currentTrangThai">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
