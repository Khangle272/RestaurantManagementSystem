<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý nhà hàng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header d-flex align-items-center justify-content-between gap-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-shop me-2"></i>Quản lý nhà hàng</h4>
            <button class="btn btn-outline-light btn-sm d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#management-menu" aria-controls="management-menu" aria-expanded="false" aria-label="Mở hoặc đóng menu chức năng">Menu</button>
        </div>
        <div id="management-menu" class="management-sidebar-content collapse d-md-flex flex-column flex-grow-1">
            <nav class="admin-sidebar-nav" aria-label="Chức năng quản lý">
                <a asp-controller="Admin" asp-action="TrangChu" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")">Trang chủ</a>
                @await Html.PartialAsync("_ManagementNavigation", false)
            </nav>
            <div class="management-sidebar-actions"><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="btn btn-link text-white text-decoration-none w-100 text-start">Đăng xuất</button></form></div>
            <div class="admin-sidebar-footer">&copy; @DateTime.Now.Year - Quản lý nhà hàng</div>
        </div>
    </aside>
    <header class="admin-topbar"><h5 class="mb-0 fw-semibold">@ViewData["Title"]</h5><div class="ms-auto"><partial name="_RoleLabel" /></div></header>
    <main class="admin-main">
        <div class="container-fluid p-0">
            <partial name="_ManagementMessages" />
            @RenderBody()
        </div>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
