@model LoginViewModel
@{ Layout = "_Layout"; ViewData["Title"] = "Đăng nhập khách hàng"; }
<section class="auth-page" aria-labelledby="login-title">
    <div class="auth-story">
        <img src="~/images/hero-vietnamese-table.png" alt="Hình minh họa món ăn Việt được bày trên bàn" />
        <div class="auth-story-content"><p class="eyebrow eyebrow-light">DÀNH CHO KHÁCH HÀNG</p><h1>Hẹn nhau bên<br />một bữa ngon.</h1><p>Đăng nhập để đặt bàn và xem lại những lần ghé thăm của bạn.</p><a asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Trở về trang chủ</a></div>
    </div>
    <div class="auth-panel-wrap"><div class="auth-panel">
        <div class="auth-form-heading"><span class="auth-icon"><i class="bi bi-person" aria-hidden="true"></i></span><p class="eyebrow">TÀI KHOẢN KHÁCH HÀNG</p><h2 id="login-title">Chào mừng trở lại</h2><p>Nhập thông tin để tiếp tục.</p></div>
        <form asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>
            <div class="auth-field"><label asp-for="Email">Email</label><input asp-for="Email" class="form-control" autocomplete="username" inputmode="email" placeholder="ban@example.com" /><span asp-validation-for="Email" class="field-error"></span></div>
            <div class="auth-field"><label asp-for="Password">Mật khẩu</label><div class="password-input"><input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" /><button type="button" class="password-toggle" data-password-toggle="Password" aria-label="Hiện mật khẩu" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button></div><span asp-validation-for="Password" class="field-error"></span></div>
            <button type="submit" class="btn btn-restaurant auth-submit">Đăng nhập <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
        </form>
        <p class="auth-next">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
        <div class="auth-switch">Bạn là nhân viên? <a asp-controller="Admin" asp-action="Index">Đến cổng quản trị <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></div>
    </div></div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
