@model RestaurantManagement.Web.Models.OrderListViewModel
@using RestaurantManagement.API.Models
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="h3 mb-1">Quản lý đơn hàng</h1>
            <p class="text-muted mb-0">Theo dõi, cập nhật tiến độ phục vụ và xử lý đơn hàng tại bàn, mang đi và giao hàng.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-1 shadow-sm">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Ghi nhận gọi món mới
            </a>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Bộ lọc tìm kiếm -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </span>
                        <input type="text" name="search" value="@Model.Search" class="form-control border-start-0" placeholder="Tìm theo mã HĐ, tên bàn, tên khách, SĐT..." />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select name="loaiDonHang" class="form-select">
                        <option value="">-- Tất cả loại đơn --</option>
                        <option value="TaiBan" selected="@(Model.LoaiDonHang == LoaiDonHang.TaiBan)">Tại bàn</option>
                        <option value="MangDi" selected="@(Model.LoaiDonHang == LoaiDonHang.MangDi)">Mang đi</option>
                        <option value="GiaoHang" selected="@(Model.LoaiDonHang == LoaiDonHang.GiaoHang)">Giao hàng</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <select name="trangThai" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="ChuaThanhToan" selected="@(Model.TrangThai == TrangThaiHoaDon.ChuaThanhToan)">Chờ thanh toán</option>
                        <option value="DaThanhToan" selected="@(Model.TrangThai == TrangThaiHoaDon.DaThanhToan)">Đã thanh toán</option>
                        <option value="DaHuy" selected="@(Model.TrangThai == TrangThaiHoaDon.DaHuy)">Đã hủy</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary w-100">Lọc</button>
                    @if (Model.LoaiDonHang.HasValue || Model.TrangThai.HasValue || !string.IsNullOrEmpty(Model.Search))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">✕</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách đơn hàng -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã đơn / Thời gian</th>
                        <th>Loại đơn</th>
                        <th>Bàn / Người nhận</th>
                        <th>Tiến độ chế biến</th>
                        <th class="text-end">Tổng tiền</th>
                        <th>Thanh toán</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <p class="mb-2">Không tìm thấy đơn hàng nào phù hợp với điều kiện tìm kiếm.</p>
                            <a asp-action="Create" class="btn btn-sm btn-outline-primary">Tạo đơn gọi món ngay</a>
                        </td>
                    </tr>
                }
                @foreach (var order in Model.Orders)
                {
                    var typeBadge = order.LoaiDonHang switch
                    {
                        LoaiDonHang.TaiBan => "bg-primary-subtle text-primary border border-primary-subtle",
                        LoaiDonHang.MangDi => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                        LoaiDonHang.GiaoHang => "bg-info-subtle text-info-emphasis border border-info-subtle",
                        _ => "bg-secondary"
                    };

                    var payBadge = order.TrangThai switch
                    {
                        TrangThaiHoaDon.DaThanhToan => "bg-success-subtle text-success border border-success-subtle",
                        TrangThaiHoaDon.ChuaThanhToan => "bg-danger-subtle text-danger border border-danger-subtle",
                        TrangThaiHoaDon.ThanhToanMotPhan => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                        _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
                    };

                    var payLabel = order.TrangThai switch
                    {
                        TrangThaiHoaDon.DaThanhToan => "Đã thanh toán",
                        TrangThaiHoaDon.ChuaThanhToan => "Chờ thanh toán",
                        TrangThaiHoaDon.ThanhToanMotPhan => "Một phần",
                        _ => "Đã hủy"
                    };

                    <tr>
                        <td class="ps-3">
                            <a asp-action="Details" asp-route-id="@order.Id" class="fw-bold text-decoration-none text-dark">
                                @order.MaHoaDon
                            </a>
                            <div class="small text-muted">@order.ThoiDiemLap.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</div>
                        </td>
                        <td>
                            <span class="badge rounded-pill @typeBadge px-2 py-1">@order.TenLoaiDon</span>
                        </td>
                        <td>
                            @if (order.LoaiDonHang == LoaiDonHang.TaiBan)
                            {
                                <div class="fw-semibold">@order.Ban</div>
                                @if (!string.IsNullOrEmpty(order.TenKhachHang))
                                {
                                    <div class="small text-muted">@order.TenKhachHang @(!string.IsNullOrEmpty(order.SoDienThoai) ? $"· {order.SoDienThoai}" : "")</div>
                                }
                            }
                            else
                            {
                                <div class="fw-semibold">@(order.TenKhachHang ?? "Khách lẻ")</div>
                                @if (!string.IsNullOrEmpty(order.SoDienThoai))
                                {
                                    <div class="small text-muted">@order.SoDienThoai</div>
                                }
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @if (order.MonSanSang > 0)
                                {
                                    <span class="badge bg-success" title="Món đã nấu xong, sẵn sàng mang ra bàn!">
                                        ⚡ @order.MonSanSang sẵn sàng
                                    </span>
                                }
                                @if (order.MonDangCheBien > 0)
                                {
                                    <span class="badge bg-warning text-dark" title="Đang nấu trong bếp">
                                        🔥 @order.MonDangCheBien đang nấu
                                    </span>
                                }
                                @if (order.MonChoCheBien > 0)
                                {
                                    <span class="badge bg-secondary" title="Chờ bếp tiếp nhận">
                                        ⏳ @order.MonChoCheBien chờ nấu
                                    </span>
                                }
                                @if (order.MonDaPhucVu > 0 && order.MonChoCheBien == 0 && order.MonDangCheBien == 0 && order.MonSanSang == 0)
                                {
                                    <span class="badge bg-light text-muted border">
                                        ✓ Đã phục vụ đủ (@order.MonDaPhucVu món)
                                    </span>
                                }
                                else if (order.TongSoMon == 0)
                                {
                                    <span class="text-muted small">Chưa có món</span>
                                }
                            </div>
                        </td>
                        <td class="text-end">
                            <span class="fw-bold">@order.TongTien.ToString("N0") đ</span>
                            <div class="small text-muted">@order.TongSoMon phần món</div>
                        </td>
                        <td>
                            <span class="badge rounded-pill @payBadge px-2 py-1">@payLabel</span>
                            @if (order.TrangThai == TrangThaiHoaDon.DaThanhToan)
                            {
                                <div class="small text-muted">@order.PhuongThucThanhToan</div>
                            }
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary" title="Xem chi tiết đơn hàng & trạng thái">
                                    Chi tiết
                                </a>
                                @if (order.TrangThai == TrangThaiHoaDon.ChuaThanhToan)
                                {
                                    <a asp-action="AddDishes" asp-route-id="@order.Id" class="btn btn-outline-secondary" title="Gọi thêm món vào đơn">
                                        + Món
                                    </a>
                                    <a asp-controller="HoaDon" asp-action="Details" asp-route-id="@order.Id" class="btn btn-success" title="Thanh toán đơn hàng">
                                        Thu tiền
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <span class="small text-muted">Hiển thị @Model.Orders.Count trên tổng số @Model.TotalItems đơn hàng</span>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-loaiDonHang="@Model.LoaiDonHang" asp-route-trangThai="@Model.TrangThai" asp-route-search="@Model.Search">@p</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
