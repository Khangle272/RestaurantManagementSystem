<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nhà hàng</title>
    <meta name="description" content="@(ViewData["Description"] as string ?? "Xem thực đơn, đặt bàn trực tuyến, đặt món trước và nhận ưu đãi của nhà hàng.")" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer-cart.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ux.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    var routeController = ViewContext.RouteData.Values["controller"]?.ToString();
    var routeAction = ViewContext.RouteData.Values["action"]?.ToString();
    string NavActive(string controller, string? action = null) =>
        routeController == controller && (action is null || routeAction == action) ? "active" : "";
    string? NavCurrent(string controller, string? action = null) => NavActive(controller, action) == "" ? null : "page";
    // Không hiện giỏ món nổi trên trang đăng nhập / đăng ký / tài khoản để màn hình gọn.
    var showCart = (User.Identity?.IsAuthenticated != true || User.IsInRole("KhachHang"))
        && routeController is not ("Account" or "Admin");
}
<body>
<a class="visually-hidden-focusable restaurant-skip-link" href="#restaurant-main">Bỏ qua điều hướng</a>
<header class="restaurant-nav">
    <nav class="navbar navbar-expand-lg restaurant-shell" aria-label="Điều hướng chính">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i class="bi bi-cup-hot-fill" aria-hidden="true"></i></span>Nhà hàng</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#restaurantNav" aria-controls="restaurantNav" aria-expanded="false" aria-label="Mở menu"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="restaurantNav">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="thuc-don">Thực đơn</a></li>
                @if (User.Identity?.IsAuthenticated != true || User.IsInRole("KhachHang"))
                {
                    <li class="nav-item"><a class="nav-link @NavActive("DatBan", "Index")" aria-current="@NavCurrent("DatBan", "Index")" asp-controller="DatBan" asp-action="Index" asp-route-cart="new">Đặt bàn</a></li>
                }
                @if (User.IsInRole("KhachHang"))
                {
                    <li class="nav-item"><a class="nav-link @NavActive("DatBan", "LichSu")" aria-current="@NavCurrent("DatBan", "LichSu")" asp-controller="DatBan" asp-action="LichSu">Lịch sử đặt bàn</a></li>
                    <li class="nav-item"><a class="nav-link @NavActive("KhachHang", "Vouchers")" aria-current="@NavCurrent("KhachHang", "Vouchers")" asp-controller="KhachHang" asp-action="Vouchers">Voucher & ví của tôi</a></li>
                    <li class="nav-item"><a class="nav-link @NavActive("KhachHang", "Index")" aria-current="@NavCurrent("KhachHang", "Index")" asp-controller="KhachHang" asp-action="Index">Đơn hàng & tích điểm</a></li>
                }
                @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("KhachHang"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="TrangChu">Khu làm việc</a></li>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item"><a class="nav-link @NavActive("Account", "Index")" aria-current="@NavCurrent("Account", "Index")" asp-controller="Account" asp-action="Index">Thông tin cá nhân</a></li>
                    <li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-link btn btn-link" type="submit">Đăng xuất</button></form></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link @NavActive("Account", "Register")" aria-current="@NavCurrent("Account", "Register")" asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                    <li class="nav-item"><a class="nav-link nav-login" asp-controller="Account" asp-action="Login">Đăng nhập <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></li>
                }
            </ul>
        </div>
    </nav>
</header>
<main class="restaurant-main restaurant-shell" id="restaurant-main" role="main">
    <partial name="_ManagementMessages" />
    @if (showCart) { <partial name="_CustomerCart" /> }
    @RenderBody()
</main>
<footer class="restaurant-footer"><div class="restaurant-shell d-flex justify-content-between flex-wrap gap-2"><strong>Nhà hàng</strong><span>&copy; @RestaurantManagement.Web.Services.TableService.VietnamNow.Year · Món ngon cho mọi cuộc gặp gỡ</span></div></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/ajax-forms.js" asp-append-version="true"></script>
@if (showCart) { <script src="~/js/customer-cart.js" asp-append-version="true"></script> }
<script src="~/js/ux.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
