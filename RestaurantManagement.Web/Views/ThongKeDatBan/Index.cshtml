@model ReservationPlanningViewModel
@using RestaurantManagement.Web.Services
@{ ViewData["Title"] = "Đặt bàn & dự trù nguyên liệu"; }
<div class="page-header">
    <div>
        <h1 class="h3">Đặt bàn & dự trù nguyên liệu</h1>
        <p class="text-muted">Tổng hợp lịch đã xác nhận theo ngày, tuần, ca và VIP. Dự trù từ món đặt trước của khách chưa nhận bàn; không tính doanh thu và không tự xuất kho.</p>
    </div>
</div>
<form method="get" class="filter-bar">
    <div class="filter-field"><label class="form-label" for="planning-from">Từ ngày</label><input id="planning-from" name="tuNgay" type="date" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="filter-field"><label class="form-label" for="planning-until">Đến ngày</label><input id="planning-until" name="denNgay" type="date" value="@Model.Until.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="filter-field"><label class="form-label" for="planning-shift">Ca</label><select id="planning-shift" name="ca" class="form-select"><option value="">Tất cả ca</option>@foreach(var slot in ReservationSchedule.Slots) { <option value="@slot.Id" selected="@(Model.Shift == slot.Id)">@slot.Label</option> }</select></div>
    <div class="filter-field"><label class="form-label" for="planning-vip">Loại bàn</label><select id="planning-vip" name="vip" class="form-select"><option value="">Tất cả</option><option value="false" selected="@(Model.Vip == false)">Bàn thường</option><option value="true" selected="@(Model.Vip == true)">VIP</option></select></div>
    <div class="filter-actions"><button class="btn btn-primary">Xem thống kê</button><button name="cheDo" value="tuan" class="btn btn-outline-secondary">Cả tuần của ngày bắt đầu</button></div>
</form>
<div class="stat-grid">
    <div class="stat-tile stat-success"><span class="stat-icon"><i class="bi bi-calendar-check" aria-hidden="true"></i></span><span class="stat-body"><span class="stat-label">Lịch đã xác nhận</span><strong class="stat-value">@Model.Rows.Sum(x => x.Reservations)</strong><small class="stat-sub">@Model.Rows.Sum(x => x.Tables) lượt bàn · @Model.Rows.Sum(x => x.Guests) khách</small></span></div>
    <div class="stat-tile @(Model.Waiting > 0 ? "stat-warning" : "stat-muted")"><span class="stat-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span><span class="stat-body"><span class="stat-label">Lịch còn chờ</span><strong class="stat-value">@Model.Waiting</strong><small class="stat-sub">Chưa tính vào nhu cầu chắc chắn</small></span></div>
    <div class="stat-tile @(Model.WithoutFood > 0 ? "stat-warning" : "stat-muted")"><span class="stat-icon"><i class="bi bi-egg-fried" aria-hidden="true"></i></span><span class="stat-body"><span class="stat-label">Lịch chưa chọn món</span><strong class="stat-value">@Model.WithoutFood</strong><small class="stat-sub">Chưa thể dự trù nguyên liệu cho các lịch này</small></span></div>
</div>
<section class="data-card">
    <div class="data-card-header"><h2>Số lượng đặt bàn</h2></div>
    <div class="table-responsive"><table class="table table-hover align-middle">
        <thead><tr><th>Ngày</th><th>Ca</th><th>Loại</th><th class="text-end">Lịch</th><th class="text-end">Lượt bàn</th><th class="text-end">Khách</th></tr></thead>
        <tbody>
        @if (Model.Rows.Count == 0) { <tr><td colspan="6" class="empty-state"><i class="bi bi-calendar-x" aria-hidden="true"></i>Không có lịch đã xác nhận trong bộ lọc này.</td></tr> }
        @foreach(var row in Model.Rows) { <tr><td class="cell-nowrap">@VnTime.Ngay(row.Day)</td><td>@row.Shift</td><td>@if (row.Vip) { <span class="badge-status-warning">VIP</span> } else { <span>Thường</span> }</td><td class="text-end">@row.Reservations</td><td class="text-end">@row.Tables</td><td class="text-end">@row.Guests</td></tr> }
        </tbody>
    </table></div>
</section>
<section class="data-card" id="theo-gio-den">
    <div class="data-card-header"><div><h2>Số lượt đặt theo giờ đến</h2><p class="small text-muted mb-0 mt-1">Đếm theo đúng giờ hẹn của từng lịch (giờ Việt Nam). Lịch đã xác nhận và lịch còn chờ cọc/chờ xác nhận tách riêng; không tính lịch đã hủy hoặc khách không đến.</p></div></div>
    <div class="table-responsive"><table class="table table-hover align-middle">
        <thead><tr><th>Ngày</th><th>Giờ đến</th><th class="text-end">Đã xác nhận</th><th class="text-end">Chờ cọc / chờ xác nhận</th><th class="text-end">Tổng lượt</th><th class="text-end">Bàn đã giữ</th><th class="text-end">Khách</th></tr></thead>
        <tbody>
        @if (Model.ArrivalTimes.Count == 0) { <tr><td colspan="7" class="empty-state"><i class="bi bi-clock" aria-hidden="true"></i>Không có lịch đặt nào trong bộ lọc này.</td></tr> }
        @foreach (var row in Model.ArrivalTimes) {
            <tr><td class="cell-nowrap">@VnTime.Ngay(row.Day)</td><td class="fw-semibold">@VnTime.Gio(row.Time)</td>
                <td class="text-end">@row.Confirmed</td><td class="text-end @(row.Waiting > 0 ? "text-warning-emphasis fw-semibold" : "")">@row.Waiting</td>
                <td class="text-end fw-semibold">@row.Total</td><td class="text-end">@row.Tables</td><td class="text-end">@row.Guests</td></tr>
        }
        </tbody>
        @if (Model.ArrivalTimes.Count > 0) {
            <tfoot><tr class="fw-semibold"><td colspan="2">Tổng</td><td class="text-end">@Model.ArrivalTimes.Sum(x => x.Confirmed)</td><td class="text-end">@Model.ArrivalTimes.Sum(x => x.Waiting)</td><td class="text-end">@Model.ArrivalTimes.Sum(x => x.Total)</td><td class="text-end">@Model.ArrivalTimes.Sum(x => x.Tables)</td><td class="text-end">@Model.ArrivalTimes.Sum(x => x.Guests)</td></tr></tfoot>
        }
    </table></div>
</section>
<section class="data-card">
    <div class="data-card-header"><div><h2>Nguyên liệu cần chuẩn bị</h2><p class="small text-muted mb-0 mt-1">Đúng size khách chọn × số phần × định mức size. Combo phải có định mức riêng cho size combo; không tự lấy công thức size khác. Số thiếu so với tồn kho hiện tại chưa phải lệnh mua hàng.</p></div></div>
    @foreach(var warning in Model.Warnings) { <div class="alert alert-warning py-2 m-3">@warning</div> }
    <div class="table-responsive"><table class="table table-hover align-middle">
        <thead><tr><th>Nguyên liệu</th><th>Đơn vị</th><th class="text-end">Cần chuẩn bị</th><th class="text-end">Tồn hiện tại</th><th class="text-end">Còn thiếu</th></tr></thead>
        <tbody>
        @if (Model.Ingredients.Count == 0) { <tr><td colspan="5" class="empty-state"><i class="bi bi-basket2" aria-hidden="true"></i>Chưa có nhu cầu nguyên liệu tính được trong bộ lọc này. Kiểm tra món đặt trước và định mức.</td></tr> }
        @foreach(var row in Model.Ingredients) { <tr><td class="fw-semibold">@row.Name</td><td>@row.Unit</td><td class="text-end">@row.Required.ToString("0.###")</td><td class="text-end">@row.Stock.ToString("0.###")</td><td class="text-end @(row.Shortage > 0 ? "text-danger fw-bold" : "")">@row.Shortage.ToString("0.###")</td></tr> }
        </tbody>
    </table></div>
</section>
