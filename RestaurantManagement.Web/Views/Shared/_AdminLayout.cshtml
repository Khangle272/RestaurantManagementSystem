<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý nhà hàng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header"><h4 class="mb-0 fw-bold"><i class="bi bi-shop me-2"></i>Quản lý nhà hàng</h4></div>
        <nav class="admin-sidebar-nav">
            @{ var activeMenu = ViewData["ActiveMenu"]?.ToString() ?? ""; }
            @if (User.IsInRole("Admin") || User.IsInRole("TiepTan"))
            {
                <a asp-controller="QuanLyDatBan" asp-action="Index" class="nav-link @(activeMenu == "QuanLyDatBan" ? "active" : "")">
                    <i class="bi bi-calendar2-check me-2"></i>Tiếp nhận Đặt bàn
                </a>
                <a asp-controller="QuanLyDatBan" asp-action="DanhGia" class="nav-link @(activeMenu == "QuanLyDanhGia" ? "active" : "")">
                    <i class="bi bi-star me-2"></i>Đánh giá của khách
                </a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("ThucDon"))
            {
                <a asp-controller="MonAn" asp-action="Index" class="nav-link @(activeMenu == "MonAn" ? "active" : "")">Thực đơn món</a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("DanhMucMon"))
            {
                <a asp-controller="DanhMuc" asp-action="Index" class="nav-link @(activeMenu == "DanhMuc" ? "active" : "")">Danh mục món ăn</a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="NhanVien" asp-action="Index" class="nav-link @(activeMenu == "NhanVien" ? "active" : "")">Nhân viên</a>
                <a asp-controller="TaiKhoanNhanVien" asp-action="Index" class="nav-link">Tài khoản nhân viên</a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("Kho"))
            {
                <a asp-controller="NguyenLieu" asp-action="Index" class="nav-link @(activeMenu == "NguyenLieu" ? "active" : "")">Kho nguyên liệu</a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("Bep"))
            {
                <a asp-controller="Bep" asp-action="Index" class="nav-link">Bếp chế biến</a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("BoiBan"))
            {
                <a asp-controller="BanAn" asp-action="Index" class="nav-link @(activeMenu == "BanAn" ? "active" : "")">Bàn ăn</a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("ThuNgan"))
            {
                <a asp-controller="HoaDon" asp-action="Index" class="nav-link @(activeMenu == "HoaDon" ? "active" : "")">Hóa đơn</a>
            }
            <a asp-controller="Home" asp-action="Index" class="nav-link">Trang chủ</a>
            <a asp-controller="Account" asp-action="ChangePassword" class="nav-link">Đổi mật khẩu</a>
            <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="nav-link btn btn-link text-start w-100">Đăng xuất</button></form>
        </nav>
        <div class="admin-sidebar-footer">&copy; @DateTime.Now.Year - Quản lý nhà hàng</div>
    </aside>
    <header class="admin-topbar"><h5 class="mb-0 fw-semibold">@ViewData["Title"]</h5></header>
    <main class="admin-main">
        <div class="container-fluid p-0">
            <partial name="_ManagementMessages" />
            @RenderBody()
        </div>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
