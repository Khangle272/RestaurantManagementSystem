@model List<RestaurantManagement.API.Models.HoaDon>
@using RestaurantManagement.API.Models
@{
    ViewData["Title"] = "Hóa đơn & thanh toán";
    ViewData["ActiveMenu"] = "HoaDon";
    var daThanhToan = ViewBag.DaThanhToan is true;
    var pagination = ViewBag.Pagination as PaginationViewModel ?? new PaginationViewModel { CurrentPage = 1, TotalPages = 1, TotalItems = Model.Count };
}
<h1 class="h3 mb-3">Hóa đơn & thanh toán</h1>
<div class="mb-3 d-flex gap-2">
    <a asp-action="Index" asp-route-daThanhToan="false" class="btn @(daThanhToan ? "btn-outline-primary" : "btn-primary")">Chờ thanh toán</a>
    <a asp-action="Index" asp-route-daThanhToan="true" class="btn @(daThanhToan ? "btn-primary" : "btn-outline-primary")">Đã thanh toán</a>
</div>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Mã hóa đơn</th><th>Thời điểm lập</th><th>Trạng thái</th><th class="text-end">Tổng sau giảm/cọc</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaHoaDon</td>
                <td>@item.ThoiDiemLap.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(item.TrangThai == TrangThaiHoaDon.DaThanhToan ? "Đã thanh toán" : item.TrangThai == TrangThaiHoaDon.ThanhToanMotPhan ? "Thanh toán một phần" : "Chưa thanh toán")</td>
                <td class="text-end">@item.TongThanhToan.ToString("N0") đ</td>
                <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Xem / in</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (Model.Count == 0)
{
    <p>Chưa có hóa đơn trong nhóm này.</p>
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
    <span class="text-muted small">@pagination.TotalItems hóa đơn · Trang @pagination.CurrentPage / @pagination.TotalPages</span>
    @if (pagination.TotalPages > 1)
    {
        <nav aria-label="Phân trang hóa đơn">
            <ul class="pagination mb-0">
                @if (pagination.CurrentPage > 1)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-route-daThanhToan="@daThanhToan" asp-route-page="@(pagination.CurrentPage - 1)">Trước</a></li>
                }
                @for (var pageNumber = Math.Max(1, pagination.CurrentPage - 2); pageNumber <= Math.Min(pagination.TotalPages, pagination.CurrentPage + 2); pageNumber++)
                {
                    <li class="page-item @(pageNumber == pagination.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-daThanhToan="@daThanhToan" asp-route-page="@pageNumber" aria-current="@(pageNumber == pagination.CurrentPage ? "page" : null)">@pageNumber</a>
                    </li>
                }
                @if (pagination.CurrentPage < pagination.TotalPages)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-route-daThanhToan="@daThanhToan" asp-route-page="@(pagination.CurrentPage + 1)">Sau</a></li>
                }
            </ul>
        </nav>
    }
</div>
