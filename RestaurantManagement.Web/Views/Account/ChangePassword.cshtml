@model ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<div class="account-shell">
    <a asp-action="Index" class="small d-inline-block mb-3">← Tài khoản của tôi</a>
    <h1 class="h3 mb-3">Đổi mật khẩu</h1>
    <p class="text-muted mb-4">Nhập mật khẩu hiện tại để xác nhận thay đổi.</p>
    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" /></div>
        <div class="mb-3"><label asp-for="NewPassword" class="form-label">Mật khẩu mới</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /></div>
        <button type="submit" class="btn btn-primary">Lưu mật khẩu</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
