@model RestaurantManagement.Web.Models.VoucherFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Chỉnh sửa Voucher" : "Phát hành Voucher mới";
    ViewData["ActiveMenu"] = "Voucher";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Quản lý Voucher</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(isEdit ? "Chỉnh sửa" : "Tạo mới")</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold mb-0">@(isEdit ? $"Chỉnh sửa Voucher: {Model.Ma}" : "Phát hành Mã Voucher Mới")</h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h2 class="h6 mb-0 fw-bold text-primary"><i class="bi bi-ticket-perforated me-1"></i> Thông tin cấu hình Voucher</h2>
            </div>
            <div class="card-body p-4">
                <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                    <div class="mb-3">
                        <label asp-for="Ma" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <span class="input-group-text bg-light font-monospace"><i class="bi bi-upc-scan"></i></span>
                            <input asp-for="Ma" class="form-control font-monospace fw-bold text-uppercase fs-5" id="inputVoucherCode" placeholder="Ví dụ: SEN-SUMMER26, VIP50K..." />
                            @if (!isEdit)
                            {
                                <button type="button" class="btn btn-outline-primary" onclick="generateCode()" title="Tự động tạo mã ngẫu nhiên">
                                    <i class="bi bi-dice-5 me-1"></i> Sinh mã tự động
                                </button>
                            }
                        </div>
                        <span asp-validation-for="Ma" class="text-danger small"></span>
                        <div class="form-text small">Chỉ sử dụng chữ hoa, số và dấu gạch nối (ví dụ: SEN-VIP2026).</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="KhuyenMaiId" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <select asp-for="KhuyenMaiId" class="form-select">
                            <option value="">-- Chọn chương trình khuyến mãi --</option>
                            @foreach (var opt in Model.PromotionOptions)
                            {
                                <option value="@opt.Id" selected="@(Model.KhuyenMaiId == opt.Id)">@opt.TenChuongTrinh</option>
                            }
                        </select>
                        <span asp-validation-for="KhuyenMaiId" class="text-danger small"></span>
                        <div class="form-text small">
                            Chỉ các chương trình có bật tùy chọn <em>"Yêu cầu mã Voucher"</em> mới xuất hiện trong danh sách này.
                            <a asp-controller="KhuyenMai" asp-action="Create" class="text-decoration-none ms-1">+ Tạo chương trình mới</a>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="GioiHanTongLuot" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <div class="input-group">
                                <input asp-for="GioiHanTongLuot" type="number" min="1" max="1000000" class="form-control" />
                                <span class="input-group-text">lượt</span>
                            </div>
                            <span asp-validation-for="GioiHanTongLuot" class="text-danger small"></span>
                            <div class="form-text small">Số lần tối đa mã này có thể được áp dụng trên toàn hệ thống.</div>
                        </div>

                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">Đối tượng áp dụng</label>
                            <input type="text" class="form-control bg-light" value="Tất cả khách hàng (Dùng chung)" readonly />
                            <div class="form-text small">Voucher khả dụng cho mọi khách hàng đủ điều kiện đơn hàng.</div>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="DangSuDung" class="form-check-input" type="checkbox" id="checkDangSuDung" />
                        <label asp-for="DangSuDung" class="form-check-label fw-semibold"></label>
                        <div class="text-muted small">Bật để cho phép thu ngân và khách hàng áp dụng voucher này vào hóa đơn.</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-5 fw-bold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> @(isEdit ? "Lưu thay đổi" : "Phát hành Voucher")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function generateCode() {
        try {
            const res = await fetch('@Url.Action("GenerateCode", "Voucher")');
            if (res.ok) {
                const data = await res.json();
                document.getElementById('inputVoucherCode').value = data.code;
            }
        } catch (e) {
            console.error(e);
        }
    }
</script>
}
